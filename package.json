{
  "name": "mykrutidev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "pdfs": "node scripts/pdfs.mjs",
    "og": "node scripts/og-images.mjs",
    "prebuild": "npm run pdfs && npm run og",
    "build": "astro build",
    "postbuild": "npm run test:seo",
    "test:seo": "node --test tests/seo.test.js",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler pages dev dist --d1 DB --persist-to .wrangler/state",
    "test": "node --test \"src/lib/*.test.js\" \"src/i18n/*.test.js\" \"server/*.test.js\"",
    "test:dist": "node --test \"tests/*.test.js\"",
    "test:e2e": "astro build && playwright test",
    "screenshots": "astro build && playwright test --config=playwright.screenshots.config.js",
    "lighthouse": "astro build && node e2e/lighthouse.mjs",
    "perf:theme": "astro build && node e2e/perf-theme.mjs keyboard /hindi-keyboard light dark && node e2e/perf-theme.mjs tutor /hindi-typing-test light dark",
    "i18n:review": "node scripts/translations-review.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@xmldom/xmldom": "^0.9.12",
    "jsqr": "^1.4.0",
    "lighthouse": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "wrangler": "^4.140.0"
  }
}
