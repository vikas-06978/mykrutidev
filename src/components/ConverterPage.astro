---
import Base from '../layouts/Base.astro';
import Converter from './Converter.astro';
import Faq from './Faq.astro';
import { getPage, isLive, reversePage } from '../lib/routes.js';
import { FONTS, boxLabel } from '../lib/fontMaps.js';

interface Props {
  /** Route path — everything else is looked up in routes.js. */
  path: string;
  /** One-line lede under the h1: what to do on this page. */
  lede: string;
  faq?: { q: string; a: string }[];
}

const { path, lede, faq = [] } = Astro.props;

const page = getPage(path);
if (!page) throw new Error(`No routes.js entry for ${path}`);

const live = isLive(page);
const related = page.related.map(getPage).filter(Boolean);

// Only offer the swap link when the reverse page is actually usable.
const rev = reversePage(page);
const reverse = rev && isLive(rev) ? { path: rev.path, h1: rev.h1 } : null;

// "Coming soon" copy differs by what is missing: a mapping, or just the prose.
const pendingConverter = !live && page.kind === 'converter';
const fromName = page.from ? boxLabel(page.from) : null;
const toName = page.to ? boxLabel(page.to) : null;

// Which half is holding it up — worth saying plainly rather than a blanket
// "coming soon", because often one side is done and tested already.
const blockers = [page.from, page.to]
  .filter((k) => k && !FONTS[k]?.accurate)
  .map((k) => FONTS[k].label);
---

<Base title={page.title} description={page.description} noindex={!live}>
  <div class="wrap py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl">{page.h1}</h1>
    <p class="mt-3 max-w-2xl text-base text-body">{lede}</p>

    {
      live && page.from && page.to && (
        <div class="mt-6">
          <Converter from={page.from} to={page.to} reverse={reverse} />
        </div>
      )
    }

    {
      pendingConverter && (
        <section
          aria-labelledby="soon"
          class="mt-6 card border-saffron/40 bg-warn-bg p-6 sm:p-8"
        >
          <p class="text-xs font-semibold tracking-wide text-saffron uppercase">
            Coming soon
          </p>
          <h2 id="soon" class="mt-2 text-xl">
            {fromName && toName
              ? `The ${fromName} to ${toName} mapping is being finalised`
              : 'This converter is being built'}
          </h2>
          <p class="mt-3 max-w-2xl text-body">{page.note}</p>
          <p class="mt-3 max-w-2xl text-body">
            There is deliberately no converter on this page yet.{' '}
            <strong class="font-medium text-ink">
              A converter that returns wrong Hindi is worse than one that is
              honest about not being ready
            </strong>
            , because you would have no way of knowing which letters it got wrong.
            {blockers.length > 0 && (
              <>
                {' '}
                Still to verify: {blockers.join(' and ')}.
              </>
            )}
          </p>
          <p class="mt-5">
            <a href="/" class="font-medium">
              Use the Kruti Dev to Unicode converter
            </a>{' '}
            in the meantime, or see{' '}
            <a href="/all-converters">all converters and their status</a>.
          </p>
        </section>
      )
    }

    <div class="prose-page mt-12 text-body">
      <slot />
    </div>

    {faq.length > 0 && <Faq items={faq} schema={live} />}

    {
      related.length > 0 && (
        <nav aria-labelledby="related" class="mt-12">
          <h2 id="related" class="text-xl">
            Related converters
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li>
                <a
                  href={r.path}
                  class="block h-full card p-4 no-underline transition-colors hover:border-saffron"
                >
                  <span class="block font-medium text-ink">
                    {r.h1}
                    {!isLive(r) && (
                      <span class="ml-2 align-middle text-xs font-normal text-mute">
                        coming soon
                      </span>
                    )}
                  </span>
                  <span class="mt-1 block text-sm text-body">{r.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>
