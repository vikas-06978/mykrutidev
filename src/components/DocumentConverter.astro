---
/**
 * "Convert a document": upload a .docx or .txt, convert it, download it.
 *
 * Everything happens in the browser. The file is read with the File API,
 * converted by src/lib/docConvert.js - which uses the same convert() as the
 * text boxes above - and handed back as a download. There is no upload
 * endpoint anywhere on this site.
 */
import { langOf, useT, raw } from '../i18n/index.js';
import { FONTS } from '../lib/fontMaps.js';
import { WORD_FONTS, isUnicodeKey, docLabel } from '../lib/wordFonts.js';
import { SCRIPTS, scriptOfFont, scriptOfPage } from '../lib/scripts.js';

interface Props {
  /** The page's fonts: the document is read as FROM, converted to TO by default. */
  from: string;
  to: string;
  /** Inside ConvertModes' "Upload Word file" tab: no top margin of its own. */
  embedded?: boolean;
}

const { from, to, embedded = false } = Astro.props;
const lang = langOf(Astro.url);
const { t, render } = useT(lang);
// Every doc.* string, for the script: errors and the result summary are
// worded in the browser, after the file has been read.
const strings = raw(lang, 'doc');
const fromUnicode = isUnicodeKey(from);
const id = `doc-${from}-${to}`;

// "Convert to": every font the FROM text can be converted into - Unicode in
// each offered font, and every verified legacy font other than the source.
// The page's own target is picked to begin with.
// Grouped by language, so the list stays readable with two dozen fonts.
// Only fonts of the same script: Gujarati text has no Kruti Dev keys.
const pageScript = scriptOfPage(from, to);
const sameScript = (k: string) => scriptOfFont(k) === pageScript;
const unicodeFonts = SCRIPTS[pageScript].unicodeFonts;
const beta = (k: string) => (FONTS[k]?.beta ? ` (${t('page.beta')})` : '');
const legacy = Object.entries(WORD_FONTS)
  .filter(([k]) => k !== from && FONTS[k]?.accurate && sameScript(k))
  .map(([k, w]) => ({ value: `${k}|${w.name}`, label: `${w.name}${beta(k)}`, lang: FONTS[k].lang ?? 'hi' }));
const LANG_GROUP: Record<string, string> = {
  hi: 'doc.groupHindi',
  ne: 'doc.groupNepali',
  mr: 'doc.groupMarathi',
  gu: 'doc.groupGujarati',
  ta: 'doc.groupTamil',
  bn: 'doc.groupBengali',
};
const targetGroups = [
  ...(fromUnicode
    ? []
    : [{ label: t('doc.groupUnicode'), options: unicodeFonts.map((f) => ({ value: `unicode|${f}`, label: t('doc.unicodeIn', { font: f }) })) }]),
  ...Object.entries(LANG_GROUP)
    .map(([lang, key]) => ({ label: t(key), options: legacy.filter((o) => o.lang === lang) }))
    .filter((g) => g.options.length > 0),
];
const selected = isUnicodeKey(to) ? `unicode|${to === 'mangal' ? 'Mangal' : unicodeFonts[0]}` : `${to}|${WORD_FONTS[to].name}`;
const intro = fromUnicode ? t('doc.introUnicode') : t('doc.introLegacy', { from: docLabel(from, strings) });
---

<section
  id="convert-document"
  class:list={['doc card scroll-mt-4', !embedded && 'mt-8']}
  data-doc-converter
  data-from={from}
  data-i18n={JSON.stringify(strings)}
  aria-labelledby={`${id}-title`}
>
  <div class="px-4 pt-5 pb-4 sm:px-6">
    <h2 id={`${id}-title`} class="text-xl">{t('doc.title')}</h2>
    <p
      class="mt-1 text-sm text-body"
      set:html={render(intro)}
    />
    <p class="mt-2 text-sm font-medium text-ink">
      <span aria-hidden="true">🔒</span> {t('doc.private')}
    </p>

    {/* Picked first, so the download is in the right font from the start. */}
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <label for={`${id}-target`} class="text-body">
        {t('doc.targetLabel')}
      </label>
      <select
        id={`${id}-target`}
        data-role="target"
        class="max-w-full rounded-(--radius-chrome) border border-hairline bg-surface px-2 py-1.5 text-ink"
        translate="no"
      >
        {targetGroups.map((g) => (
          <optgroup label={g.label}>
            {g.options.map((o) => <option value={o.value} selected={o.value === selected}>{o.label}</option>)}
          </optgroup>
        ))}
      </select>
    </div>

    {/*
      The whole area is the label for the file input, so a tap anywhere on it
      opens the picker - which is the only way on a phone, where there is
      nothing to drag.
    */}
    <label
      for={`${id}-input`}
      data-role="drop"
      class="doc-drop mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-(--radius-card) border-2 border-dashed border-hairline bg-inset px-4 py-8 text-center transition-colors"
    >
      <span class="text-sm text-body">
        <span class="hidden sm:inline">{t('doc.drag')}</span>
      </span>
      <span class="btn btn-primary pointer-events-none">{t('doc.choose')}</span>
      <span class="text-xs text-mute" set:html={render(t('doc.limits'))} />
      <input
        id={`${id}-input`}
        data-role="input"
        type="file"
        accept=".docx,.txt,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
        class="sr-only"
      />
    </label>

    <div data-role="status" class="mt-4" hidden>
      <p class="text-sm text-ink">
        <span data-role="file-name" class="font-medium break-all" translate="no"></span>
        <span data-role="file-size" class="text-mute"></span>
      </p>
      <div
        data-role="progress-wrap"
        class="mt-2 h-2 overflow-hidden rounded-full bg-inset"
        role="progressbar"
        aria-label={t('doc.progress')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div data-role="progress" class="h-full w-0 bg-brick transition-[width]"></div>
      </div>
    </div>

    <p data-role="error" role="alert" hidden class="mt-4 rounded-(--radius-chrome) border border-err/30 bg-err-bg px-3 py-2 text-sm text-err"></p>

    <div data-role="result" hidden class="mt-4">
      <p data-role="summary" class="text-sm font-medium text-ink"></p>
      <p data-role="share" class="mt-1 text-sm text-body"></p>
      <p data-role="warning" role="status" hidden class="mt-2 rounded-(--radius-chrome) border border-saffron/40 bg-warn-bg px-3 py-2 text-sm text-ink"></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a data-role="download" class="btn btn-primary" href="#" download>{t('doc.download')}</a>
        <a data-role="download-docx" class="btn btn-outline" href="#" download hidden></a>
      </div>
    </div>
  </div>
</section>

<script>
  import { localizeDocMessage, localizeSummary } from '../i18n/docMessages.js';
  import { fill } from '../i18n/fill.js';

  type Mod = typeof import('../lib/docConvert.js');
  let mod: Promise<Mod> | null = null;
  // A failed load is not cached, so the next upload tries again.
  const load = () =>
    (mod ??= import('../lib/docConvert.js').catch((err) => {
      mod = null;
      throw err;
    }));

  for (const root of document.querySelectorAll<HTMLElement>('[data-doc-converter]')) {
    setup(root);
  }

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;
    const from = root.dataset.from!;
    const L: Record<string, string> = JSON.parse(root.dataset.i18n || '{}');

    const drop = q<HTMLLabelElement>('drop');
    const input = q<HTMLInputElement>('input');
    const targetSelect = q<HTMLSelectElement>('target');
    /** The chosen target: its font key, and the font name set in the file. */
    const target = () => {
      const [to, font] = targetSelect.value.split('|');
      return { pair: { from, to }, font };
    };
    const status = q('status');
    const fileName = q('file-name');
    const fileSize = q('file-size');
    const progressWrap = q('progress-wrap');
    const progress = q('progress');
    const error = q('error');
    const result = q('result');
    const summary = q('summary');
    const share = q('share');
    const warning = q('warning');
    const download = q<HTMLAnchorElement>('download');
    const downloadDocx = q<HTMLAnchorElement>('download-docx');

    let current: File | null = null;
    let urls: string[] = [];
    let busy = 0;

    const sizeLabel = (n: number) =>
      n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`;

    function setProgress(f: number) {
      const pct = Math.round(f * 100);
      progress.style.width = `${pct}%`;
      progressWrap.setAttribute('aria-valuenow', String(pct));
    }

    function reset() {
      for (const u of urls) URL.revokeObjectURL(u);
      urls = [];
      error.hidden = true;
      result.hidden = true;
      warning.hidden = true;
      downloadDocx.hidden = true;
    }

    function fail(message: string) {
      error.textContent = message;
      error.hidden = false;
      progressWrap.hidden = true;
    }

    function offer(a: HTMLAnchorElement, blob: Blob, name: string) {
      const url = URL.createObjectURL(blob);
      urls.push(url);
      a.href = url;
      a.download = name;
    }

    async function handle(file: File) {
      current = file;
      const run = ++busy;
      reset();
      status.hidden = false;
      progressWrap.hidden = false;
      fileName.textContent = file.name;
      fileSize.textContent = ` · ${sizeLabel(file.size)}`;
      setProgress(0);

      let m: Mod | null = null;
      try {
        m = await load();
        const head = new Uint8Array(await file.slice(0, 8).arrayBuffer());
        const checked = m.checkFile({ name: file.name, size: file.size, head });
        if ('error' in checked) return fail(localizeDocMessage(checked.error, m, L));

        const bytes = new Uint8Array(await file.arrayBuffer());
        if (run !== busy) return;
        let stats;
        const { pair, font } = target();
        const toUnicode = pair.to === 'unicode';

        if (checked.kind === 'docx') {
          const out = await m.convertDocx(bytes, {
            direction: pair,
            unicodeFont: toUnicode ? font : undefined,
            onProgress: (f) => run === busy && setProgress(f),
          });
          if (run !== busy) return;
          stats = out.stats;
          offer(download, m.docxBlob(out.bytes), m.outputName(file.name, pair, 'docx'));
        } else {
          const { text } = m.decodeTextFile(bytes);
          setProgress(0.4);
          const out = m.convertTxt(text, pair);
          stats = out.stats;
          offer(
            download,
            new Blob([out.text], { type: 'text/plain;charset=utf-8' }),
            m.outputName(file.name, pair, 'txt'),
          );
          // A .txt cannot carry a font, and legacy-font text without its font
          // is unreadable - so a Word file with the font already set is offered
          // too, built from the converted text.
          if (!toUnicode && stats.convertedChars > 0) {
            const { buildDocxBytes } = await import('../lib/docx.js');
            const unicode = from === 'unicode' || from === 'mangal' ? text : m.convertTxt(text, { from, to: 'unicode' }).text;
            const unicodeDocx = buildDocxBytes(unicode, { fontName: 'Mangal' });
            const legacy = await m.convertDocx(unicodeDocx, { direction: { from: 'unicode', to: pair.to } });
            offer(downloadDocx, m.docxBlob(legacy.bytes), m.outputName(file.name, pair, 'docx'));
            downloadDocx.textContent = fill(L.downloadLegacyDocx, { font });
            downloadDocx.hidden = false;
          }
        }
        if (run !== busy) return;
        setProgress(1);

        // Same stats, same arithmetic as m.summarize(), in this page's words.
        const s = localizeSummary(stats, pair, L);
        summary.textContent = s.line;
        share.textContent = s.share ?? '';
        share.hidden = !s.share;
        warning.textContent = s.warning ?? '';
        warning.hidden = !s.warning;
        // Nothing converted means the download would be the same file back.
        download.hidden = !!s.warning;
        result.hidden = false;
      } catch (err) {
        // Always log the real error (and its cause) - the message shown is for people.
        console.error('[doc-converter]', err, (err as Error)?.cause ?? '');
        if (run !== busy) return;
        // If the converter itself failed to load there is no messageFor().
        fail(m ? localizeDocMessage(m.messageFor(err), m, L) : L.generic);
      }
    }

    input.addEventListener('change', () => {
      const f = input.files?.[0];
      if (f) void handle(f);
      // Allow picking the same file again after a change of settings.
      input.value = '';
    });

    // A different output font means a different file: convert again.
    targetSelect.addEventListener('change', () => {
      if (current) void handle(current);
    });

    // Drag and drop. preventDefault on dragover is what makes this a drop
    // target at all; without it the browser opens the file in the tab.
    for (const ev of ['dragenter', 'dragover'] as const) {
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.dataset.drag = 'true';
      });
    }
    for (const ev of ['dragleave', 'drop'] as const) {
      drop.addEventListener(ev, () => delete drop.dataset.drag);
    }
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      const f = e.dataTransfer?.files?.[0];
      if (f) void handle(f);
    });

    // A file dropped anywhere on the page (ConvertModes' page-wide drop)
    // arrives here, and goes through exactly the same checks and conversion.
    root.addEventListener('mkd:doc-file', (e) => {
      const f = (e as CustomEvent<File>).detail;
      if (f) void handle(f);
    });
  }
</script>

<style>
  .doc-drop[data-drag='true'] {
    border-color: var(--color-brick);
    background-color: var(--color-warn-bg);
  }
  .doc-drop:focus-within {
    outline: 2px solid var(--color-brick);
    outline-offset: 2px;
  }
</style>
