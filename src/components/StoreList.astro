---
/**
 * The store page's list: every product on sale. With none on sale yet, a
 * plain "opens soon" note. Prices come from src/lib/store.js - the same file
 * the server prices the order from.
 */
import { shownProducts, price } from '../lib/store.js';
import { langOf, useT, fill } from '../i18n/index.js';

const { t, render, path: to } = useT(langOf(Astro.url));
const products = shownProducts();
---

{
  products.length === 0 ? (
    <section class="mt-8 card p-5 sm:p-6" aria-labelledby="store-empty">
      <h2 id="store-empty" class="text-xl">{t('store.emptyTitle')}</h2>
      <p class="mt-2 max-w-2xl text-body">{t('store.empty')}</p>
    </section>
  ) : (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2" data-store-list>
      {products.map((p) => (
        <li class="card flex h-full flex-col p-5">
          {p.images && (
            <a href={to(`/store/${p.id}`)} tabindex="-1" aria-hidden="true" class="mb-4 block overflow-hidden rounded-md border border-hairline">
              <img src={`/store-img/${p.images.cover}`} alt={t('store.previewCover')} width="640" height="906" loading="lazy" decoding="async" class="block h-56 w-full object-cover object-top" />
            </a>
          )}
          <h2 class="text-lg">
            <a href={to(`/store/${p.id}`)} class="text-ink no-underline hover:underline" set:html={render(t(`pages./store/${p.id}.h1`))} />
          </h2>
          <p class="mt-2 flex-1 text-sm text-body" set:html={render(t(`pages./store/${p.id}.description`))} />
          <p class="mt-3 text-xs text-mute">{fill(t('store.meta'), { pages: String(p.pages) })}</p>
          <div class="mt-3 flex items-center justify-between gap-3">
            <span class="text-lg font-semibold text-ink">{price(p.pricePaise)}</span>
            <a href={to(`/store/${p.id}`)} class="btn btn-outline">{t('store.view')}</a>
          </div>
        </li>
      ))}
    </ul>
  )
}
