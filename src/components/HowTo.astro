---
/**
 * "How to use": three numbered steps and one tip, directly under a tool.
 *
 * Plain HTML from src/i18n (pages.<path>.howTo), so search engines read it in
 * both languages and it costs no script. Each page has its own steps - the
 * wording follows that page's direction and its real button labels.
 */
import { langOf, useT } from '../i18n/index.js';

interface Props {
  steps: string[];
  tip: string;
}
const { steps, tip } = Astro.props;
const { t, render } = useT(langOf(Astro.url));
---

<section aria-labelledby="howto-heading" class="mt-8">
  <h2 id="howto-heading" class="text-xl">{t('guide.howToHeading')}</h2>
  <ol class="howto mt-4 grid gap-3 sm:grid-cols-3">
    {
      steps.map((s, i) => (
        <li class="flex gap-3 card p-4 text-sm leading-relaxed text-body">
          <span aria-hidden="true" class="howto-n">
            {i + 1}
          </span>
          <span set:html={render(s)} />
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-sm leading-relaxed text-body">
    <strong class="font-semibold text-ink">{t('guide.tipLabel')}:</strong>
    <Fragment set:html={render(tip)} />
  </p>
</section>

<style>
  /* The list is numbered by these badges, so the ol draws no markers. */
  .howto {
    list-style: none;
    padding: 0;
  }
  .howto-n {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--color-brick);
    color: var(--color-on-brick);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
  }
</style>
