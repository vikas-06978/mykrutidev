---
import { FONTS } from '../lib/fontMaps.js';
import { MODES, tipsFor } from '../lib/translit.js';
import { langOf, useT } from '../i18n/index.js';
import RecentStrip from './RecentStrip.astro';

const { t, render } = useT(langOf(Astro.url));

/**
 * Roman -> Hindi typing.
 *
 * Deliberately NOT Converter.astro with a different engine bolted on. The font
 * converter maps one exact representation onto another; this guesses at what
 * Hindi someone meant. They share a shell (src/styles/converter.css) and
 * nothing else - no shared script, no shared state, no shared route.
 *
 * The output is Unicode Hindi and only that. Anyone who needs Kruti Dev is
 * linked to the Unicode -> Kruti Dev converter, which owns that job.
 */

// The output box's font. The SAME Unicode stack the converter pages use for a
// Unicode output, and nothing else: this page used to set the Kruti Dev preview
// face here, which drew a typed `?` as the Kruti glyph घ्. romanTyping.test.js
// reads this file to keep a legacy font from ever coming back.
const OUTPUT_FONT = FONTS.unicode.css;

const EXAMPLE = 'namaste bharat, aap kaise hain?';

// Both tip sets are produced by RUNNING the engine at build time - see tipsFor()
// in translit.js. Nothing here writes a Devanagari letter by hand, because the
// bug this replaced was a hand-written table that promised `ri` = ऋ while the
// engine produced री. A tip can now only ever say what the engine does.
const TIPS = {
  hinglish: tipsFor('hinglish'),
  itrans: tipsFor('itrans'),
};

// Status lines the script shows. Text only.
const strings = {
  conversionFailed: t('common.conversionFailed'),
  changedTo: t('translit.changedTo'),
  nothingToCopy: t('common.nothingToCopy'),
  copied: t('common.copied'),
  copiedToClipboard: t('common.copiedToClipboard'),
  nothingToDownload: t('common.nothingToDownload'),
  downloaded: t('common.downloaded'),
  downloadFailed: t('common.downloadFailed'),
  copiedToast: t('workspace.copiedToast'),
};
---

<div
  class="cv card"
  data-translit
  data-mode="hinglish"
  data-i18n={JSON.stringify(strings)}
  style={`--cv-preview:${OUTPUT_FONT}`}
>
  <div class="grid md:grid-cols-2 md:divide-x md:divide-hairline">
    {/* ---------------------------- Input ---------------------------- */}
    <div class="cv-panel border-b border-hairline md:border-b-0">
      <div class="cv-head">
        <label for="tl-in" class="cv-eyebrow">{t('translit.inputLabel')}</label>
        <span data-role="count-in" class="cv-count">0</span>
      </div>

      <div class="cv-field">
        <textarea
          id="tl-in"
          data-role="input"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          translate="no"
          placeholder={t('translit.inputPlaceholder')}
          class="cv-area text-base"></textarea>
      </div>

      <div class="cv-actions">
        <div class="cv-secondary">
          <button type="button" data-role="clear" class="btn btn-ghost">{t('common.clear')}</button>
          <button
            type="button"
            data-role="sample"
            class="btn btn-ghost"
            data-sample={EXAMPLE}
            title={t('translit.sampleTitle')}
          >
            {t('common.tryExample')}
          </button>
        </div>
      </div>
    </div>

    {/* ---------------------------- Output ---------------------------- */}
    <div class="cv-panel bg-surface">
      <div class="cv-head">
        <label for="tl-out" class="cv-eyebrow">{t('translit.outputLabel')}</label>
        {/*
          How detected English words are written. Changes what the output IS,
          so it sits by the output. Only meaningful in Hinglish mode.
        */}
        <div data-role="english" role="group" aria-labelledby="tl-eng" class="cv-seg">
          <span id="tl-eng" class="cv-seg-label">{t('translit.englishWords')}</span>
          <button type="button" data-english="hindi" aria-pressed="true">{t('translit.hindiLetters')}</button>
          <button type="button" data-english="keep" aria-pressed="false">{t('translit.keepEnglish')}</button>
        </div>
        <span data-role="count-out" class="cv-count">0</span>
      </div>

      <div class="cv-field">
        {/*
          Editable, unlike the font converter's output: this is a phonetic
          guess, so the last word belongs to the person who knows what they
          meant. Typing in the left box still overwrites it. Tapping a word
          offers Google's other candidates for it (below).
        */}
        <textarea
          id="tl-out"
          data-role="output"
          spellcheck="false"
          lang="hi"
          translate="no"
          placeholder={t('translit.outPlaceholder')}
          class="cv-area cv-out deva text-lg"></textarea>
      </div>

      {/*
        The tapped word's candidates. Picking one replaces that word only, and
        the choice survives further typing on the left.
      */}
      <div data-role="suggest" hidden class="cv-strip flex flex-wrap items-center gap-2 text-sm">
        <span class="text-mute">
          {t('translit.suggestBefore')}<code data-role="suggest-roman" translate="no"></code>{t('translit.suggestAfter')}
        </span>
        <span data-role="suggest-list" class="flex flex-wrap gap-2" lang="hi" translate="no"></span>
      </div>

      <div class="cv-actions">
        <div class="cv-secondary">
          <button type="button" data-role="copy" class="btn btn-primary">
            {/* romanTyping.test.js pins this button: in English it reads "Copy Hindi" (translit.copy). */}
            <span data-label>{t('translit.copy')}</span>
          </button>
          <button type="button" data-role="docx" class="btn btn-ghost"><span set:html={render(t('common.downloadDocx'))} /></button>
        </div>
        <span data-role="status" role="status" aria-live="polite" class="sr-only"></span>
      </div>

      <p class="px-4 pb-4 text-sm text-body">
        {/*
          Three parts so each language can put the link where its word order
          wants it. The spaces are explicit: Astro drops the whitespace between
          a set:html fragment and the tag after it. Base.astro points the href
          at /hi/... on a Hindi page.
        */}
        <Fragment set:html={render(t('translit.needKruti'))} />{' '}<a
          href="/unicode-to-kruti-dev"
          set:html={render(t('translit.needKrutiLink'))}
        /><Fragment set:html={render(t('translit.needKrutiAfter'))} />
      </p>
    </div>
  </div>

  {/* --------------------------- Fallback note --------------------------- */}
  {/*
    Only visible when Google could not be reached for at least one word, and
    the built-in engine spelled it. Not an error: the page is still working.
  */}
  <p data-role="offline-note" hidden class="cv-strip bg-inset text-xs leading-relaxed text-mute">
    <span class="font-medium text-body">{t('translit.offlineStrong')}</span>
    {t('translit.offlineBody')}
  </p>

  {/* Only if the converter itself could not load. */}
  <p data-role="engine-error" role="alert" hidden class="cv-strip bg-warn-bg text-xs leading-relaxed text-body">
    {t('translit.engineFailed')}
  </p>

  <RecentStrip />

  {/* ------------------------- Spelling tips ------------------------- */}
  <div class="cv-strip bg-inset">
    {
      Object.entries(TIPS).map(([modeKey, tips]) => (
        <p
          data-role="tips"
          data-tips-mode={modeKey}
          hidden={modeKey !== 'hinglish'}
          class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-body"
        >
          <span class="font-medium text-ink">{t('translit.tips')}</span>
          {tips.map((tip) => (
            <span class="whitespace-nowrap">
              <code class="text-xs" translate="no">{tip.roman}</code>
              <span aria-hidden="true" class="mx-1 text-mute">
                =
              </span>
              <span lang="hi" class="text-ink">
                {tip.deva}
              </span>
            </span>
          ))}
          <span class="whitespace-nowrap">
            <code class="text-xs" translate="no">|</code>
            <span aria-hidden="true" class="mx-1 text-mute">=</span>
            <span lang="hi" class="text-ink">।</span>
          </span>
          <span class="whitespace-nowrap">
            <code class="text-xs" translate="no">`Google`</code>
            <span aria-hidden="true" class="mx-1 text-mute">=</span>
            <span class="text-ink">Google</span>
          </span>
        </p>
      ))
    }
  </div>

  {/* --------------------------- Typing mode --------------------------- */}
  <div class="cv-strip bg-surface">
    <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
      <div data-role="mode" role="group" aria-labelledby="tl-mode" class="cv-seg">
        <span id="tl-mode" class="cv-seg-label">{t('translit.mode')}</span>
        {
          Object.values(MODES).map((m, idx) => (
            <button
              type="button"
              data-mode={m.key}
              data-hint={t(`translit.modes.${m.key}.hint`)}
              aria-pressed={String(idx === 0)}
            >
              {t(`translit.modes.${m.key}.label`)}
            </button>
          ))
        }
      </div>
      <p data-role="mode-hint" class="flex-1 text-xs leading-relaxed text-mute">
        {t('translit.modes.hinglish.hint')}
      </p>
    </div>
  </div>

  {/* --------------------------- Honesty strip --------------------------- */}
  <p
    class="cv-strip bg-surface text-sm leading-relaxed text-body"
    set:html={render(t('translit.honesty'))}
  />

  <p
    class="cv-strip bg-surface text-xs leading-relaxed text-mute"
    set:html={render(t('translit.privacy'))}
  />
</div>

<script>
  import type { Typed } from '../lib/romanTyping.js';
  import { fill } from '../i18n/fill.js';
  import { workspace } from '../scripts/workspace.js';
  import { toast } from '../scripts/toast.js';
  import { track } from '../scripts/track.js';

  /** The local engine is cheap, so it runs between keystrokes. */
  const DEBOUNCE_MS = 80;
  /** Google waits for a pause between words, since it costs a request. */
  const GOOGLE_DEBOUNCE_MS = 220;

  // --------------------------------------------------------------------------
  // The engines load on demand, not with the page: Sanscript alone is ~33 KB
  // gzipped and cannot be needed before someone types.
  // --------------------------------------------------------------------------
  type Engine = {
    romanToUnicode: typeof import('../lib/translit.js')['romanToUnicode'];
    googleSuggestions: typeof import('../lib/googleTranslit.js')['googleSuggestions'];
    isAvailable: typeof import('../lib/googleTranslit.js')['isAvailable'];
    typing: typeof import('../lib/romanTyping.js');
  };
  type English = ReturnType<typeof import('../lib/englishWords.js')['makeEnglish']>;

  /** Where the "English words" choice is remembered. */
  const ENGLISH_PREF_KEY = 'mkd-typing-english-words';

  // --------------------------------------------------------------------------
  // The English word list (~190 KB gzipped) is fetched after the page is idle,
  // never with it. Until it arrives every word is treated as Hinglish, exactly
  // as before; when it lands the text is re-rendered once.
  // --------------------------------------------------------------------------
  let english: English | null = null;
  let englishLoading: Promise<English | null> | null = null;

  function loadEnglish(): Promise<English | null> {
    englishLoading ??= Promise.all([
      fetch('/data/english-words.json').then((r) => {
        if (!r.ok) throw new Error(`english-words.json: HTTP ${r.status}`);
        return r.json();
      }),
      import('../lib/englishWords.js'),
    ])
      .then(([data, mod]) => (english = mod.makeEnglish(data.words)))
      .catch((err) => {
        // Not fatal: the page simply keeps treating every word as Hinglish.
        console.error(err);
        return null;
      });
    return englishLoading;
  }

  let engine: Engine | null = null;
  let loading: Promise<Engine> | null = null;

  /** Google is an upgrade, not a requirement: without it every word keeps its dictionary spelling. */
  const GOOGLE_OFF = {
    googleSuggestions: async (): Promise<string[]> => {
      throw new Error('Input Tools: module did not load');
    },
    isAvailable: () => false,
  };

  /**
   * The two essential modules, plus Google as an optional extra.
   *
   * No retry: a browser remembers a failed module import for the life of the
   * page and never re-requests it (checked in Chromium), so the only recovery
   * is a reload - which the engine-error note asks for.
   */
  function loadEngine(): Promise<Engine> {
    loading ??= Promise.all([
      import('../lib/translit.js'),
      import('../lib/romanTyping.js'),
      import('../lib/googleTranslit.js').catch((err) => {
        console.error(err);
        return GOOGLE_OFF;
      }),
    ]).then(([t, typing, g]) => {
      engine = {
        romanToUnicode: t.romanToUnicode,
        googleSuggestions: g.googleSuggestions,
        isAvailable: g.isAvailable,
        typing,
      };
      return engine;
    });
    return loading;
  }

  const root = document.querySelector<HTMLElement>('[data-translit]');
  if (root) {
    setup(root);
    const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
    // A failed preload is reported when someone types, not here.
    idle(() => void loadEngine().catch(() => {}));
  }

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;

    const input = q<HTMLTextAreaElement>('input');
    const output = q<HTMLTextAreaElement>('output');
    const countIn = q('count-in');
    const countOut = q('count-out');
    const status = q('status');
    const modeHint = q('mode-hint');
    const offlineNote = q('offline-note');
    const engineError = q('engine-error');
    const suggest = q('suggest');
    const suggestRoman = q('suggest-roman');
    const suggestList = q('suggest-list');
    const L: Record<string, string> = JSON.parse(root.dataset.i18n || '{}');

    let mode: 'hinglish' | 'itrans' = 'hinglish';
    let keepEnglish = false;
    const englishGroup = q('english');

    let flash: ReturnType<typeof setTimeout> | undefined;
    function say(msg: string) {
      status.textContent = msg;
      clearTimeout(flash);
      flash = setTimeout(() => (status.textContent = ''), 2200);
    }

    // ----------------------------------------------------------------------
    // Two passes over the same input:
    //   1. LOCAL  - every word from the built-in engine, instantly.
    //   2. GOOGLE - every word from Google (first candidate), replacing pass 1;
    //               any word Google fails on keeps its local spelling.
    // A dead network therefore costs the better spelling, never a blank box.
    // ----------------------------------------------------------------------

    /** What is on screen, with each word's span and candidates. */
    let current: Typed = { text: '', words: [], fellBack: false };
    /** Words the user picked from the list, keyed by position + spelling. */
    const picks = new Map<string, string>();
    let seq = 0;
    let handEdited = false;
    let inFlight: AbortController | null = null;

    const fallback = (e: Engine) => (w: string) => e.romanToUnicode(w, { mode: 'hinglish' });

    function publish(typed: Typed, run: number) {
      if (run !== seq) return;
      current = typed;
      if (output.value !== typed.text) output.value = typed.text;
      countOut.textContent = String(typed.text.length);
      hideSuggestions();
    }

    /** The engine, or null after telling the user it could not load. */
    async function getEngine(): Promise<Engine | null> {
      try {
        const e = engine ?? (await loadEngine());
        engineError.hidden = true;
        return e;
      } catch (err) {
        console.error(err);
        // A blank box with no reason is the one outcome not allowed here.
        engineError.hidden = false;
        return null;
      }
    }

    async function renderLocal(run: number) {
      const e = await getEngine();
      if (!e || run !== seq) return;
      try {
        const typed =
          mode === 'itrans'
            ? e.typing.typeItrans(input.value, (s) => e.romanToUnicode(s, { mode: 'itrans' }))
            : e.typing.typeHindiLocal(input.value, {
                fallback: fallback(e),
                picks,
                english,
                keepEnglish,
              });
        publish(typed, run);
      } catch (err) {
        console.error(err);
        say(L.conversionFailed);
      }
    }

    async function renderGoogle(run: number) {
      if (mode !== 'hinglish' || !/[A-Za-z]/.test(input.value)) {
        offlineNote.hidden = true;
        return;
      }
      const e = await getEngine();
      if (!e || run !== seq) return;
      // Breaker open after repeated failures: the local pass IS the answer.
      if (!e.isAvailable()) {
        offlineNote.hidden = false;
        return;
      }

      inFlight?.abort();
      const ctrl = new AbortController();
      inFlight = ctrl;
      try {
        const typed = await e.typing.typeHindi(input.value, {
          lookup: (w) => e.googleSuggestions(w, { signal: ctrl.signal }),
          fallback: fallback(e),
          picks,
          english,
          keepEnglish,
        });
        if (run !== seq) return;
        // A correction typed into the output while this was in flight wins.
        if (handEdited) return;
        publish(typed, run);
        offlineNote.hidden = !typed.fellBack;
      } catch (err) {
        if ((err as Error)?.name !== 'AbortError') console.error(err);
      } finally {
        if (inFlight === ctrl) inFlight = null;
      }
    }

    output.addEventListener('input', () => {
      handEdited = true;
      countOut.textContent = String(output.value.length);
      hideSuggestions();
    });

    let pendingLocal: ReturnType<typeof setTimeout> | undefined;
    let pendingGoogle: ReturnType<typeof setTimeout> | undefined;

    function tick() {
      countIn.textContent = String(input.value.length);
      handEdited = false;
      const run = ++seq;
      clearTimeout(pendingLocal);
      clearTimeout(pendingGoogle);
      pendingLocal = setTimeout(() => void renderLocal(run), DEBOUNCE_MS);
      pendingGoogle = setTimeout(() => void renderGoogle(run), GOOGLE_DEBOUNCE_MS);
    }

    /** Everything settled now - for copy and download. */
    async function flush() {
      clearTimeout(pendingLocal);
      clearTimeout(pendingGoogle);
      const run = ++seq;
      inFlight?.abort();
      await renderLocal(run);
      await renderGoogle(run);
    }

    input.addEventListener('input', tick);

    // ----------------------------------------------------------------------
    // Tap a word -> its other suggestions.
    // ----------------------------------------------------------------------
    function hideSuggestions() {
      suggest.hidden = true;
      suggestList.textContent = '';
    }

    function showSuggestionsAtCaret() {
      // Offsets are only valid for text this code wrote. After a hand edit the
      // spans no longer line up, so offer nothing rather than the wrong word.
      if (!engine || output.value !== current.text) return hideSuggestions();
      if (output.selectionStart !== output.selectionEnd) return hideSuggestions();
      const k = engine.typing.wordAt(current, output.selectionStart);
      const word = current.words[k];
      if (!word || word.suggestions.length < 2) return hideSuggestions();

      suggestRoman.textContent = word.roman;
      suggestList.textContent = '';
      const shown = output.value.slice(word.start, word.end);
      for (const s of word.suggestions) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn-outline';
        b.textContent = s;
        b.setAttribute('aria-pressed', String(s === shown));
        b.addEventListener('click', () => choose(k, s));
        suggestList.append(b);
      }
      suggest.hidden = false;
    }

    function choose(k: number, s: string) {
      if (!engine) return;
      const word = current.words[k];
      picks.set(engine.typing.pickKey(word.index, word.roman), s);
      current = engine.typing.replaceWord(current, k, s);
      output.value = current.text;
      countOut.textContent = String(current.text.length);
      const end = current.words[k].end;
      output.focus();
      output.setSelectionRange(end, end);
      hideSuggestions();
      say(fill(L.changedTo, { word: s }));
    }

    output.addEventListener('click', showSuggestionsAtCaret);
    output.addEventListener('keyup', (e) => {
      if (e.key.startsWith('Arrow') || e.key === 'Home' || e.key === 'End') showSuggestionsAtCaret();
    });

    // ----------------------------------------------------------------------
    // Typing mode.
    // ----------------------------------------------------------------------
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-role="mode"] button')) {
      b.addEventListener('click', () => {
        mode = b.dataset.mode as 'hinglish' | 'itrans';
        root.dataset.mode = mode;
        for (const other of root.querySelectorAll<HTMLButtonElement>('[data-role="mode"] button')) {
          other.setAttribute('aria-pressed', String(other === b));
        }
        modeHint.textContent = b.dataset.hint ?? '';
        // ITRANS spells every letter exactly; there is no "English word" to detect.
        englishGroup.hidden = mode !== 'hinglish';
        for (const p of root.querySelectorAll<HTMLElement>('[data-tips-mode]')) {
          p.hidden = p.dataset.tipsMode !== mode;
        }
        picks.clear();
        void flush();
      });
    }

    // ----------------------------------------------------------------------
    // English words: Hindi letters (nice -> नाइस) or Keep English (nice).
    // Remembered per browser; storage can be blocked, so every access is
    // guarded and the default simply applies when it is.
    // ----------------------------------------------------------------------
    function setEnglishMode(keep: boolean, save: boolean) {
      keepEnglish = keep;
      for (const b of englishGroup.querySelectorAll<HTMLButtonElement>('button')) {
        b.setAttribute('aria-pressed', String((b.dataset.english === 'keep') === keep));
      }
      if (save) {
        try {
          localStorage.setItem(ENGLISH_PREF_KEY, keep ? 'keep' : 'hindi');
        } catch {
          // Private mode or blocked storage: the choice just is not remembered.
        }
      }
    }
    try {
      setEnglishMode(localStorage.getItem(ENGLISH_PREF_KEY) === 'keep', false);
    } catch {
      setEnglishMode(false, false);
    }
    for (const b of englishGroup.querySelectorAll<HTMLButtonElement>('button')) {
      b.addEventListener('click', () => {
        setEnglishMode(b.dataset.english === 'keep', true);
        // Picks were made against the other spelling of these words.
        picks.clear();
        void flush();
      });
    }

    // When the word list lands, redo the text once - unless the user has
    // already started correcting the output by hand.
    const idleEnglish = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 300));
    idleEnglish(() => {
      void loadEnglish().then((en) => {
        if (en && !handEdited && input.value && mode === 'hinglish') void flush();
      });
    });

    // ----------------------------------------------------------------------
    // Copy / download: whatever is in the box, including a hand correction.
    // ----------------------------------------------------------------------
    async function writeClipboard(text: string) {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.setAttribute('readonly', '');
        scratch.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
        document.body.append(scratch);
        scratch.select();
        try {
          document.execCommand('copy');
        } finally {
          scratch.remove();
        }
      }
    }

    /** Settle pending passes, unless the user has edited or picked in the box. */
    const settle = () => (handEdited || output.value !== current.text ? Promise.resolve() : flush());

    const copyBtn = q<HTMLButtonElement>('copy');
    const copyLabel = copyBtn.querySelector<HTMLElement>('[data-label]')!;
    const copyOriginal = copyLabel.textContent ?? '';
    let reset: ReturnType<typeof setTimeout> | undefined;
    copyBtn.addEventListener('click', async () => {
      await settle();
      const value = output.value;
      if (!value) return say(L.nothingToCopy);
      await writeClipboard(value);
      track('copy_text', { tool: 'english-to-hindi' });
      copyLabel.textContent = L.copied;
      copyBtn.dataset.copied = 'true';
      say(L.copiedToClipboard);
      toast(L.copiedToast);
      clearTimeout(reset);
      reset = setTimeout(() => {
        copyLabel.textContent = copyOriginal;
        delete copyBtn.dataset.copied;
      }, 1600);
    });

    q<HTMLButtonElement>('docx').addEventListener('click', async (e) => {
      await settle();
      const body = output.value;
      if (!body) return say(L.nothingToDownload);
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      try {
        const { downloadDocx } = await import('../lib/docx.js');
        downloadDocx(body, { fontName: 'Mangal', fileName: 'mykrutidev-typing.docx' });
        say(L.downloaded);
        track('download_word', { tool: 'english-to-hindi' });
      } catch (err) {
        console.error(err);
        say(L.downloadFailed);
      } finally {
        btn.disabled = false;
      }
    });

    // Both of these REPLACE the input, so earlier picks no longer apply.
    q<HTMLButtonElement>('clear').addEventListener('click', () => {
      input.value = '';
      picks.clear();
      handEdited = false;
      countIn.textContent = '0';
      void flush();
      input.focus();
    });

    q<HTMLButtonElement>('sample').addEventListener('click', (e) => {
      input.value = (e.currentTarget as HTMLElement).dataset.sample || '';
      picks.clear();
      handEdited = false;
      countIn.textContent = String(input.value.length);
      void flush();
      input.focus();
    });

    // Draft, Recent and shortcuts - the output here is already Unicode, so
    // both copy shortcuts press the one Copy button.
    workspace(root, 'english-to-hindi', { copy: 'copy' });

    tick();
  }
</script>
