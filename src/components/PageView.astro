---
import Base from '../layouts/Base.astro';
import Converter from './Converter.astro';
import ConvertModes from './ConvertModes.astro';
import Transliterator from './Transliterator.astro';
import HindiKeyboard from './HindiKeyboard.astro';
import TypingTutor from './TypingTutor.astro';
import Faq from './Faq.astro';
import HowTo from './HowTo.astro';
import HomeTasks from './HomeTasks.astro';
import GuidedTour from './GuidedTour.astro';
import Printable from './Printable.astro';
import PrintablesList from './PrintablesList.astro';
import PrintKeyboard from './PrintKeyboard.astro';
import Problems from './Problems.astro';
import { printableFor } from '../lib/printables.js';
import AllConverters from './AllConverters.astro';
import FontStrip from './FontStrip.astro';
import HindiTool from './HindiTool.astro';
import { TOOL_PAGES } from '../lib/toolPages.js';
import { getPage, isLive, reversePage, statusOf, docPairFor, CONTACT_EMAIL } from '../lib/routes.js';
import SoonBadge from './SoonBadge.astro';
import StoreList from './StoreList.astro';
import StoreBuy from './StoreBuy.astro';
import StorePreview from './StorePreview.astro';
import StoreThanks from './StoreThanks.astro';
import { STORE } from '../lib/store.js';
import { BUSINESS, businessLines } from '../lib/business.js';
import { FONTS } from '../lib/fontMaps.js';
import { langOf, useT } from '../i18n/index.js';

/**
 * One page of the site, in whichever language its URL is in.
 *
 * Everything that varies by page is data: the structure comes from routes.js
 * and every word from src/i18n/{en,hi}.json under `pages.<path>`. So
 * src/pages/<slug>.astro (English) and src/pages/hi/[...slug].astro (Hindi)
 * both render this with nothing but a path, and the two languages cannot drift
 * apart in layout - only in wording, which is what docs/TRANSLATIONS-REVIEW.md is for.
 */
interface Props {
  /** Route path - everything else is looked up in routes.js and src/i18n. */
  path: string;
}

const { path } = Astro.props;

const page = getPage(path);
if (!page) throw new Error(`No routes.js entry for ${path}`);

const lang = langOf(Astro.url);
const { t, maybe, render, path: to } = useT(lang);
const text = (field: string) => t(`pages.${path}.${field}`);

const live = isLive(page);
// A store product is suggested only once it is on sale: never as a "soon" card.
const related = page.related.map(getPage).filter((r) => r && (!r.product || isLive(r)));

// The interactive tool a content page is built around, if any.
const TOOLS: Record<string, any> = {
  '/english-to-hindi-typing': Transliterator,
  '/hindi-keyboard': HindiKeyboard,
  '/hindi-typing-test': TypingTutor,
  '/hindi-typing-test-for-exams': TypingTutor,
  '/how-to-type-hindi-in-ms-word': Transliterator,
};
// The everyday tools share one component, told which tool to be.
const hindiTool = (TOOL_PAGES as Record<string, { tool: string; script?: string }>)[path];
const Tool = TOOLS[path] ?? (hindiTool ? HindiTool : undefined);
const toolProps = hindiTool ?? {};

// Only offer the swap link when the reverse page is actually usable.
const rev = reversePage(page);
const reverse = rev && isLive(rev) ? { path: rev.path, h1: t(`pages.${rev.path}.h1`) } : null;

// "Coming soon" copy differs by what is missing: a mapping, or just the prose.
const pendingConverter = !live && page.kind === 'converter';
const fontName = (k: string) => t(`fontBox.${k}`);
const fromName = page.from ? fontName(page.from) : null;
const toName = page.to ? fontName(page.to) : null;

// "Upload Word file" on every converter whose two fonts the document
// converter knows (docPairFor in routes.js).
const docPair = docPairFor(page);

// Which half is holding it up - worth saying plainly rather than a blanket
// "coming soon", because often one side is done and tested already.
const blockers = [page.from, page.to]
  .filter((k) => k && !FONTS[k]?.accurate)
  .map((k) => FONTS[k!].label);

// The few numbers the store's pages quote come from src/lib/store.js, so the
// policy text can never disagree with what the server does.
const STORE_VARS: Record<string, string> = {
  '{email}': CONTACT_EMAIL,
  '{refundDays}': String(STORE.refundDays),
  '{downloadDays}': String(STORE.downloadDays),
  '{maxDownloads}': String(STORE.maxDownloads),
  '{unpaidDays}': String(STORE.unpaidDays),
  // Who runs the site, from src/lib/business.js (privacy policy).
  '{seller}': [BUSINESS.name, BUSINESS.address].map((v) => v.trim()).filter(Boolean).join(', ') || 'MyKrutiDev',
};
const fillVars = (s: string) => Object.entries(STORE_VARS).reduce((acc, [k, v]) => acc.replaceAll(k, v), s);
const body: string[] = (maybe(`pages.${path}.body`) ?? []).map(fillVars);
// Who sells: printed on /contact once src/lib/business.js is filled in.
const seller = path === '/contact' ? businessLines(BUSINESS) : [];
const problems: { problem: string; fix: string }[] = maybe(`pages.${path}.problems`) ?? [];
// Converters and the everyday tools sit under "All tools" in the breadcrumb trail.
const trail =
  (page.kind === 'converter' && path !== '/') || hindiTool ? [{ name: t('nav.allConverters'), path: '/all-converters' }] : [];
const faq: { q: string; a: string }[] = maybe(`pages.${path}.faq`) ?? [];
const howTo: { steps: string[]; tip: string } | undefined = maybe(`pages.${path}.howTo`);
const tour: string[] | undefined = maybe(`pages.${path}.tour`);
const printable = printableFor(path);
const note = maybe(`pages.${path}.note`);
const betaNote = maybe(`pages.${path}.betaNote`);
---

{/* The one page that is a table rather than an article. */}
{path === '/all-converters' ? <AllConverters /> : (
<Base title={text('title')} description={text('description')} noindex={!live} trail={trail} crumb={text('nav')}>
  <div class="wrap py-8 sm:py-12">
    <div class="title-row flex items-start justify-between gap-3">
      <h1 class="text-3xl sm:text-4xl">
        <Fragment set:html={render(text('h1'))} />
        {
          page.beta && (
            <span class="ml-2 inline-block rounded-full border border-saffron/40 bg-warn-bg px-2.5 py-0.5 align-middle text-xs font-semibold tracking-wide text-badge uppercase">
              {t('page.beta')}
            </span>
          )
        }
      </h1>
      {
        tour && (
          <button
            type="button"
            class="tour-replay mt-1"
            data-tour-replay
            aria-label={t('guide.tourReplay')}
            title={t('guide.tourReplay')}
          >
            ?
          </button>
        )
      }
    </div>
    {betaNote && <p class="mt-2 text-sm font-medium text-ink" set:html={render(betaNote)} />}
    <p class="mt-3 max-w-2xl text-base text-body" set:html={render(fillVars(text('lede')))} />
    {live && page.kind === 'converter' && <FontStrip page={page} />}

    {path === '/store' && <StoreList />}
    {page.product && <StorePreview product={page.product} />}
    {page.product && <StoreBuy product={page.product} />}
    {path === '/store/thanks' && <StoreThanks />}

    {
      Tool && (
        <div class="mt-6 scroll-mt-4" id="tool">
          <Tool {...toolProps} />
        </div>
      )
    }

    {
      live && page.from && page.to && (
        <div class="mt-6 scroll-mt-4" id="tool">
          {docPair ? (
            // Paste text / Upload Word file, as tabs in the same place.
            <ConvertModes from={docPair.from} to={docPair.to} path={path}>
              <Converter from={page.from} to={page.to} reverse={reverse} />
            </ConvertModes>
          ) : (
            <Converter from={page.from} to={page.to} reverse={reverse} />
          )}
        </div>
      )
    }

    {
      live && path === '/remington-hindi-keyboard' && (
        <section aria-labelledby="layout-heading" class="mt-10">
          <h2 id="layout-heading" class="text-xl">{t('page.layoutHeading')}</h2>
          <p class="mt-1 text-xs font-semibold text-mute" data-font-line set:html={render(t('print.fontLine'))} />
          <p class="mt-2 max-w-2xl text-sm text-body" set:html={render(t('page.layoutNote'))} />
          <div class="mt-4 card p-3 sm:p-4">
            <PrintKeyboard mode="layout" />
          </div>
        </section>
      )
    }

    {live && printable && <Printable printable={printable} />}
    {live && printable && <PrintablesList except={path} />}

    {/* Help sits UNDER the tool, never over it: the tool is the first thing on the page. */}
    {live && howTo && <HowTo steps={howTo.steps} tip={howTo.tip} />}

    {live && problems.length > 0 && <Problems items={problems} />}

    {live && (path === '/hindi-typing-test' || path === '/hindi-keyboard') && <PrintablesList />}

    {/* The document converter now lives in the Upload tab at the top; here, where
        it used to be, a link back up to it. */}
    {
      docPair && (
        <p class="mt-8 text-sm text-body" set:html={render(t('modes.back', { href: `${to(path)}?mode=file` }))} />
      )
    }

    {path === '/' && <HomeTasks />}

    {live && tour && <GuidedTour path={path} steps={tour} />}

    {
      pendingConverter && (
        <section
          aria-labelledby="soon"
          class="mt-6 card border-saffron/40 bg-warn-bg p-6 sm:p-8"
        >
          <p class="text-xs font-semibold tracking-wide text-badge uppercase">
            {t('page.comingSoon')}
          </p>
          <h2
            id="soon"
            class="mt-2 text-xl"
            set:html={render(
              fromName && toName
                ? t('page.pendingMapping', { from: fromName, to: toName })
                : t('page.pendingBuilding'),
            )}
          />
          {note && <p class="mt-3 max-w-2xl text-body" set:html={render(note)} />}
          <p class="mt-3 max-w-2xl text-body">
            {t('page.pendingLead')}{' '}
            <strong class="font-medium text-ink">{t('page.pendingStrong')}</strong>
            {t('page.pendingTail')}
            {blockers.length > 0 && (
              <>
                {' '}
                <Fragment
                  set:html={render(
                    t('page.stillToVerify', { list: blockers.join(t('page.listAnd')) }),
                  )}
                />
              </>
            )}
          </p>
          <p class="mt-5" set:html={render(t('page.pendingLinks'))} />
        </section>
      )
    }

    {faq.length > 0 && <Faq items={faq} schema={live} />}

    <div class="prose-page mt-12 text-body" set:html={body.map(render).join('\n')} />

    {
      seller.length > 0 && (
        <section class="mt-8" aria-labelledby="seller">
          <h2 id="seller" class="text-xl">{t('store.businessHeading')}</h2>
          <p class="mt-2 text-body" translate="no">
            {seller.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        </section>
      )
    }

    {
      related.length > 0 && (
        <nav aria-labelledby="related" class="mt-12">
          <h2 id="related" class="text-xl">
            {page.tool ? t('page.relatedTools') : t('page.relatedConverters')}
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li data-route={r.path}>
                <a
                  href={r.path}
                  class="block h-full card p-4 no-underline transition-colors hover:border-saffron"
                >
                  <span class="block font-medium text-ink">
                    <Fragment set:html={render(t(`pages.${r.path}.h1`))} />
                    <SoonBadge status={statusOf(r)} class="ml-2 inline-block align-middle" />
                  </span>
                  <span
                    class="mt-1 block text-sm text-body"
                    set:html={render(t(`pages.${r.path}.description`))}
                  />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>
)}
