---
/**
 * The buy box on a product page: email, agree, pay. Pressing "Pay" asks our
 * server (POST /api/store/checkout) for a Razorpay payment link and sends the
 * browser to it - the buyer pays on Razorpay's own page, so no Razorpay script
 * ever runs on MyKrutiDev (src/lib/store.js, server/razorpay.js).
 *
 * Only the buyer's email goes to our server; see the privacy policy.
 */
import { PRODUCTS, price } from '../lib/store.js';
import { langOf, useT, fill } from '../i18n/index.js';

interface Props {
  /** The catalog id (src/lib/store.js). */
  product: string;
}
const { product: id } = Astro.props;
const product = PRODUCTS.find((p) => p.id === id);
if (!product) throw new Error(`No store product ${id}`);

const lang = langOf(Astro.url);
const { t, render } = useT(lang);
const amount = price(product.pricePaise);
const strings = Object.fromEntries(
  ['errEmail', 'errAccept', 'errRate', 'errChallenge', 'errClosed', 'errProvider', 'errGeneric', 'working'].map((k) => [k, t(`store.${k}`)]),
);
const buy = fill(t('store.buy'), { price: amount });
---

<section class="mt-8 card p-5 sm:p-6 sb" aria-labelledby="sb-h" data-store-buy>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 id="sb-h" class="text-xl">{t('store.buyHeading')}</h2>
    <p class="text-sm text-mute">{fill(t('store.meta'), { pages: String(product.pages) })}</p>
  </div>
  <p class="mt-3 text-sm text-mute">{t('store.price')}</p>
  <p class="text-3xl font-semibold text-ink" translate="no">{amount}</p>

  <form
    class="mt-5 grid gap-4"
    novalidate
    data-sb-form
    data-product={product.id}
    data-price={String(product.pricePaise / 100)}
    data-lang={lang}
    data-i18n={JSON.stringify(strings)}
  >
    <div class="grid gap-1.5">
      <label for="sb-email" class="sb-label">{t('store.emailLabel')}</label>
      <input
        id="sb-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        maxlength="254"
        class="sb-input"
        aria-describedby="sb-email-help"
        translate="no"
      />
      <p id="sb-email-help" class="text-xs text-mute">{t('store.emailHelp')}</p>
    </div>
    <label class="flex items-start gap-2 text-sm text-body">
      <input type="checkbox" name="accept" class="mt-1 h-4 w-4" data-sb-accept />
      <span set:html={render(t('store.acceptLabel'))} />
    </label>
    {/* The honeypot: out of sight and out of the tab order. A person never fills it. */}
    <div class="sb-hp" aria-hidden="true">
      <label for="sb-website">Website</label>
      <input id="sb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div data-sb-turnstile></div>
    <p class="sb-err" data-sb-error role="alert" hidden></p>
    <div>
      <button type="submit" class="btn btn-primary" data-sb-pay data-label={buy}>{buy}</button>
    </div>
  </form>

  <ul class="mt-5 grid gap-1.5 text-xs text-mute">
    <li set:html={render(t('store.payNote'))} />
    <li set:html={render(t('store.deliveryNote'))} />
    <li set:html={render(t('store.refundNote'))} />
  </ul>
</section>

<style>
  .sb-label {
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .sb-input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-chrome);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }
  .sb-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .sb-err {
    color: var(--color-err);
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

<script>
  import { checkoutError, payUrlOk } from '../lib/storeClient.js';
  import { track } from '../scripts/track.js';

  const form = document.querySelector<HTMLFormElement>('[data-sb-form]');
  if (form) {
    const L = JSON.parse(form.dataset.i18n ?? '{}');
    const lang = form.dataset.lang || 'en';
    const email = form.querySelector<HTMLInputElement>('#sb-email')!;
    const accept = form.querySelector<HTMLInputElement>('[data-sb-accept]')!;
    const website = form.querySelector<HTMLInputElement>('#sb-website')!;
    const err = form.querySelector<HTMLParagraphElement>('[data-sb-error]')!;
    const pay = form.querySelector<HTMLButtonElement>('[data-sb-pay]')!;
    // Google Analytics' shop events: the product and its price, never the email.
    const item = { currency: 'INR', value: Number(form.dataset.price), items: [{ item_id: form.dataset.product, price: Number(form.dataset.price) }] };
    track('view_item', item);

    // Turnstile starts once someone begins filling in the form, not on page load.
    // Loaded on demand (not imported up front) so the shop adds nothing to the pages that share this script's chunks.
    type Check = Awaited<ReturnType<(typeof import('../scripts/turnstile.js'))['challenge']>>;
    let check: Promise<Check> | null = null;
    const startCheck = () =>
      (check ??= import('../scripts/turnstile.js').then((m) => m.challenge(form.querySelector('[data-sb-turnstile]')!, lang)));
    form.addEventListener('focusin', startCheck, { once: true });

    const fail = (text: string, el?: HTMLElement) => {
      err.textContent = text;
      err.hidden = false;
      el?.focus();
    };
    const busy = (on: boolean) => {
      pay.disabled = on;
      pay.textContent = on ? L.working : (pay.dataset.label ?? '');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const address = email.value.trim();
      // The email is optional: empty is fine, a typed one must look right.
      if (address && !email.checkValidity()) return fail(L.errEmail, email);
      if (!accept.checked) return fail(L.errAccept, accept);

      busy(true);
      track('begin_checkout', item);
      let res: Response | null = null;
      let json: any = null;
      try {
        const token = await (await startCheck())?.token();
        res = await fetch('/api/store/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ productId: form.dataset.product, email: address, accept: true, lang, token, website: website.value }),
        });
        json = /json/.test(res.headers.get('Content-Type') ?? '') ? await res.json().catch(() => null) : null;
      } catch {
        res = null;
      }
      if (res?.ok && json?.ok && payUrlOk(json.url)) {
        try {
          sessionStorage.setItem('mkd-order', String(json.order ?? ''));
        } catch {
          // fine without it: Razorpay sends the order id back in the address
        }
        location.assign(json.url);
        return;
      }
      busy(false);
      if (res?.status === 403) void (await check)?.reset();
      fail(L[checkoutError(res?.status ?? 0, json?.error)] ?? L.errGeneric);
    });
  }
</script>
