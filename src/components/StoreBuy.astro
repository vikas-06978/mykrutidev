---
/**
 * The buy box on a product page: email, agree, pay. Pressing "Pay" asks our
 * server (POST /api/store/checkout) for a Razorpay payment link and sends the
 * browser to it - the buyer pays on Razorpay's own page, so no Razorpay script
 * ever runs on MyKrutiDev (src/lib/store.js, server/razorpay.js).
 *
 * Only the buyer's email goes to our server; see the privacy policy.
 */
import { PRODUCTS, STORE, price } from '../lib/store.js';
import { langOf, useT, fill } from '../i18n/index.js';

interface Props {
  /** The catalog id (src/lib/store.js). */
  product: string;
}
const { product: id } = Astro.props;
const product = PRODUCTS.find((p) => p.id === id);
if (!product) throw new Error(`No store product ${id}`);

const lang = langOf(Astro.url);
const { t, render, path: to } = useT(lang);
const amount = price(product.pricePaise);
const strings = Object.fromEntries(
  [
    'errEmail', 'errAccept', 'errRate', 'errChallenge', 'errClosed', 'errProvider', 'errGeneric', 'working', 'thanksLeft',
    'thanksRefunded', 'thanksExpired', 'pendingNote', 'forgotten',
  ].map((k) => [k, t(`store.${k}`)]),
);
const limits = fill(t('store.limitsNote'), { n: String(STORE.maxDownloads), days: String(STORE.downloadDays) });
const buy = fill(t('store.buy'), { price: amount });
---

<section class="mt-8 card p-5 sm:p-6 sb" aria-labelledby="sb-h" data-store-buy>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 id="sb-h" class="text-xl">{t('store.buyHeading')}</h2>
    <p class="text-sm text-mute">{fill(t('store.meta'), { pages: String(product.pages) })}</p>
  </div>
  {/*
    Bought in this browser (src/lib/storeClient.js), and the server says the
    link still works: this box takes the place of the price and the form,
    which stay one click away for a second copy.
  */}
  <div class="sb-owned mt-5" data-sb-owned hidden>
    <p class="text-sm font-medium text-ink" data-sb-owned-note>✓ {t('store.ownedNote')}</p>
    <p class="mt-1 text-sm text-body" data-sb-owned-left hidden></p>
    <p class="mt-1 text-sm text-body" data-sb-owned-closed hidden></p>
    <a class="btn btn-primary mt-3" href={to('/store/thanks')} data-sb-owned-link>{t('store.ownedButton')}</a>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      <button type="button" class="sb-again" data-sb-again hidden>{t('store.buyAgain')}</button>
      <button type="button" class="sb-again" data-sb-forget>{t('store.forget')}</button>
    </p>
  </div>
  {/* A payment started here and not yet seen paid: do not let a worried buyer pay twice. */}
  <div class="sb-pending mt-5" data-sb-pending role="status" hidden>
    <p class="text-sm font-medium text-ink" data-sb-pending-note></p>
    <a class="btn btn-outline mt-3" href={to('/store/thanks')} data-sb-pending-link>{t('store.pendingCheck')}</a>
  </div>

  <div data-sb-buyarea>
  <p class="mt-3 text-sm text-mute">{t('store.price')}</p>
  <p class="text-3xl font-semibold text-ink" translate="no">{amount}</p>

  <form
    class="mt-5 grid gap-4"
    novalidate
    data-sb-form
    data-product={product.id}
    data-price={String(product.pricePaise / 100)}
    data-lang={lang}
    data-i18n={JSON.stringify(strings)}
  >
    <div class="grid gap-1.5">
      <label for="sb-email" class="sb-label">{t('store.emailLabel')}</label>
      <input
        id="sb-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        maxlength="254"
        class="sb-input"
        aria-describedby="sb-email-help"
        translate="no"
      />
      <p id="sb-email-help" class="text-xs text-mute">{t('store.emailHelp')}</p>
    </div>
    <label class="flex items-start gap-2 text-sm text-body">
      <input type="checkbox" name="accept" class="mt-1 h-4 w-4" data-sb-accept />
      <span set:html={render(t('store.acceptLabel'))} />
    </label>
    {/* The honeypot: out of sight and out of the tab order. A person never fills it. */}
    <div class="sb-hp" aria-hidden="true">
      <label for="sb-website">Website</label>
      <input id="sb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div data-sb-turnstile></div>
    <p class="sb-err" data-sb-error role="alert" hidden></p>
    <div>
      <button type="submit" class="btn btn-primary" data-sb-pay data-label={buy}>{buy}</button>
    </div>
  </form>
  </div>

  {/* For a buyer on another phone or browser: the download page has the "send my link" form. */}
  <p class="mt-4 text-sm"><a href={`${to('/store/thanks')}#find`} data-sb-bought>{t('store.alreadyBought')}</a></p>

  <ul class="mt-5 grid gap-1.5 text-xs text-mute">
    <li>{limits}</li>
    <li set:html={render(t('store.payNote'))} />
    <li set:html={render(t('store.deliveryNote'))} />
    <li set:html={render(t('store.refundNote'))} />
  </ul>
</section>

<style>
  .sb-label {
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .sb-input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-chrome);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }
  .sb-again {
    border: 0;
    background: none;
    padding: 0;
    color: var(--color-link, var(--color-brick));
    text-decoration: underline;
    font: inherit;
    cursor: pointer;
  }
  .sb-owned {
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-ok);
    border-radius: var(--radius-chrome);
    background: var(--color-surface);
  }
  .sb-pending {
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-brick);
    border-radius: var(--radius-chrome);
    background: var(--color-surface);
  }
  .sb-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .sb-err {
    color: var(--color-err);
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

<script>
  import {
    boughtEntry,
    checkoutError,
    daysLeft,
    forgetDevice,
    forgetPending,
    forgetPurchase,
    payUrlOk,
    pendingFor,
    rememberPending,
    rememberPurchase,
  } from '../lib/storeClient.js';
  import { track } from '../scripts/track.js';

  const form = document.querySelector<HTMLFormElement>('[data-sb-form]');
  const ls = (): Storage | null => {
    try {
      return localStorage;
    } catch {
      return null;
    }
  };
  const L0 = JSON.parse(form?.dataset.i18n ?? '{}');
  const pageLang = form?.dataset.lang || 'en';
  /** "Buy another copy" pressed: the next Pay starts a new order instead of reusing the open one. */
  let fresh = false;

  // Bought already in this browser: offer that download first. The server is
  // asked whether the link still works (and how many downloads are left); if
  // it does, the price and the form step aside behind "Buy another copy". A
  // refunded or expired one says so, with its receipt on the download page.
  const owned = document.querySelector<HTMLElement>('[data-sb-owned]');
  const ownedLink = owned?.querySelector<HTMLAnchorElement>('[data-sb-owned-link]');
  const ownedLeft = owned?.querySelector<HTMLElement>('[data-sb-owned-left]');
  const ownedClosed = owned?.querySelector<HTMLElement>('[data-sb-owned-closed]');
  const again = owned?.querySelector<HTMLButtonElement>('[data-sb-again]');
  const forget = owned?.querySelector<HTMLButtonElement>('[data-sb-forget]');
  const buyArea = document.querySelector<HTMLElement>('[data-sb-buyarea]');
  const pendingBox = document.querySelector<HTMLElement>('[data-sb-pending]');
  const product = form?.dataset.product ?? '';
  const storage = ls();
  const entry = storage && product ? boughtEntry(storage, product) : null;

  if (owned && ownedLink && ownedLeft && ownedClosed && again && forget && buyArea && product && entry) {
    ownedLink.href = `${ownedLink.pathname}#o=${entry.o}&t=${entry.t}`;
    owned.hidden = false;
    fetch('/api/store/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ o: entry.o, t: entry.t, m: entry.m }),
    })
      .then((r) => (r.ok || r.status === 404 ? r.json().then((d) => ({ status: r.status, d })) : null))
      .then((got) => {
        if (!got) return; // No answer (offline, busy): the box stays, and so does the form.
        const d = got.d;
        if (d?.ok && d.state === 'paid' && d.remaining > 0) {
          ownedLeft.textContent = String(L0.thanksLeft ?? '')
            .replace('{n}', String(d.remaining))
            .replace('{days}', String(daysLeft(d.expires)));
          ownedLeft.hidden = false;
          buyArea.hidden = true;
          again.hidden = false;
          // They are here already: "Already bought?" would only repeat the box.
          document.querySelector<HTMLElement>('[data-sb-bought]')?.closest('p')?.setAttribute('hidden', '');
        } else if (d?.ok && (d.state === 'refunded' || d.state === 'expired' || d.state === 'used')) {
          // Closed: say why, keep the way to the receipt, and the form is there to buy again.
          ownedClosed.textContent = d.state === 'refunded' ? L0.thanksRefunded : L0.thanksExpired;
          ownedClosed.hidden = false;
          owned.querySelector('[data-sb-owned-note]')?.setAttribute('hidden', '');
          ownedLink.classList.replace('btn-primary', 'btn-outline');
        } else if (got.status === 404) {
          // The key is no longer valid here (it moved on to a corrected email): forget it.
          if (storage) forgetPurchase(storage, product);
          owned.hidden = true;
        }
      })
      .catch(() => {});
    again.addEventListener('click', () => {
      buyArea.hidden = false;
      again.hidden = true;
      fresh = true;
    });
  }
  forget?.addEventListener('click', () => {
    if (storage && product) forgetDevice(storage, product);
    if (owned) {
      owned.replaceChildren(Object.assign(document.createElement('p'), { className: 'text-sm text-body', textContent: L0.forgotten ?? '' }));
    }
    if (buyArea) buyArea.hidden = false;
  });

  // A payment started here and not yet seen paid (the tab closed during UPI,
  // the bank was slow): ask once whether it went through. Paid: it becomes
  // the bought box above on the next visit, and the download is one click
  // away. Still open: "do not pay again", and Pay reuses the same payment page.
  const pending = !entry && storage && product ? pendingFor(storage, product) : null;
  if (pending && pendingBox && storage) {
    fetch('/api/store/confirm', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ order: pending.o, claim: pending.c }),
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d?.ok) return;
        const link = pendingBox.querySelector<HTMLAnchorElement>('[data-sb-pending-link]')!;
        const note = pendingBox.querySelector<HTMLElement>('[data-sb-pending-note]')!;
        if (d.state === 'paid' && d.token && !d.locked) {
          rememberPurchase(storage, product, pending.o, d.token, d.expires, d.manage);
          forgetPending(storage, pending.o);
          location.reload();
          return;
        }
        if (d.state === 'pending' || d.state === 'created' || d.state === 'unverified') {
          let when = '';
          try {
            when = new Intl.DateTimeFormat(`${pageLang}-IN`, { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }).format(pending.at);
          } catch {
            when = new Date(pending.at).toISOString().slice(0, 16).replace('T', ' ');
          }
          note.textContent = String(L0.pendingNote ?? '').replace('{time}', when);
          link.href = `${link.pathname}?razorpay_payment_link_reference_id=${pending.o}`;
          pendingBox.hidden = false;
          return;
        }
        // Closed, failed or unknown: nothing to wait for.
        forgetPending(storage, pending.o);
      })
      .catch(() => {});
  }

  if (form) {
    const L = L0;
    const lang = pageLang;
    const email = form.querySelector<HTMLInputElement>('#sb-email')!;
    const accept = form.querySelector<HTMLInputElement>('[data-sb-accept]')!;
    const website = form.querySelector<HTMLInputElement>('#sb-website')!;
    const err = form.querySelector<HTMLParagraphElement>('[data-sb-error]')!;
    const pay = form.querySelector<HTMLButtonElement>('[data-sb-pay]')!;
    // Google Analytics' shop events: the product and its price, never the email.
    const item = { currency: 'INR', value: Number(form.dataset.price), items: [{ item_id: form.dataset.product, price: Number(form.dataset.price) }] };
    track('view_item', item);

    // Turnstile starts once someone begins filling in the form, not on page load.
    // Loaded on demand (not imported up front) so the shop adds nothing to the pages that share this script's chunks.
    type Check = Awaited<ReturnType<(typeof import('../scripts/turnstile.js'))['challenge']>>;
    let check: Promise<Check> | null = null;
    const startCheck = () =>
      (check ??= import('../scripts/turnstile.js').then((m) => m.challenge(form.querySelector('[data-sb-turnstile]')!, lang)));
    form.addEventListener('focusin', startCheck, { once: true });

    const fail = (text: string, el?: HTMLElement) => {
      err.textContent = text;
      err.hidden = false;
      el?.focus();
    };
    const busy = (on: boolean) => {
      pay.disabled = on;
      pay.textContent = on ? L.working : (pay.dataset.label ?? '');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const address = email.value.trim();
      // The email is optional: empty is fine, a typed one must look right.
      if (address && !email.checkValidity()) return fail(L.errEmail, email);
      if (!accept.checked) return fail(L.errAccept, accept);

      busy(true);
      track('begin_checkout', item);
      let res: Response | null = null;
      let json: any = null;
      // A payment page already open from this browser is reused, so one buyer
      // never ends up with two to pay. "Buy another copy" starts a new one.
      const open = !fresh && storage ? pendingFor(storage, product) : null;
      try {
        const token = await (await startCheck())?.token();
        res = await fetch('/api/store/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            productId: form.dataset.product,
            email: address,
            accept: true,
            lang,
            token,
            website: website.value,
            ...(open ? { resume: { order: open.o, claim: open.c } } : {}),
          }),
        });
        json = /json/.test(res.headers.get('Content-Type') ?? '') ? await res.json().catch(() => null) : null;
      } catch {
        res = null;
      }
      if (res?.ok && json?.ok && payUrlOk(json.url)) {
        try {
          sessionStorage.setItem('mkd-order', String(json.order ?? ''));
        } catch {
          // fine without it: Razorpay sends the order id back in the address
        }
        // The checkout secret: what lets this browser get the download even if
        // the buyer never comes back from Razorpay's page.
        if (storage) rememberPending(storage, product, String(json.order ?? ''), String(json.claim ?? ''), json.reused && open ? open.at : Date.now());
        location.assign(json.url);
        return;
      }
      busy(false);
      // A failed robot check (common on some Android browsers): a fresh one for the next try.
      if (res?.status === 403) void (await check)?.reset();
      fail(L[checkoutError(res?.status ?? 0, json?.error)] ?? L.errGeneric);
    });
  }
</script>
