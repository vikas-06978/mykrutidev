---
/**
 * Home page only: what else the site does, as task cards, and why to trust it.
 *
 * Sits BELOW the converter, never above it: the tool is the first thing on
 * the page, on phones too. Plain links and text - no script.
 */
import { langOf, useT } from '../i18n/index.js';
import { getPage, isLive } from '../lib/routes.js';
import { badgeFor } from '../lib/newBadges.js';

const { t, raw, render, path: to } = useT(langOf(Astro.url));

// Where each card goes. The first two are the two tabs of the converter at
// the top of this page (ConvertModes.astro switches the tab in place for a
// ?mode= link to the page you are on); Word files come second because a whole
// document is what many visitors actually have.
const ALL_TASKS = [
  ['krutiToUnicode', '/', 'text'],
  ['document', '/', 'file'],
  ['excel', '/kruti-dev-excel-to-unicode'],
  ['unicodeToKruti', '/unicode-to-kruti-dev'],
  ['englishTyping', '/english-to-hindi-typing'],
  ['keyboard', '/hindi-keyboard'],
  ['tutor', '/hindi-typing-test'],
  ['practice', '/hindi-typing-practice-passages'],
  ['printables', '/kruti-dev-keyboard'],
  ['store', '/store'],
  ['amountWords', '/number-to-hindi-words'],
  ['hindiDate', '/english-date-to-hindi'],
  ['wordCounter', '/hindi-word-counter'],
  ['otherScripts', '/hindi-to-gujarati-script'],
] as const;
// A card appears only while its page is live (the store is not, until it is on sale).
const TASKS = ALL_TASKS.filter(([, href]) => {
  const page = getPage(href);
  return page && isLive(page);
});
const why: string[] = raw('home.why');
---

<section aria-labelledby="tasks-heading" class="mt-12">
  <h2 id="tasks-heading" class="text-xl">{t('guide.tasksHeading')}</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      TASKS.map(([key, href, mode]: readonly string[]) => (
        <li>
          <a
            href={mode ? `${to(href)}?mode=${mode}` : to(href)}
            data-new-link={(!mode && badgeFor(href)) || undefined}
            class="block h-full card p-4 no-underline transition-colors hover:border-brick"
          >
            <span class="block font-semibold text-ink">
              <span set:html={render(t(`home.tasks.${key}.title`))} />
              {!mode && badgeFor(href) && (
                <span
                  data-new-badge={badgeFor(href)}
                  class="ms-2 inline-block rounded-full bg-brick px-1.5 py-0.5 align-middle text-[0.6875rem] font-semibold leading-none text-on-brick"
                >
                  {t('nav.new')}
                </span>
              )}
            </span>
            <span class="mt-1 block text-sm text-body" set:html={render(t(`home.tasks.${key}.benefit`))} />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm">
    <a href={to('/all-converters')} class="font-medium">{t('home.allTools')}</a>
  </p>
</section>

<section aria-labelledby="why-heading" class="mt-10 rounded-(--radius-card) bg-inset px-5 py-5 sm:px-6">
  <h2 id="why-heading" class="text-lg" set:html={render(t('guide.whyHeading'))} />
  <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm text-body sm:grid-cols-2 lg:grid-cols-3">
    {
      why.map((w) => (
        <li class="flex gap-2">
          <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-1 size-3.5 shrink-0 text-ok">
            <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span set:html={render(w)} />
        </li>
      ))
    }
  </ul>
</section>
