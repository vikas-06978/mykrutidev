---
import { FONTS, boxLabel, codeLabel } from '../lib/fontMaps.js';
import { SCRIPTS, scriptOfPage, devaLangOfPage } from '../lib/scripts.js';
import { previewFontFor } from '../lib/legacyFonts.js';
import { langOf, useT } from '../i18n/index.js';
import RecentStrip from './RecentStrip.astro';

interface Props {
  from: string;
  to: string;
  /** Reverse-direction page, if one exists. Drives the swap arrow. */
  reverse?: { path: string; h1: string } | null;
}

const { from, to, reverse = null } = Astro.props;

const fromFont = FONTS[from];
const toFont = FONTS[to];
if (!fromFont || !toFont) throw new Error(`Converter: unknown font ${from}/${to}`);

const { t, render } = useT(langOf(Astro.url));

// Box labels: the font's own name wherever the reader has to recognise the
// font ("Kruti Dev", "Mangal"), and the everyday word where it is a kind of
// text rather than a font ("Unicode / Hindi" -> "यूनिकोड / हिंदी").
// i18n.test.js checks the English column is exactly boxLabel().
// On a Gujarati or Tamil page the Unicode box holds that script, not Hindi:
// its own label, font, lang, example and Word font (src/lib/scripts.js).
const scriptKey = scriptOfPage(from, to);
const script = SCRIPTS[scriptKey];
const otherScript = scriptKey !== 'deva';
// A Marathi or Nepali page: Devanagari fonts, but its own words on the Unicode box.
const devaLang = otherScript ? null : devaLangOfPage(from, to);
const suffix = devaLang ? devaLang.suffix : script.suffix;
const boxName = (k: string) =>
  (otherScript || (devaLang && k === 'unicode')) && FONTS[k].kind === 'unicode'
    ? t(`converter.unicode${suffix}`)
    : t(`fontBox.${k}`);
const fromLabel = boxName(from);
const toLabel = boxName(to);
void boxLabel;

// A legacy placeholder is a real code sample plus "(example)". The code stays
// as it is in every language - only the word "example" is translated.
const unicodeOther = fromFont.kind === 'unicode' && otherScript;
const unicodeDevaLang = from === 'unicode' && devaLang;
const inputSample = unicodeOther ? script.sample : unicodeDevaLang ? devaLang.sample : fromFont.sample;
const placeholder = (
  unicodeOther ? script.placeholder : unicodeDevaLang ? devaLang.placeholder : (fromFont.placeholder ?? '')
).replace('(example)', t('converter.example'));

// Every string the script below shows, in this page's language.
const strings = {
  conversionFailed: t('common.conversionFailed'),
  unicodeLabel: boxName('unicode'),
  hintUnicodeLead: t(`converter.hintUnicodeLead${suffix && suffix !== 'Mr' ? 'Other' : suffix}`),
  hintUnicodeBody: t('converter.hintUnicodeBody'),
  reverseLink: t('converter.reverseLink'),
  hintEnglishLead: t('converter.hintEnglishLead'),
  hintEnglishBody: t(`converter.hintEnglishBody${suffix && suffix !== 'Mr' ? 'Other' : suffix}`),
  hintLatinLead: t(`converter.hintLatinLead${suffix && suffix !== 'Mr' ? 'Other' : suffix}`),
  hintLatinBody: t(`converter.hintLatinBody${suffix && suffix !== 'Mr' ? 'Other' : suffix}`),
  fontMissing: t('converter.fontMissing'),
  nothingToCopy: t('common.nothingToCopy'),
  copyFailed: t('tools.copyFailed'),
  copied: t('common.copied'),
  copiedToClipboard: t('common.copiedToClipboard'),
  nothingToDownload: t('common.nothingToDownload'),
  downloaded: t('common.downloaded'),
  downloadFailed: t('common.downloadFailed'),
  nothingToShare: t('common.nothingToShare'),
  sharingFirst: t('converter.sharingFirst'),
  copiedToast: t('workspace.copiedToast'),
};

// Derived from the props rather than a counter, so ids stay stable across
// builds while still being unique if a page ever renders two converters.
const uid = `${from}-${to}`;

// Typing Hindi straight into the box only makes sense when the source IS
// Unicode; a legacy box wants pasted ASCII, so it keeps the compact size.
const inputIsUnicode = fromFont.kind === 'unicode';

// A legacy output is ASCII keystrokes that only look like Hindi once the font
// is applied, which drives every conditional below: the Preview/Raw toggle, the
// two copy buttons, the second .docx. A Unicode output is already readable
// Hindi and needs none of it: one Copy button and nothing else.
const outputIsLegacy = toFont.kind === 'legacy';
const previewFont = outputIsLegacy ? previewFontFor(to) : null;

// The copy button names the font THIS page outputs - "Copy DevLys code" on a
// DevLys page, not whichever font happened to be written into the markup first.
// Getting this wrong is not a cosmetic slip: the two buttons differ only by
// their labels, so a stale name is an instruction to paste legacy keys under a
// font the recipient does not have.
const outputCodeName = outputIsLegacy ? codeLabel(to) : null;
// The installed face name, e.g. "DevLys 010" - what Word has to resolve.
const outputFaceName = previewFont?.label ?? toFont.label;

// One preview face, no picker. The variants all shared a keyboard layout and
// differed only in letterforms, so the dropdown looked like a setting that
// mattered and was not.
const previewStack = previewFont?.stack ?? toFont.css;

// Not every converter is part of the first-visit download (src/pwa), or that
// download would grow with every font the site adds. Only the core pages are:
// Kruti Dev, DevLys and Mangal to and from Unicode (`core` in fontMaps.js),
// which is what most visitors come for. Every other converter - each further
// font, and the font-to-font pairings - is kept for offline use from the
// first time it is opened, like the guides.
const offlineOnVisit = !(fromFont.core && toFont.core) || (fromFont.kind === 'legacy' && outputIsLegacy);

// Preeti's number keys are letters, so "keep English words and numbers" has
// nothing it could keep: convert() ignores the box for such fonts, and the
// page does not offer it. It stays in the DOM because the script reads it.
const asciiIsScript = Boolean(fromFont.asciiIsScript || toFont.asciiIsScript);

// Mangal has no Gujarati or Tamil: the Unicode .docx takes the script's own
// Windows font (Shruti, Latha).
const unicodeLang = devaLang ? devaLang.lang : script.lang;
const scriptClass = script.cls;
const unicodeWordFont = script.wordFont;
const inputCss = inputIsUnicode && otherScript ? script.css : fromFont.css;
---

{/*
  No font pickers. Each page is hard-wired to one direction by its route, which
  is the whole point of the per-page design: the user picked the conversion when
  they picked the page, and asking again was where the old UI lost people.
*/}
<div
  class="cv card"
  data-converter
  data-offline={offlineOnVisit ? 'visit' : undefined}
  data-from={from}
  data-to={to}
  data-from-label={fromLabel}
  data-to-label={toLabel}
  data-reverse={reverse?.path ?? ''}
  data-i18n={JSON.stringify(strings)}
  data-view="preview"
  data-unicode-font={unicodeWordFont}
  style={`--cv-preview:${!outputIsLegacy && otherScript ? script.css : previewStack}`}
>
  <div class="grid md:grid-cols-2 md:divide-x md:divide-hairline">
    {/* Input */}
    <div class="cv-panel border-b border-hairline md:border-b-0">
      <div class="cv-head">
        <label for={`cv-in-${uid}`} class="cv-eyebrow" translate="no">{fromLabel}</label>
        <span data-role="count-in" class="cv-count">0</span>
      </div>

      <div class="cv-field">
        <textarea
          id={`cv-in-${uid}`}
          data-role="input"
          translate="no"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          lang={inputIsUnicode ? unicodeLang : undefined}
          placeholder={placeholder}
          class:list={['cv-area', scriptClass, inputIsUnicode ? 'text-lg' : 'text-base']}
          style={`font-family:${inputCss}`}></textarea>
      </div>

      <div class="cv-actions">
        <button type="button" data-role="clear" class="btn btn-ghost">{t('common.clear')}</button>
        {/*
          "Try example", not "Insert sample": users read "sample" as "upload a
          sample file". It only fills the box with real text in THIS page's
          source font. No file picker, here or anywhere on the page.
        */}
        <button
          type="button"
          data-role="sample"
          class="btn btn-ghost"
          data-sample={inputSample}
          title={t('converter.sampleTitle', { font: fromFont.label })}
        >
          {t('common.tryExample')}
        </button>
      </div>
    </div>

    {/*
      Output.

      THE PREVIEW TOGGLE IS PURELY VISUAL. It flips one attribute on the root,
      and CSS swaps the output box's font-family off that. It must never reach
      the copy buttons or the .docx exports. "The Hindi you can see" is not a
      copyable string: the clipboard can only carry the raw keys or the Unicode,
      so both are generated explicitly and labelled, rather than letting the
      visible glyphs decide.
    */}
    <div class="cv-panel bg-surface">
      <div class="cv-head">
        <label for={`cv-out-${uid}`} class="cv-eyebrow" translate="no">{toLabel}</label>
        {
          outputIsLegacy && (
            <div data-role="view" role="group" aria-labelledby={`cv-view-${uid}`} class="cv-seg">
              <span id={`cv-view-${uid}`} class="cv-seg-label">
                {t('converter.view')}
              </span>
              <button type="button" data-view="preview" aria-pressed="true">
                {t(`converter.preview${suffix}`)}
              </button>
              <button type="button" data-view="raw" aria-pressed="false">
                {t('converter.raw')}
              </button>
            </div>
          )
        }
        <span data-role="count-out" class="cv-count">0</span>
      </div>

      <div class="cv-field">
        <textarea
          id={`cv-out-${uid}`}
          data-role="output"
          translate="no"
          readonly
          spellcheck="false"
          placeholder={t('converter.outPlaceholder')}
          lang={outputIsLegacy ? undefined : unicodeLang}
          class:list={['cv-area cv-out text-base', scriptClass]}></textarea>
      </div>

      {/*
        Only for output fonts that opt in (warnUnmapped in fontMaps.js). Some
        Unicode has no key in the font at all - ॐ, ऌ - and is left as-is, which
        Word will then draw as the wrong glyph. Say so rather than stay silent.
      */}
      {
        toFont.warnUnmapped && (
          <p data-role="unmapped" hidden class="cv-hint">
            <Fragment set:html={render(t('converter.unmapped', { font: codeLabel(to) }))} />
          </p>
        )
      }

      <div class="cv-actions">
        {
          outputIsLegacy ? (
            <>
              {/*
                Two buttons, equal width, because the choice between them is the
                whole point of this page and neither is an afterthought. Raw keys
                are primary only because that is what the page's title promised.
              */}
              <div class="cv-copies">
                <div class="cv-copy">
                  <button type="button" data-role="copy-raw" class="btn btn-primary">
                    <span data-label set:html={render(t('converter.copyCode', { font: outputCodeName }))} />
                  </button>
                  <span class="cv-sub" set:html={render(t('converter.forWord'))} />
                </div>
                <div class="cv-copy">
                  <button type="button" data-role="copy-unicode" class="btn btn-outline">
                    <span data-label>{t(`converter.copyUnicode${suffix}`)}</span>
                  </button>
                  <span class="cv-sub">{t('converter.forWeb')}</span>
                </div>
              </div>

              <div class="cv-secondary">
                <button
                  type="button"
                  data-role="docx"
                  class="btn btn-ghost"
                  title={t('converter.docxTitle', { font: outputFaceName })}
                >
                  <span set:html={render(t('common.downloadDocx'))} />
                </button>
                <button
                  type="button"
                  data-role="docx-unicode"
                  class="btn btn-ghost"
                  title={t(`converter.unicodeDocxTitle${suffix && suffix !== 'Mr' ? 'Other' : suffix}`, { unicode: boxName('unicode') })}
                >
                  <span set:html={render(t('converter.unicodeDocx'))} />
                </button>
                <a
                  data-role="whatsapp"
                  href="#"
                  target="_blank"
                  rel="noopener"
                  class="btn btn-ghost"
                >
                  {t('converter.whatsapp')}
                </a>
              </div>
            </>
          ) : (
            <div class="cv-secondary">
              <button type="button" data-role="copy-raw" class="btn btn-primary">
                <span data-label>{t('common.copyText')}</span>
              </button>
              <button type="button" data-role="docx" class="btn btn-ghost">
                <span set:html={render(t('common.downloadDocx'))} />
              </button>
              <a data-role="whatsapp" href="#" target="_blank" rel="noopener" class="btn btn-ghost">
                {t('converter.whatsapp')}
              </a>
            </div>
          )
        }
        <span data-role="status" role="status" aria-live="polite" class="sr-only"></span>
      </div>
    </div>
  </div>

  {/*
    A hint, never a block. It fires when the pasted text clearly is not this
    page's source font. The failure mode of a one-direction page is landing on
    the wrong one, and silently returning garbage is what confused people before.
  */}
  <p data-role="hint" hidden class="cv-hint"></p>

  <RecentStrip font={fromFont.css} unicodeCopy={outputIsLegacy} />

  <div class="cv-strip bg-inset" hidden={asciiIsScript}>
    <label class="flex items-start gap-2.5 text-body">
      <input
        type="checkbox"
        data-role="keep-english"
        checked
        class="mt-0.5 size-4 shrink-0 accent-[var(--color-brick)]"
      />
      <span>
        <strong class="font-medium text-ink">{t('converter.keepEnglish')}</strong>
        <span class="block text-xs text-mute">{t('converter.keepEnglishHelp')}</span>
      </span>
    </label>

    {/*
      The words that decision touched, one tick each: kept as English (ticked)
      and converted words that may be English (unticked). The visitor has the
      last word on every one; nothing here is guessed silently.
    */}
    {
      fromFont.kind === 'legacy' && !asciiIsScript && (
        <div data-role="english-words" class="cv-words" hidden>
          <div data-role="words-kept-wrap" hidden>
            <p class="cv-words-label">{t('converter.wordsKept')}</p>
            <div data-role="words-kept" class="cv-chips" translate="no" />
          </div>
          <div data-role="words-maybe-wrap" hidden>
            <p class="cv-words-label">{t('converter.wordsMaybe')}</p>
            <div data-role="words-maybe" class="cv-chips" translate="no" />
          </div>
        </div>
      )
    }
  </div>

  {/*
    Kruti Dev 055 types Hindi digits on the number keys and has Alt codes of
    its own (kruti055Keys). Pasted text has lost its font name, so the visitor
    says which cut it is. A Word file names it, and needs no box.
  */}
  {
    from === 'kruti-dev' && (
      <div class="cv-strip bg-inset">
        <label class="flex items-start gap-2.5 text-body">
          <input
            type="checkbox"
            data-role="cut-055"
            class="mt-0.5 size-4 shrink-0 accent-[var(--color-brick)]"
          />
          <span>
            <strong class="font-medium text-ink" set:html={render(t('converter.cut055'))} />
            <span class="block text-xs text-mute" set:html={render(t('converter.cut055Help'))} />
          </span>
        </label>
      </div>
    )
  }

  {/* Which Kruti Dev cuts the result is right for (each checked against its font file). */}
  {
    (from === 'kruti-dev' || to === 'kruti-dev') && (
      <p
        class="cv-strip bg-surface text-xs leading-relaxed text-body"
        data-works-with
        set:html={render(t(from === 'kruti-dev' ? 'converter.worksWithFrom' : 'converter.worksWithTo'))}
      />
    )
  }
  <p
    class="cv-strip bg-surface text-xs leading-relaxed text-mute"
    set:html={render(t(suffix ? 'converter.reviewOther' : 'converter.review'))}
  />
</div>

{
  reverse && (
    <p class="mt-3 text-center text-sm text-body">
      <a href={reverse.path} class="inline-flex items-center gap-1.5 no-underline hover:underline">
        <span aria-hidden="true">&#8644;</span>
        <span set:html={render(t('converter.otherDirection', { title: reverse.h1 }))} />
      </a>
    </p>
  )
}

{/* The shell's styles (.cv-*, .btn-*) live in src/styles/converter.css, shared
    with Transliterator.astro so the two tools cannot drift apart visually. */}

<script>
  import { convert, FONTS, describeMismatch, unmappedChars, englishReport, KRUTI_KEYBOARD } from '../lib/fontMaps.js';
  import { previewFontFor } from '../lib/legacyFonts.js';
  import { fill } from '../i18n/fill.js';
  import { workspace } from '../scripts/workspace.js';
  import { toast } from '../scripts/toast.js';
  import { track } from '../scripts/track.js';

  const WHATSAPP_LIMIT = 2000;

  /** Long enough to skip the intermediate states of a fast typist, short
   *  enough that the output still feels live. Below ~50ms a touch-typist
   *  triggers a full conversion per character on text that may be pages long. */
  const DEBOUNCE_MS = 90;

  for (const root of document.querySelectorAll<HTMLElement>('[data-converter]')) {
    setup(root);
  }

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;
    const maybe = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`);

    const input = q<HTMLTextAreaElement>('input');
    const output = q<HTMLTextAreaElement>('output');
    const keepEnglish = q<HTMLInputElement>('keep-english');
    const cut055Box = maybe<HTMLInputElement>('cut-055');
    const countIn = q<HTMLElement>('count-in');
    const countOut = q<HTMLElement>('count-out');
    const status = q<HTMLElement>('status');
    const hint = q<HTMLElement>('hint');
    const whatsapp = q<HTMLAnchorElement>('whatsapp');
    const viewGroup = maybe<HTMLElement>('view');
    const unmapped = maybe<HTMLElement>('unmapped');

    // Fixed for the life of the page. This is the whole no-dropdown design.
    const from = root.dataset.from!;
    const to = root.dataset.to!;
    const fromLabel = root.dataset.fromLabel!;
    const toLabel = root.dataset.toLabel!;
    const reversePath = root.dataset.reverse || '';
    const outputIsLegacy = FONTS[to]?.kind === 'legacy';
    // This page's words, rendered by the server into data-i18n. Only text -
    // nothing below decides anything from it.
    const L: Record<string, string> = JSON.parse(root.dataset.i18n || '{}');

    let flash: ReturnType<typeof setTimeout> | undefined;
    const say = (msg: string) => {
      status.textContent = msg;
      clearTimeout(flash);
      flash = setTimeout(() => (status.textContent = ''), 2200);
    };

    /** Render the mismatch hint, with a link to the right page where we have one. */
    function showHint(text: string) {
      const code = describeMismatch(text, from);
      if (!code) {
        hint.hidden = true;
        hint.textContent = '';
        return;
      }

      hint.hidden = false;
      hint.textContent = '';

      const lead = document.createElement('strong');
      lead.className = 'font-medium text-ink';

      if (code === 'expected-legacy-got-unicode') {
        lead.textContent = fill(L.hintUnicodeLead, { from: fromLabel, unicode: L.unicodeLabel });
        hint.append(lead, L.hintUnicodeBody);
        if (reversePath) {
          hint.append(': ');
          const a = document.createElement('a');
          a.href = reversePath;
          a.textContent = fill(L.reverseLink, { to: toLabel, from: fromLabel });
          hint.append(a, '.');
        } else {
          hint.append('.');
        }
      } else if (code === 'expected-legacy-got-english') {
        lead.textContent = fill(L.hintEnglishLead, { from: fromLabel });
        hint.append(lead, fill(L.hintEnglishBody, { from: fromLabel, unicode: L.unicodeLabel }));
      } else {
        lead.textContent = fill(L.hintLatinLead, { unicode: L.unicodeLabel });
        hint.append(lead, fill(L.hintLatinBody, { unicode: L.unicodeLabel }));
      }
    }

    /**
     * The Unicode form of what the user typed. What "Copy as Hindi" hands out.
     *
     * Derived from the INPUT, not from the legacy output. On every page that
     * shows this button the source is already Unicode, so convert()'s
     * unicode -> unicode branch returns it verbatim: lossless and free. A
     * future legacy -> legacy page gets a real conversion from the same call.
     * Never read the output box here. Round-tripping legacy -> unicode ->
     * legacy is where fidelity goes to die.
     */
    // ----------------------------------------------------------------------
    // The visitor's own English / Hindi choice, word by word
    // ----------------------------------------------------------------------
    const keepWords = new Set<string>();
    const convertWords = new Set<string>();
    const wordsPanel = maybe<HTMLElement>('english-words');
    let candidates: Set<string> | undefined;
    let candidatesAsked = false;

    /** The list of English words a Kruti Dev page may suggest, fetched once, when first needed. */
    function askCandidates() {
      if (candidatesAsked || !KRUTI_KEYBOARD.has(from)) return;
      candidatesAsked = true;
      fetch('/data/kruti-english.json')
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d?.words) return;
          candidates = new Set(d.words);
          renderWords();
        })
        .catch(() => {
          // Offline or blocked: the kept words still show; suggestions do not.
        });
    }

    function chip(token: string, hindi: string, english: boolean) {
      const label = document.createElement('label');
      label.className = 'cv-chip';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = english;
      box.className = 'size-3.5 accent-[var(--color-brick)]';
      box.addEventListener('change', () => {
        if (box.checked) {
          keepWords.add(token);
          convertWords.delete(token);
        } else {
          convertWords.add(token);
          keepWords.delete(token);
        }
        lastConverted = null;
        flush();
      });
      const word = document.createElement('span');
      word.textContent = token;
      const deva = document.createElement('span');
      deva.className = 'cv-chip-hi';
      deva.lang = 'hi';
      deva.textContent = `→ ${hindi}`;
      label.append(box, word, deva);
      return label;
    }

    function renderWords() {
      if (!wordsPanel) return;
      const report =
        keepEnglish.checked && input.value
          ? englishReport(input.value, from, { keepWords, convertWords, candidates, cut055: cut055Box?.checked })
          : [];
      const kept = report.filter((r) => r.english);
      const maybeEnglish = report.filter((r) => !r.english);
      const fill_ = (role: string, list: typeof report) => {
        const box = q<HTMLElement>(role);
        box.replaceChildren(...list.map((r) => chip(r.token, r.hindi, r.english)));
        q<HTMLElement>(`${role}-wrap`).hidden = list.length === 0;
      };
      fill_('words-kept', kept);
      fill_('words-maybe', maybeEnglish);
      wordsPanel.hidden = report.length === 0;
      if (report.length) askCandidates();
    }

    const unicodeText = () => {
      try {
        return convert(input.value, from, 'unicode', {
          keepEnglish: keepEnglish.checked,
          keepWords,
          convertWords,
          cut055: cut055Box?.checked,
        });
      } catch (err) {
        console.error(err);
        return '';
      }
    };

    // ----------------------------------------------------------------------
    // Conversion, debounced
    // ----------------------------------------------------------------------
    //
    // The expensive part is not the conversion. Measured on a 14,000-character
    // document, convert() is around 3ms; what actually stalls typing is writing
    // output.value, because the browser then re-shapes and re-lays-out a whole
    // textarea of Devanagari in a webfont on every keystroke.
    //
    // So: debounce the write, keep the character count synchronous so the box
    // still feels live, skip the write entirely when nothing changed, and move
    // the WhatsApp href (a second conversion plus an encodeURIComponent over
    // the whole text, both of which ran per keystroke) to the click.

    let pending: ReturnType<typeof setTimeout> | undefined;
    let lastConverted: string | null = null;

    function convertNow() {
      const text = input.value;
      // Re-running on identical text is pure waste, and blur/change events
      // fire plenty of those.
      if (text === lastConverted) return;
      lastConverted = text;

      let result = '';
      try {
        result = convert(text, from, to, {
          keepEnglish: keepEnglish.checked,
          keepWords,
          convertWords,
          cut055: cut055Box?.checked,
        });
      } catch (err) {
        console.error(err);
        say(L.conversionFailed);
      }
      // The one line worth guarding: assigning to a textarea's value re-shapes
      // the whole document even when the string is identical.
      if (output.value !== result) {
        output.value = result;
        countOut.textContent = String(result.length);
      }
      showHint(text);
      if (unmapped) {
        // unmappedChars() reads Unicode. A legacy source is keys, not Hindi,
        // so it is checked by what those keys mean.
        const hindi = FONTS[from]?.kind === 'legacy' ? unicodeText() : text;
        unmapped.hidden =
          unmappedChars(hindi, to, { keepEnglish: keepEnglish.checked }).length === 0;
      }
      whatsapp.setAttribute('aria-disabled', result ? 'false' : 'true');
      renderWords();
    }

    /** Cheap, synchronous, every keystroke. */
    function tick() {
      countIn.textContent = String(input.value.length);
      clearTimeout(pending);
      pending = setTimeout(convertNow, DEBOUNCE_MS);
    }

    /** Skip the wait when the answer is needed right now. */
    function flush() {
      clearTimeout(pending);
      convertNow();
    }

    input.addEventListener('input', tick);
    // A setting change is not typing: apply it immediately.
    keepEnglish.addEventListener('change', () => {
      lastConverted = null;
      flush();
    });
    cut055Box?.addEventListener('change', () => {
      lastConverted = null;
      flush();
    });

    // ----------------------------------------------------------------------
    // Preview toggle: one attribute, nothing else
    // ----------------------------------------------------------------------
    //
    // No font-family is written from JavaScript and no conversion re-runs. The
    // stylesheet reads [data-view] off the root. Keep it that way: the moment
    // the visible glyphs influence what lands on the clipboard, the two-button
    // design is broken.
    if (viewGroup) {
      const buttons = viewGroup.querySelectorAll<HTMLButtonElement>('[data-view]');
      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          for (const other of buttons) {
            other.setAttribute('aria-pressed', String(other === btn));
          }
          root.dataset.view = btn.dataset.view!;
        });
      }

      // If the face resolves to nothing, say so once instead of leaving the
      // user staring at ASCII in "Preview (Hindi)" mode wondering what broke.
      // load(), not check(): check() only reports faces already downloaded.
      (async () => {
        const font = previewFontFor(to);
        if (!font) return;
        try {
          if (!document.fonts?.load) return;
          const faces = await document.fonts.load(`16px "${font.family}"`);
          if (faces.some((f) => f.status === 'loaded')) return;
          const note = document.createElement('span');
          note.className = 'cv-count';
          note.textContent = fill(L.fontMissing, { font: font.label });
          viewGroup.after(note);
        } catch {
          // No FontFaceSet, or a browser that throws on an unknown family.
          // Say nothing rather than claim a font is missing on a failed probe.
        }
      })();
    }

    // ----------------------------------------------------------------------
    // Copy / download. None of this reads the preview state.
    // ----------------------------------------------------------------------

    /** One clipboard path for every button, with the insecure-context fallback. */
    async function writeClipboard(text: string) {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Clipboard API needs a secure context; a scratch textarea always works.
        // Not output.select(): that would only ever copy the raw keys.
        const scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.setAttribute('readonly', '');
        scratch.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
        document.body.append(scratch);
        scratch.select();
        try {
          if (!document.execCommand('copy')) throw new Error('Clipboard copy was rejected');
        } finally {
          scratch.remove();
        }
      }
    }

    /** Wire a copy button: confirm on the button itself, announce for screen readers. */
    function wireCopy(role: string, text: () => string) {
      const btn = maybe<HTMLButtonElement>(role);
      if (!btn) return;
      const label = btn.querySelector<HTMLElement>('[data-label]')!;
      const original = label.textContent!;
      let reset: ReturnType<typeof setTimeout> | undefined;

      btn.addEventListener('click', async () => {
        flush();
        const value = text();
        if (!value) return say(L.nothingToCopy);
        try {
          await writeClipboard(value);
        } catch {
          return say(L.copyFailed);
        }
        // Which button on which converter: never the text itself.
        track('copy_text', { from, to, box: role });

        label.textContent = L.copied;
        btn.dataset.copied = 'true';
        say(L.copiedToClipboard);
        toast(L.copiedToast);
        clearTimeout(reset);
        reset = setTimeout(() => {
          label.textContent = original;
          delete btn.dataset.copied;
        }, 1600);
      });
    }

    // Always the raw string in the box: legacy keys on a Kruti page, Unicode on
    // a Mangal page. Unaffected by the Preview/Raw toggle.
    wireCopy('copy-raw', () => output.value);
    // Always Unicode, whichever view is showing.
    wireCopy('copy-unicode', unicodeText);

    /** Shared .docx path. `text` is resolved at click time, never from the DOM font. */
    function wireDocx(role: string, text: () => string, fontName: string, suffix = '') {
      maybe<HTMLButtonElement>(role)?.addEventListener('click', async (e) => {
        flush();
        const body = text();
        if (!body) return say(L.nothingToDownload);
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        try {
          // Dynamic import: the zip library never touches the initial bundle.
          const { downloadDocx } = await import('../lib/docx.js');
          downloadDocx(body, { fontName, fileName: `mykrutidev-${to}${suffix}.docx` });
          say(L.downloaded);
          track('download_word', { from, to, box: role });
        } catch (err) {
          console.error(err);
          say(L.downloadFailed);
        } finally {
          btn.disabled = false;
        }
      });
    }

    // Word resolves the real installed face name, "Kruti Dev 010", not the
    // family label "Kruti Dev".
    wireDocx(
      'docx',
      () => output.value,
      outputIsLegacy ? (previewFontFor(to)?.label ?? FONTS[to].label) : root.dataset.unicodeFont,
    );
    wireDocx('docx-unicode', unicodeText, root.dataset.unicodeFont, '-unicode');

    whatsapp.addEventListener('click', (e) => {
      flush();
      // Raw legacy keys are unreadable in WhatsApp: it has no legacy font.
      // Share the Unicode wherever the output is legacy.
      const shareable = outputIsLegacy ? unicodeText() : output.value;
      if (!shareable) {
        e.preventDefault();
        say(L.nothingToShare);
        return;
      }
      // Built here rather than on every keystroke.
      whatsapp.href = `https://wa.me/?text=${encodeURIComponent(shareable.slice(0, WHATSAPP_LIMIT))}`;
      track('share_whatsapp', { from, to });
      if (shareable.length > WHATSAPP_LIMIT) {
        say(fill(L.sharingFirst, { n: WHATSAPP_LIMIT }));
      }
    });

    q<HTMLButtonElement>('clear').addEventListener('click', () => {
      input.value = '';
      keepWords.clear();
      convertWords.clear();
      flush();
      input.focus();
    });

    q<HTMLButtonElement>('sample').addEventListener('click', (e) => {
      input.value = (e.currentTarget as HTMLElement).dataset.sample || '';
      countIn.textContent = String(input.value.length);
      flush();
    });

    // Draft, Recent and shortcuts. Before the first conversion, so a text
    // kept from the last visit is converted like one just typed.
    workspace(root, `${from}-${to}`, {
      copy: 'copy-raw',
      unicode: outputIsLegacy ? 'copy-unicode' : undefined,
    });

    tick();
    flush();
  }
</script>
