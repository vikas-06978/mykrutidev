---
import { BASE_ROWS, EXTRA_ROWS, BOTTOM_KEYS, VOWEL_MATRA } from '../lib/keyboard.js';
import { langOf, useT } from '../i18n/index.js';

/**
 * The on-screen Devanagari keyboard.
 *
 * A text box with the keys under it, laid out so both are on screen at once:
 * the text box sticks to the top of the tool, and on phones and tablets the
 * keys are just short enough to fit under it, scrolling inside themselves.
 * See src/styles/hindi-keyboard.css for the layout rules.
 *
 * Vowel keys are "smart": after a consonant they insert the matra (क + इ ->
 * कि) and show it on the cap. See keyboard.js.
 *
 * The physical keyboard is never intercepted, so anyone with a Hindi layout can
 * type straight into the box.
 */

const isVowel = (ins: string) => Object.hasOwn(VOWEL_MATRA, ins);

const { t, render } = useT(langOf(Astro.url));
// For the script: the copy button's confirmation. Text only.
const strings = { copied: t('common.copied') };
---

<div
  class="hk card"
  data-keyboard
  data-own="false"
  data-i18n={JSON.stringify(strings)}
>
  {/* ------------------- Text box + actions (sticky) ------------------- */}
  <div class="hk-top" data-role="top">
    <label for="kb-out" class="sr-only">{t('keyboard.textLabel')}</label>
    {/*
      An ordinary, fully editable textarea: arrow keys, selection, paste and
      undo all keep working. On touch screens it gets inputmode="none" while
      our keys are open, so the phone's own keyboard does not cover them.
    */}
    <textarea
      id="kb-out"
      data-role="text"
      rows="3"
      lang="hi"
      spellcheck="false"
      autocomplete="off"
      translate="no"
      placeholder={t('keyboard.placeholder')}
      class="hk-text deva"></textarea>

    <div class="hk-actions">
      <button type="button" data-role="copy" class="btn btn-primary">
        <span data-label>{t('common.copyText')}</span>
      </button>
      <button type="button" data-role="clear" class="btn btn-ghost">{t('common.clear')}</button>
      <button
        type="button"
        data-role="own"
        class="hk-own btn btn-ghost"
        aria-pressed="false"
        title={t('keyboard.useOwnTitle')}
      >
        {t('keyboard.useOwn')}
      </button>
      <button type="button" data-role="reopen" class="hk-reopen btn btn-outline">
        {t('keyboard.showKeys')}
      </button>
      <span data-role="count" class="hk-count" aria-label={t('keyboard.countAria')}>0</span>
    </div>
  </div>

  {/* ----------------------------- The keys ----------------------------- */}
  <div class="hk-pad" data-role="pad" role="group" aria-label={t('keyboard.padAria')} translate="no">
    <div class="hk-bar">
      <div data-role="layer" role="group" aria-labelledby="kb-layer" class="cv-seg">
        <span id="kb-layer" class="cv-seg-label" translate="yes">{t('keyboard.show')}</span>
        <button type="button" data-layer="base" aria-pressed="true" translate="yes">{t('keyboard.common')}</button>
        <button type="button" data-layer="extra" aria-pressed="false" translate="yes">{t('keyboard.more')}</button>
      </div>
    </div>

    {/*
      One listener on this container rather than a hundred on the caps, and a
      pointerdown that preventDefaults so the caret never leaves the textarea.
    */}
    <div class="hk-scroll" data-role="keys">
      {
        [
          { layer: 'base', rows: BASE_ROWS },
          { layer: 'extra', rows: EXTRA_ROWS },
        ].map(({ layer, rows }) => (
          <div data-layer-panel={layer} hidden={layer !== 'base'}>
            {rows.map((row) => (
              <div class="hk-row">
                <span class="hk-label" lang="hi">
                  {row.label}
                </span>
                <div class="hk-keys">
                  {row.keys.map((k) => (
                    <button
                      type="button"
                      class="hk-key"
                      data-ins={k.ins}
                      data-vowel={isVowel(k.ins) ? k.ins : undefined}
                      aria-label={k.name ?? k.ins}
                      title={k.name}
                    >
                      {k.key}
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div class="hk-bottom" data-role="bottom">
      <button type="button" class="hk-key hk-key-util hk-key-space" data-ins=" " aria-label={t('keyboard.space')}>
        {t('keyboard.space')}
      </button>
      <button type="button" class="hk-key hk-key-util" data-role="backspace" aria-label={t('keyboard.backspace')}>
        &#8592;
      </button>
      <button type="button" class="hk-key hk-key-util" data-ins="&#10;" aria-label={t('keyboard.enter')}>
        {t('keyboard.enter')}
      </button>
      {
        BOTTOM_KEYS.map((k) => (
          <button type="button" class="hk-key" data-ins={k.ins} aria-label={k.name ?? k.ins}>
            {k.key}
          </button>
        ))
      }
    </div>
  </div>

  <p class="hk-foot" set:html={render(t('keyboard.foot'))} />
</div>

<script>
  import { clusters } from '../lib/typing.js';
  import { consonantBefore, pressKey, vowelLabel, vowelName } from '../lib/keyboard.js';

  /** Phones and tablets: the keys fit under the text box and the phone keyboard is held back. */
  const NARROW = window.matchMedia('(max-width: 1023px)');
  const COARSE = window.matchMedia('(pointer: coarse)');
  const MAX_LINES = 6;

  for (const root of document.querySelectorAll<HTMLElement>('[data-keyboard]')) {
    setup(root);
  }

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;

    const text = q<HTMLTextAreaElement>('text');
    const top = q<HTMLElement>('top');
    const pad = q<HTMLElement>('pad');
    const count = q<HTMLElement>('count');
    const keys = q<HTMLElement>('keys');
    const ownBtn = q<HTMLButtonElement>('own');
    const reopenBtn = q<HTMLButtonElement>('reopen');
    const vowelKeys = [...root.querySelectorAll<HTMLButtonElement>('[data-vowel]')];
    const L: Record<string, string> = JSON.parse(root.dataset.i18n || '{}');

    let ownKeyboard = false;

    // ----------------------------------------------------------------------
    // The phone's own keyboard: held back while ours is open on a touch
    // screen, released by "Use my keyboard". A desktop never gets
    // inputmode="none" - the physical keyboard must always just work.
    // ----------------------------------------------------------------------
    function applyInputMode() {
      const holdBack = (NARROW.matches || COARSE.matches) && !ownKeyboard;
      if (holdBack) text.setAttribute('inputmode', 'none');
      else text.removeAttribute('inputmode');
    }

    function setOwnKeyboard(on: boolean) {
      ownKeyboard = on;
      root.dataset.own = String(on);
      ownBtn.setAttribute('aria-pressed', String(on));
      applyInputMode();
      // Re-focus so the change takes effect: the phone keyboard opens now, or
      // closes for ours.
      text.blur();
      text.focus();
      fit();
    }
    ownBtn.addEventListener('click', () => setOwnKeyboard(true));
    reopenBtn.addEventListener('click', () => setOwnKeyboard(false));

    // ----------------------------------------------------------------------
    // Phones and tablets: the keys stay in the page, right under the text
    // box, and are only as tall as the screen leaves room for (CSS reads the
    // text box's height from --hk-top-h). Scrolled to, text box and keys are
    // on screen together; scrolled on, the page simply moves on. They used to
    // be pinned to the bottom of the screen instead, which left an empty block
    // where they had been and covered the page below.
    // ----------------------------------------------------------------------
    function fit() {
      root.style.setProperty('--hk-top-h', `${top.getBoundingClientRect().height}px`);
    }
    window.addEventListener('resize', () => {
      // Also re-derive the input mode: a width change that happened before
      // the NARROW listener below was attached would otherwise be missed.
      applyInputMode();
      fit();
    });
    NARROW.addEventListener('change', () => {
      applyInputMode();
      fit();
    });

    /** On a phone, bring the whole tool into view: text box and keys together. */
    function bringIntoView() {
      if (!NARROW.matches || ownKeyboard) return;
      if (Math.abs(root.getBoundingClientRect().top) > 1) {
        root.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    }
    text.addEventListener('focus', bringIntoView);

    // ----------------------------------------------------------------------
    // Text box: 3 lines, grows to 6, then scrolls inside itself.
    // ----------------------------------------------------------------------
    function autoGrow() {
      const cs = getComputedStyle(text);
      const line = parseFloat(cs.lineHeight) || 30;
      const chrome =
        parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) +
        parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
      text.style.height = 'auto';
      text.style.height = `${Math.min(text.scrollHeight + 2, line * MAX_LINES + chrome)}px`;
    }

    // ----------------------------------------------------------------------
    // Smart vowels: the caps show what a tap will insert right now.
    // ----------------------------------------------------------------------
    let afterConsonant: boolean | null = null;
    function refreshVowels() {
      const now = consonantBefore(text.value, text.selectionStart);
      if (now === afterConsonant) return;
      afterConsonant = now;
      for (const k of vowelKeys) {
        const v = k.dataset.vowel!;
        k.textContent = vowelLabel(v, now);
        k.setAttribute('aria-label', vowelName(v, now));
        k.dataset.matra = String(now && vowelLabel(v, now) !== v);
      }
    }
    document.addEventListener('selectionchange', () => {
      if (document.activeElement === text) refreshVowels();
    });

    // ----------------------------------------------------------------------
    // Inserting
    // ----------------------------------------------------------------------
    function insert(ins: string) {
      const { text: next, caret } = pressKey(
        text.value,
        text.selectionStart,
        text.selectionEnd,
        ins,
      );
      if (next !== text.value) {
        // setRangeText keeps the browser's undo history closer to a real
        // keystroke than assigning .value would.
        text.setRangeText(next.slice(text.selectionStart, caret), text.selectionStart, text.selectionEnd, 'end');
      }
      text.focus();
      update();
    }

    /**
     * Delete one cluster, not one codepoint, so the on-screen and physical
     * Backspace agree: after कि both characters go.
     */
    function backspace() {
      const start = text.selectionStart;
      const end = text.selectionEnd;
      if (start !== end) {
        text.setRangeText('', start, end, 'end');
      } else if (start > 0) {
        const last = clusters(text.value.slice(0, start)).at(-1) ?? '';
        text.setRangeText('', start - last.length, start, 'end');
      }
      text.focus();
      update();
    }

    // Keep the caret in the box: without preventDefault the button takes
    // focus on pointerdown and every tap inserts at the end. It also kills the
    // native :active state, so the press is marked by hand.
    pad.addEventListener('pointerdown', (e) => {
      const cap = (e.target as Element).closest<HTMLElement>('.hk-key');
      if (!cap) return;
      e.preventDefault();
      cap.dataset.pressed = 'true';
    });
    for (const done of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
      pad.addEventListener(done, (e) => {
        (e.target as Element).closest<HTMLElement>('.hk-key')?.removeAttribute('data-pressed');
      });
    }
    pad.addEventListener('click', (e) => {
      const cap = (e.target as Element).closest<HTMLButtonElement>('.hk-key');
      if (!cap) return;
      if (cap.dataset.role === 'backspace') backspace();
      else if (cap.dataset.ins !== undefined) insert(cap.dataset.ins);
    });

    text.addEventListener('input', update);

    // ----------------------------------------------------------------------
    // Layers. "More letters" swaps the rows in place; the text box above is
    // sticky and the bottom row stays put, so nothing is pushed off screen.
    // ----------------------------------------------------------------------
    const layerButtons = root.querySelectorAll<HTMLButtonElement>('[data-role="layer"] button');
    for (const btn of layerButtons) {
      btn.addEventListener('click', () => {
        for (const other of layerButtons) {
          other.setAttribute('aria-pressed', String(other === btn));
        }
        for (const panel of keys.querySelectorAll<HTMLElement>('[data-layer-panel]')) {
          panel.hidden = panel.dataset.layerPanel !== btn.dataset.layer;
        }
      });
    }

    function update() {
      count.textContent = String(text.value.length);
      autoGrow();
      refreshVowels();
      // The text box may have grown, which leaves the keys less room.
      fit();
    }

    // ----------------------------------------------------------------------
    // Copy / clear
    // ----------------------------------------------------------------------
    async function writeClipboard(value: string) {
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const scratch = document.createElement('textarea');
        scratch.value = value;
        scratch.setAttribute('readonly', '');
        scratch.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
        document.body.append(scratch);
        scratch.select();
        try {
          document.execCommand('copy');
        } finally {
          scratch.remove();
        }
      }
    }

    const copyBtn = q<HTMLButtonElement>('copy');
    const copyLabel = copyBtn.querySelector<HTMLElement>('[data-label]')!;
    const copyOriginal = copyLabel.textContent ?? '';
    let reset: ReturnType<typeof setTimeout> | undefined;
    copyBtn.addEventListener('click', async () => {
      if (!text.value) return;
      await writeClipboard(text.value);
      copyLabel.textContent = L.copied;
      copyBtn.dataset.copied = 'true';
      clearTimeout(reset);
      reset = setTimeout(() => {
        copyLabel.textContent = copyOriginal;
        delete copyBtn.dataset.copied;
      }, 1600);
    });

    q<HTMLButtonElement>('clear').addEventListener('click', () => {
      text.value = '';
      update();
      text.focus();
    });

    applyInputMode();
    update();
  }
</script>
