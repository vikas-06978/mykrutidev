---
import { CHSL_HINDI_2026 } from '../lib/examProfiles.js';
import { PASSAGES, DURATIONS } from '../lib/passages.js';
import { LEVELS, levelText } from '../lib/lessons.js';
import { buildVerifiedUnits } from '../lib/tutor.build.js';
import { FINGERS } from '../lib/remington.js';
import { BADGES } from '../lib/habit.js';
import RemingtonKeyboard from './RemingtonKeyboard.astro';
import HandGuide from './HandGuide.astro';
import { practiceList, practiceDataUrl } from '../lib/practicePassages.build.js';
import { langOf, useT, raw } from '../i18n/index.js';

const lang = langOf(Astro.url);
const { t, render, path } = useT(lang);

/**
 * The Hindi typing tutor.
 *
 * ---------------------------------------------------------------------------
 * WHAT IS SHOWN AND WHAT IS TYPED ARE DIFFERENT STRINGS.
 *
 * The passage is Unicode Devanagari, so it renders on any machine with no font
 * to install. The keystrokes are Remington: English keys that a legacy font
 * draws as Hindi. Holding the two together is the whole job, and it is done by
 * UNITS - one akshara paired with the exact keys that type it - built at BUILD
 * time by the verified converter. See src/lib/tutor.js.
 *
 * Because of that, the conversion engine never reaches the browser. The client
 * receives finished units as JSON and imports only arithmetic.
 * ---------------------------------------------------------------------------
 */

// No legacy preview font anywhere on this page, deliberately: the passage is
// Unicode Devanagari so it renders on any machine with nothing installed, and
// the input is invisible. The Kruti Dev face is a converter-page concern.
const LEGACY = 'kruti-dev';

// Every passage, pre-split into (akshara, keystrokes). buildVerifiedUnits
// throws at build time if a passage does not align, or if it needs a key that
// is not on the keyboard this page draws - so neither can reach a visitor.
const passages = PASSAGES.map((p) => ({
  id: p.id,
  title: p.title,
  units: buildVerifiedUnits(p.text, p.id),
}));

// The lesson ladder, converted the same way. A level whose drills reached past
// the keyboard would fail the build here rather than on somebody's screen.
const levels = LEVELS.map((l, i) => ({
  id: l.id,
  n: i + 1,
  // Words by level id; lessons.js keeps its English copy, and i18n.test.js
  // checks the English column still matches it.
  name: t(`tutor.levels.${l.id}.name`),
  title: t(`tutor.levels.${l.id}.title`),
  focus: t(`tutor.levels.${l.id}.focus`),
  threshold: l.threshold,
  units: buildVerifiedUnits(levelText(l), l.id),
}));

// The free practice page's 30 passages, for the "30 passages" tab. Only their
// numbers, levels and titles are on the page; the keystrokes are one JSON file
// (practiceDataUrl), fetched when the tab is first opened.
const practice = practiceList().map((p) => ({ n: p.n, level: p.level, title: p.title, words: p.words }));
const practiceData = { url: practiceDataUrl(), count: practice.length };

// Named here rather than in the client bundle: nine short strings that would
// otherwise be a second copy of the finger table.
const fingerNames = Object.fromEntries(FINGERS.map((f) => [f.id, t(`tutor.fingers.${f.id}`)]));

// Every message the script writes, in this page's language. Text only - no
// rule below reads it.
const strings = raw(lang, 'tutor');
---

<div class="tt card" data-tutor data-state="idle" data-focused="false">
  {/* ------------------------------ Settings ----------------------------- */}
  <div class="cv-strip bg-inset tt-settings">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <div data-role="mode" role="group" aria-labelledby="tt-mode" class="cv-seg tt-mode-picker">
        <span id="tt-mode" class="sr-only">{t('tutor.mode')}</span>
        <button type="button" data-mode="lesson" aria-pressed="true">{t('tutor.lessons')}</button>
        <button type="button" data-mode="practice" aria-pressed="false">{t('tutor.practice')}</button>
        {/* Keep the same entry points in a balanced two-row picker on phones. */}
        <button type="button" data-mode="passages" aria-pressed="false">{t('tutor.passages')}</button>
        <button type="button" data-mode="daily" aria-pressed="false">{t('tutor.today')}</button>
        <button type="button" data-mode="exam" aria-pressed="false">{t('tutor.exam')}</button>
      </div>

      {/* Practice only: a lesson ends when the drill does, not on a clock. */}
      <div
        data-role="duration"
        role="group"
        aria-labelledby="tt-dur"
        class="cv-seg"
        hidden
      >
        <span id="tt-dur" class="cv-seg-label">{t('tutor.length')}</span>
        {
          DURATIONS.map((d, i) => (
            <button type="button" data-seconds={String(d.value)} aria-pressed={String(i === 0)}>
              {t(`tutor.durations.${d.value}`)}
            </button>
          ))
        }
      </div>
    </div>
    <section data-role="exam-profiles" class="tt-exams" aria-labelledby="tt-exam-choice" hidden>
      <p id="tt-exam-choice" class="cv-eyebrow">{t('tutor.examProfiles')}</p>
      <div class="tt-exam-cards" role="group" aria-labelledby="tt-exam-choice">
        <button type="button" class="tt-exam-card" data-role="exam-remington" aria-pressed="true">
          <strong>{t('tutor.examRemington')}</strong>
          <span set:html={render(t('tutor.examRemingtonMeta'))} />
        </button>
        <button type="button" class="tt-exam-card" data-role="coach-unicode" aria-pressed="false">
          <strong>{t('tutor.nativeLabel')}</strong>
          <span set:html={render(t('tutor.examUnicodeMeta'))} />
        </button>
      </div>
    </section>
    <div data-role="exam-presets" class="mt-3" hidden>
      <label class="text-sm" for="tt-preset">{t('tutor.coachPreset')}</label>
      <select id="tt-preset" data-role="exam-preset" class="mt-2 block max-w-full rounded border border-hairline bg-surface p-2 text-ink">
        <option value="custom">{t('tutor.coachCustom')}</option>
        <option value="guided">{t('tutor.coachGuided')}</option>
        <option value="strict">{t('tutor.coachStrict')}</option>
      </select>
    </div>
    <section data-role="native-profile" class="mt-3" hidden>
      <label for="tt-native-duration" class="text-sm font-medium">{t('tutor.length')}</label>
      <select id="tt-native-duration" data-role="native-duration" class="mt-2 block max-w-full rounded border border-hairline bg-surface p-2 text-ink">
        <option value={CHSL_HINDI_2026.seconds}>{t('tutor.nativeStandard')}</option>
        <option value={CHSL_HINDI_2026.eligibleSeconds}>{t('tutor.nativeEligible')}</option>
      </select>
      <p id="tt-native-help" class="mt-2 text-sm text-body" set:html={render(t('tutor.nativeInstructions'))} />
      <p class="mt-2 text-xs text-mute">{t('tutor.nativeIndependent')}</p>
    </section>
    {/*
      Today's practice: the last days, each with its passage and how far it
      got. Tap one to type that day's passage. Filled by the script; kept in
      this browser only, which the note under it says.
    */}
    <details data-role="days" class="tt-days" hidden>
      <summary class="tt-days-head">
        {t('tutor.daysHeading')} <span data-role="days-count" class="tt-days-count"></span>
      </summary>
      <ol data-role="days-list" class="tt-days-list"></ol>
      <p class="tt-days-note">{t('tutor.daysNote')}</p>
    </details>
    <div data-role="rule-controls" class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      {/*
        Off by default and stays off until asked for. A page that starts making
        noise is a page people close, and a tutor is used in offices and
        libraries as often as at home.
      */}
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {/*
          Exam rules, ON by default: corrections and highlighting are what make
          the tutor teach. Turning either off is for practising like an exam
          that allows no Backspace, or whose software shows no colours or hints.
        */}
        <label class="tt-sound" title={t('tutor.backspaceTitle')}>
          <input type="checkbox" data-role="backspace" checked class="size-4 accent-[var(--color-brick)]" />
          <span>{t('tutor.backspace')}</span>
        </label>
        <label class="tt-sound" title={t('tutor.highlightTitle')}>
          <input type="checkbox" data-role="highlight" checked class="size-4 accent-[var(--color-brick)]" />
          <span>{t('tutor.highlight')}</span>
        </label>
        <label class="tt-sound">
          <input type="checkbox" data-role="sound" class="size-4 accent-[var(--color-brick)]" />
          <span>{t('tutor.sound')}</span>
        </label>
      </div>
    </div>
    {/* Shown only while a rule is off, so nobody wonders where the hints went. */}
    <p data-role="rules-note" class="tt-mode-note" hidden></p>
    <details class="tt-help" data-role="mode-help">
      <summary>{t('tutor.practiceHelp')}</summary>
      <p data-role="mode-note" class="tt-mode-note" hidden></p>
      <p data-role="layout-note" class="mt-2 text-sm text-body">{t('tutor.layoutNote')}</p>
      <div data-role="native-source" hidden>
        <p class="mt-2 text-sm text-body" set:html={render(t('tutor.nativeTarget'))} />
        <p class="mt-2 flex flex-wrap gap-3 text-sm">
          <a href={CHSL_HINDI_2026.notice} type="application/pdf" target="_blank" rel="noopener noreferrer">{t('tutor.nativeNotice')}</a>
          <a href={CHSL_HINDI_2026.evaluation} type="application/pdf" target="_blank" rel="noopener noreferrer">{t('tutor.nativeEvaluation')}</a>
        </p>
      </div>
    </details>
  </div>

  {/* ------------------------------ Levels ------------------------------- */}
  {/*
    Rendered whole, server-side. The client only flips `data-state` on each
    chip, so the ladder is visible - and crawlable - before any JavaScript runs
    and with it turned off.
  */}
  <div data-role="levels-wrap" class="tt-levels-wrap">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <span class="cv-eyebrow">{t('tutor.lessons')}</span>
    </div>

    <div data-role="levels" class="tt-levels" role="group" aria-label={t('tutor.lessons')}>
      {
        levels.map((l, i) => (
          <button
            type="button"
            class="tt-level"
            data-level={l.id}
            data-state={i === 0 ? 'current' : 'locked'}
            aria-pressed={String(i === 0)}
          >
            <span class="tt-level-n">{l.n}</span>
            <span class="tt-level-name">{l.name}</span>
            <span class="tt-level-meta" data-role="level-meta">
              {i === 0 ? t('tutor.startHere') : t('tutor.locked')}
            </span>
          </button>
        ))
      }
    </div>

    <p data-role="level-focus" class="tt-level-focus"></p>
  </div>

  <div class="tt-session-toolbar">
    <button type="button" data-role="native-tab" class="tt-utility" hidden>{t('tutor.nativeTab')}</button>
    <button type="button" class="tt-utility tt-focus-toggle" data-role="focus-toggle" aria-pressed="false" title={t('tutor.coachFocusHint')}>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span data-role="focus-label">{t('tutor.coachFocus')}</span>
    </button>
  </div>

  {/* --------------------------- 30 passages ----------------------------- */}
  {/*
    The free practice page's passages, by level. All open: the same passages
    are free on that page and in its PDF. A finished one is ticked and can be
    typed again. Rendered whole, so the list is there before any script runs.
  */}
  <div data-role="pp-wrap" class="tt-levels-wrap" hidden>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div data-role="pp-levels" role="group" aria-label={t('tutor.passages')} class="cv-seg">
        {
          [1, 2, 3].map((n) => (
            <button type="button" data-pp-level={String(n)} aria-pressed={String(n === 1)}>
              {t('tutor.ppLevel', { n })}
            </button>
          ))
        }
      </div>
      <a class="text-xs" href={path('/hindi-typing-practice-passages')}>{t('tutor.ppAll')}</a>
    </div>
    <div class="tt-levels tt-pp" role="group" aria-label={t('tutor.passages')}>
      {
        practice.map((p) => (
          <button
            type="button"
            class="tt-level"
            data-pp={String(p.n)}
            data-pp-of={String(p.level)}
            data-state="open"
            aria-pressed="false"
            hidden={p.level !== 1}
          >
            <span class="tt-level-n">{t('tutor.ppNumber', { n: p.n, words: p.words })}</span>
            <span class="tt-level-name" lang="hi">{p.title}</span>
            <span class="tt-level-meta" data-role="pp-meta">{t('tutor.daysNone')}</span>
          </button>
        ))
      }
    </div>
  </div>

  {/* ------------------------------- Stats ------------------------------- */}
  <div class="tt-stats">
    <div class="tt-stat" data-role="stat-time">
      <span data-role="time" class="tt-stat-value">0:00</span>
      {/* "Time left" while a clock is running down, "Time" while a lesson
          counts up: a lesson ends when the drill does, not on a timer. */}
      <span data-role="time-label" class="tt-stat-label">{t('tutor.time')}</span>
    </div>
    <div class="tt-stat">
      <span data-role="wpm" class="tt-stat-value">0</span>
      <span class="tt-stat-label">{t('tutor.wpm')}</span>
    </div>
    <div class="tt-stat">
      <span data-role="accuracy" class="tt-stat-value">100%</span>
      <span class="tt-stat-label">{t('tutor.accuracy')}</span>
    </div>
    <div class="tt-stat">
      <span data-role="errors" class="tt-stat-value">0</span>
      <span class="tt-stat-label">{t('tutor.mistakes')}</span>
    </div>
  </div>

  {/* ------------------------------ Passage ------------------------------ */}
  {/*
    How far through the passage you are, which the raw "155 / 480" count never
    actually answered - on a two-hour test those are five-digit numbers and no
    one is doing that division while typing. The bar is the answer at a glance
    and the numbers stay underneath it for anyone who wants them.
  */}
  <div class="tt-progress">
    <div class="tt-progress-head">
      <span id="tt-passage-title" data-role="passage-title" class="cv-eyebrow">{t('tutor.practicePassage')}</span>

      {/*
        Pause lives HERE, not down in the controls strip.

        That strip sits below the keyboard and the hand guide, which on a phone
        is most of a screen away from the passage - so the one control you need
        WHILE typing was the one you had to go looking for. This band is already
        in the eyeline: it is directly above the text you are reading and
        directly below the clock the button acts on.

        It appears only once the clock is running, so the row is just a label
        and a count until there is something to pause.
      */}
      <button
        type="button"
        data-role="pause"
        class="tt-pause"
        title={t('tutor.pauseTitle')}
        hidden
      >
        {t('tutor.pause')}
      </button>
    </div>

    <div
      class="tt-progress-track"
      role="progressbar"
      aria-labelledby="tt-progress-label"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-role="progress-track"
    >
      <span data-role="progress-fill" class="tt-progress-fill"></span>
    </div>

    <div class="tt-progress-foot">
      <span id="tt-progress-label" data-role="progress-pct">{t('tutor.complete', { pct: 0 })}</span>
      <span class="tt-progress-rest">
        <span data-role="progress" class="cv-count">0 / 0</span>
        <span data-role="progress-left"></span>
      </span>
    </div>
  </div>

  <div class="tt-stage">
    <div class="tt-passage" data-role="passage" translate="no" tabindex="0" role="region" aria-labelledby="tt-passage-title">
      {/* Filled by the client: the passage is chosen at random per visit, so
          rendering one here would give every visitor the same paragraph. */}
      <p data-role="line" class="tt-line">
        {/* Placeholder lines until the passage is drawn - never an empty box. */}
        <span class="mkd-skel tt-skel" aria-hidden="true"></span>
        <span class="mkd-skel tt-skel" aria-hidden="true"></span>
        <span class="mkd-skel tt-skel tt-skel-short" aria-hidden="true"></span>
      </p>
    </div>

    {/*
      The real input, invisible and exactly on top. A label and a genuine
      textarea, so a tap opens the phone keyboard and a screen reader has
      something to announce - only its ink is hidden, because the passage
      underneath already draws the state.
    */}
    <label for="tt-capture" class="sr-only">{t('tutor.captureLabel')}</label>
    <textarea
      id="tt-capture"
      data-role="capture"
      class="tt-capture"
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      translate="no"
      aria-describedby="tt-prompt-text"></textarea>

    <div class="tt-veil">
      <span
        data-role="veil-text"
        class="rounded-(--radius-chrome) border border-hairline bg-surface px-4 py-2 text-sm font-medium text-ink"
      >
        {t('tutor.veil')}
      </span>
    </div>
  </div>

  {/*
    With highlighting off the passage no longer shows what was typed, so - as in
    exam software - it appears here, in Kruti Dev 010 itself.
  */}
  <div class="tt-typed-wrap" data-role="typed-wrap" hidden>
    <span class="cv-eyebrow">{t('tutor.typedLabel')}</span>
    <p class="tt-typed" data-role="typed" translate="no" aria-hidden="true"></p>
  </div>

  {/* ---------------------------- Next key ------------------------------- */}
  <div class="tt-prompt">
    <span class="tt-prompt-label">{t('tutor.press')}</span>
    <span data-role="prompt-keys" class="tt-prompt-keys" translate="no"></span>
    <span class="tt-prompt-arrow" aria-hidden="true">→</span>
    <span data-role="prompt-deva" class="tt-prompt-deva" lang="hi" translate="no"></span>
    <span id="tt-prompt-text" data-role="prompt-finger" class="tt-prompt-finger"></span>
  </div>

  {/* ---------------------------- Keyboard ------------------------------- */}
  <div class="tt-kbd-bar">
    <p class="tt-kbd-font" data-font-line set:html={render(t('print.fontLine'))} />
    {/* Phones and small tablets only: there the caps show one Hindi letter each (tutor.css). */}
    <button type="button" data-role="shift-view" class="tt-shift-view" aria-pressed="false">
      {t('tutor.shiftView')}
    </button>
  </div>
  <RemingtonKeyboard font={LEGACY} />
  <p class="tt-phone-note">{t('tutor.phoneNote')}</p>

  {/* ---------------------------- Hands ---------------------------------- */}
  <div class="border-t border-hairline bg-inset">
    <HandGuide />
  </div>

  {/* ---------------------------- Controls ------------------------------- */}
  <div class="cv-strip">
    <div class="cv-secondary">
      {/*
        Submit is the primary action once typing has started, because stopping
        early and being told how you did is the thing a practising typist
        actually wants at that moment. It is disabled until there is something
        to score, so it can never hand back a result from nothing.
      */}
      <button type="button" data-role="submit" class="btn btn-primary" disabled>
        {t('tutor.submit')}
      </button>
      <button type="button" data-role="restart" class="btn btn-ghost">{t('tutor.restart')}</button>
      <button type="button" data-role="new" class="btn btn-ghost">{t('tutor.newPassage')}</button>
      <button type="button" data-role="next-level" class="btn btn-outline" hidden>
        {t('tutor.nextLesson')}
      </button>
    </div>
  </div>

  {/* ----------------------------- Result -------------------------------- */}
  <div data-role="result" hidden class="tt-result" role="status">
    <h3 class="text-xl" data-role="result-title">{t('tutor.testComplete')}</h3>
    <p class="mt-1 text-sm text-body" data-role="result-note"></p>

    <p data-role="native-grade" class="mt-3 text-body" hidden></p>
    <div class="tt-result-grid">
      <div class="tt-result-cell">
        <span data-role="r-wpm" class="tt-stat-value">0</span>
        <span class="tt-stat-label">{t('tutor.netWpm')}</span>
      </div>
      <div class="tt-result-cell">
        <span data-role="r-gross" class="tt-stat-value">0</span>
        <span class="tt-stat-label">{t('tutor.grossWpm')}</span>
      </div>
      <div class="tt-result-cell">
        <span data-role="r-acc" class="tt-stat-value">0%</span>
        <span class="tt-stat-label">{t('tutor.accuracy')}</span>
      </div>
      <div class="tt-result-cell">
        <span data-role="r-err" class="tt-stat-value">0</span>
        <span class="tt-stat-label">{t('tutor.mistakes')}</span>
      </div>
    </div>

    <div data-role="missed-wrap" hidden class="mt-4">
      <p class="text-xs font-semibold tracking-wide text-mute uppercase">{t('tutor.missedMost')}</p>
      <div data-role="missed" class="kb-hints mt-2" translate="no"></div>
    </div>

    <section data-role="coach-panel" class="mt-4" aria-labelledby="tt-coach-title">
      <h4 id="tt-coach-title" class="font-medium">{t('tutor.coachTitle')}</h4>
      <p data-role="coach-advice" class="mt-2 text-sm text-body"></p>
      <ol data-role="coach-explanations" class="mt-2 space-y-2 text-sm text-body"></ol>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline" data-role="coach-drill" hidden>{t('tutor.coachDrill')}</button>
        <button type="button" class="btn btn-outline" data-role="coach-next">{t('tutor.coachNext')}</button>
      </div>
      <p class="mt-2 text-xs text-mute">{t('tutor.coachSession')}</p>
    </section>
    {/* An image of the result, shared through the phone's own share sheet
        (WhatsApp is one tap away there) or downloaded where there is none. */}
    <button type="button" data-role="share" class="btn btn-outline mt-4 gap-2" hidden>
      <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0">
        <path
          d="M14 6.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5zM6 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5zM14 18a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5zM8 11.1l4 2.3M12 5.6 8 7.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      {t('tutor.share')}
    </button>
  </div>

  <p class="cv-strip bg-surface text-xs leading-relaxed text-mute">
    <span class="font-medium text-body">{t('tutor.privacyStrong')}</span>
    {t('tutor.privacyBody')}
  </p>
</div>

{/* ---------------------------- Your progress ---------------------------- */}
{/*
  Rendered whole with placeholder values ("–") and a fixed-height chart box,
  then filled from this device's storage: the panel is the same size before
  and after the script runs, so nothing below it moves (CLS 0).
*/}
<section class="tt-me card" data-tutor-progress aria-labelledby="tt-me-h">
  <div class="tt-me-head">
    <h2 id="tt-me-h" class="text-lg">{t('tutor.pTitle')}</h2>
    <p class="text-xs text-mute">{t('tutor.pDevice')}</p>
  </div>

  <div class="tt-me-streak">
    <span class="tt-me-flame" aria-hidden="true">
      <svg viewBox="0 0 20 20" class="size-6">
        <path
          d="M10 18c3.3 0 5.5-2.3 5.5-5.4 0-3.3-2.6-5.2-3.4-8.6-.2-.8-1.1-1.1-1.6-.4C9 5.6 9.4 8 8.6 8.6c-.6.4-1.3-.4-1.4-1.3-.1-.7-.9-1-1.4-.4-.8 1.2-1.3 2.9-1.3 4.6C4.5 15.7 6.7 18 10 18z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span>
      <span class="tt-me-streak-n"><span data-p="streak" class="mkd-skel-text">–</span> <span class="text-sm font-normal text-body">{t('tutor.pStreak')}</span></span>
      <span data-p="streak-note" class="block text-xs text-mute">{t('tutor.pStreakStart')}</span>
    </span>
  </div>

  <dl class="tt-me-stats">
    <div class="tt-me-stat"><dt>{t('tutor.pBest')}</dt><dd data-p="best">–</dd></div>
    <div class="tt-me-stat"><dt>{t('tutor.pAcc')}</dt><dd data-p="acc">–</dd></div>
    <div class="tt-me-stat"><dt>{t('tutor.pLessons')}</dt><dd data-p="lessons">–</dd></div>
    <div class="tt-me-stat"><dt>{t('tutor.pMinutes')}</dt><dd data-p="minutes">–</dd></div>
  </dl>

  <figure class="tt-chart">
    <figcaption class="cv-eyebrow" data-p="chart-title">{t('tutor.pChartTitle', { n: 30 })}</figcaption>
    <div class="tt-chart-box" data-p="chart">
      <p data-p="chart-empty" class="tt-chart-empty">{t('tutor.pChartEmpty')}</p>
    </div>
  </figure>

  <div class="tt-me-badges">
    <span class="cv-eyebrow">{t('tutor.pBadges')}</span>
    <ul class="tt-badges">
      {
        BADGES.map(({ id }) => (
          <li class="tt-badge" data-badge={id} data-earned="false" title={t('tutor.badgeLocked')}>
            <span class="tt-badge-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="size-4">
                <path d="M10 2.5l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 7.8l5-.7z" fill="currentColor" />
              </svg>
            </span>
            <span>{t(`tutor.badges.${id}`)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="tt-me-foot">
    <button type="button" data-role="reset-progress" class="tt-reset">{t('tutor.resetProgress')}</button>
  </div>
</section>

<script
  type="application/json"
  data-tutor-passages
  set:html={JSON.stringify(passages)}
/>
<script type="application/json" data-tutor-pp set:html={JSON.stringify(practiceData)} />
<script type="application/json" data-tutor-levels set:html={JSON.stringify(levels)} />
<script type="application/json" data-tutor-fingers set:html={JSON.stringify(fingerNames)} />
<script type="application/json" data-tutor-i18n set:html={JSON.stringify(strings)} />

<script>
  import { CHSL_HINDI_2026, evaluateHindiPractice } from '../lib/examProfiles.js';
  import { mistakeUnits, targetedDrill, nextPractice } from '../lib/tutorCoaching.js';
  import { clusters, clusterStates, formatClock } from '../lib/typing.js';
  import {
    unitsToKeys,
    unitsToText,
    unitKeyRuns,
    nextKey,
    missedKeys,
    summarise,
  } from '../lib/tutor.js';
  import { locate } from '../lib/remington.js';
  import { planPassages, JOINER, DURATIONS } from '../lib/passages.js';
  import { fill } from '../i18n/fill.js';
  import { dailyIndex, dayKey, lastDays } from '../lib/habit.js';
  import { progressPanel, shareResult } from '../scripts/progress.js';
  import { track } from '../scripts/track.js';
  import { readTutorDraft, recoveredTime, DRAFT_LIMIT } from '../lib/tutorSession.js';

  type Unit = { deva: string; keys: string };
  type Passage = { id: string; title: string; units: Unit[] };
  type Level = {
    id: string;
    n: number;
    name: string;
    title: string;
    focus: string;
    threshold: number;
    units: Unit[];
  };
  /**
   * lesson: the ladder. practice: a timed test of the chosen length.
   * daily: "Today's practice", one passage per date, the same for everyone.
   * exam: independent 10-minute practice with no pause; not an official exam replica.
   * passages: one of the free practice page's 30 passages, picked by the
   * typist; the clock counts up and stops when the passage is typed.
   */
  type Mode = 'lesson' | 'practice' | 'daily' | 'exam' | 'passages' | 'targeted' | 'unicode';
  type Practice = { n: number; units: Unit[] };
  /** Best try at each of the 30 passages, by number. This browser only. */
  type PracticeRecord = Record<string, { pct: number; wpm: number; acc: number }>;
  const EXAM_SECONDS = 600;

  /** Live stats tick. Fast enough to feel continuous, cheap enough to be free. */
  const TICK_MS = 200;
  /** How long a key cap stays flashed after a press. */
  const FLASH_MS = 120;

  /**
   * How much of the passage is put in the DOM at once, and how close the caret
   * may get to the end of what is rendered before more is added.
   *
   * ---------------------------------------------------------------------------
   * WHY THE PASSAGE IS NOT RENDERED IN ONE GO
   *
   * Every akshara is its own <span>, which is what lets a matra stay attached
   * to its consonant while the two are coloured separately. That is fine for a
   * lesson drill of 200 aksharas and fine for a 15-minute test. A two-hour test
   * queues ~36,000 keystrokes, which is ~24,000 spans - enough to cost a
   * noticeable freeze before the first keystroke on the mid-range Android this
   * site is mostly used from, and to hold memory nobody needs.
   *
   * So the passage is built a chunk at a time and extended as the caret
   * approaches the end of what exists. Nothing else changes: `expected` and
   * `runs` are always the whole test, because the score is over the whole test.
   * Only the drawing is lazy.
   *
   * A chunk is far more than one screen, so extending never happens mid-glance,
   * and the lookahead is wide enough that the work lands long before the caret
   * could reach it.
   * ---------------------------------------------------------------------------
   */
  const CHUNK_UNITS = 900;
  const LOOKAHEAD_UNITS = 300;

  const BEST_KEY = 'mykrutidev:best-wpm';
  const PROGRESS_KEY = 'mykrutidev:tutor';
  const SOUND_KEY = 'mykrutidev:tutor-sound';
  /** Stored only as 'off': a visitor who never touched them gets them on. */
  const BACKSPACE_KEY = 'mykrutidev:tutor-backspace';
  const HIGHLIGHT_KEY = 'mykrutidev:tutor-highlight';
  const PRACTICE_KEY = 'mykrutidev:tutor-passages';

  const read = (sel: string) => {
    const el = document.querySelector<HTMLElement>(sel);
    try {
      return el ? JSON.parse(el.textContent || 'null') : null;
    } catch {
      return null;
    }
  };

  const PASSAGES: Passage[] = read('[data-tutor-passages]') ?? [];
  const LEVELS: Level[] = read('[data-tutor-levels]') ?? [];
  const PP: { url: string; count: number } = read('[data-tutor-pp]') ?? { url: '', count: 0 };
  const FINGER_NAMES: Record<string, string> = read('[data-tutor-fingers]') ?? {};
  /** The page's words. Text only: nothing below decides anything from it. */
  const L: Record<string, string> = read('[data-tutor-i18n]') ?? {};

  for (const root of document.querySelectorAll<HTMLElement>('[data-tutor]')) {
    if (PASSAGES.length > 0 && LEVELS.length > 0) setup(root);
  }

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;

    const capture = q<HTMLTextAreaElement>('capture');
    const passage = q<HTMLElement>('passage');
    const lineEl = q<HTMLElement>('line');
    const titleEl = q<HTMLElement>('passage-title');
    const progressEl = q<HTMLElement>('progress');
    const result = q<HTMLElement>('result');

    const timeEl = q<HTMLElement>('time');
    const statTime = q<HTMLElement>('stat-time');
    const wpmEl = q<HTMLElement>('wpm');
    const accEl = q<HTMLElement>('accuracy');
    const errEl = q<HTMLElement>('errors');

    const promptKeys = q<HTMLElement>('prompt-keys');
    const promptDeva = q<HTMLElement>('prompt-deva');
    const promptFinger = q<HTMLElement>('prompt-finger');

    const board = root.querySelector<HTMLElement>('[data-keyboard]')!;
    const shiftView = q<HTMLButtonElement>('shift-view');
    // Keep the typing box focused, so a phone's keyboard stays up.
    shiftView.addEventListener('pointerdown', (e) => e.preventDefault());
    shiftView.addEventListener('click', () => {
      const on = shiftView.getAttribute('aria-pressed') !== 'true';
      shiftView.setAttribute('aria-pressed', String(on));
      board.dataset.shifted = String(on);
    });
    const caps = new Map<string, HTMLElement>();
    const shiftCaps: HTMLElement[] = [];
    for (const cap of board.querySelectorAll<HTMLElement>('.kbd-cap')) {
      if (cap.dataset.cap !== undefined) caps.set(cap.dataset.cap, cap);
      if (cap.dataset.mod === 'shift') shiftCaps.push(cap);
    }

    /**
     * Finger shapes, grouped by id. `thumb` has two - one per hand - because
     * either thumb presses space and naming one would be inventing a rule.
     */
    const fingerShapes = new Map<string, SVGElement[]>();
    for (const shape of root.querySelectorAll<SVGElement>('[data-hands] [data-finger]')) {
      const id = shape.dataset.finger!;
      if (!fingerShapes.has(id)) fingerShapes.set(id, []);
      fingerShapes.get(id)!.push(shape);
    }

    const progressTrack = q<HTMLElement>('progress-track');
    const progressFill = q<HTMLElement>('progress-fill');
    const progressPct = q<HTMLElement>('progress-pct');
    const progressLeft = q<HTMLElement>('progress-left');
    const veilText = q<HTMLElement>('veil-text');
    const pauseBtn = q<HTMLButtonElement>('pause');

    const timeLabel = q<HTMLElement>('time-label');
    const levelsWrap = q<HTMLElement>('levels-wrap');
    const levelFocus = q<HTMLElement>('level-focus');
    const nextLevelBtn = q<HTMLButtonElement>('next-level');
    const newBtn = q<HTMLButtonElement>('new');
    const submitBtn = q<HTMLButtonElement>('submit');
    const durationGroup = q<HTMLElement>('duration');
    const modeNote = q<HTMLElement>('mode-note');

    const levelChips = new Map<string, HTMLButtonElement>();
    for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-level]')) {
      levelChips.set(chip.dataset.level!, chip);
    }

    let nativeSeconds: number = CHSL_HINDI_2026.seconds;
    let coachingUnits: Unit[] = [];
    let recommendedLevel = LEVELS[0].id;
    let mode: Mode = 'lesson';
    let examMode: 'exam' | 'unicode' = 'exam';
    /** Today's practice: whose date's passage is on screen (today, or one picked from the list). */
    let dailyDay = dayKey();
    let levelId = LEVELS[0].id;
    /** 30 passages: the one being typed (0 until one is chosen) and the level shown. */
    let ppN = 0;
    let ppLevel = 1;
    /** Their keystrokes, fetched the first time the tab is opened. */
    let ppData: Practice[] | null = null;
    let ppLoading = false;
    let ppFailed = false;
    let keepRestoredPassage = false;
    let seconds = DURATIONS[0].value;
    /** The two modes that run on a clock and end when it runs out. */
    const timed = () => mode === 'practice' || mode === 'exam' || mode === 'unicode';
    const testSeconds = () => (mode === 'unicode' ? nativeSeconds : mode === 'exam' ? EXAM_SECONDS : seconds);

    /** The lesson: aksharas to read, keystrokes to press. */
    let units: Unit[] = [];
    let runs: string[] = [];
    let expected = '';

    /** One span per akshara, so a keystroke touches only what changed. */
    let spans: HTMLElement[] = [];
    let lastStates: string[] = [];
    /** How many units are currently drawn, and their runs, sliced once. */
    let rendered = 0;
    let renderedRuns: string[] = [];

    /**
     * The clock is kept as SEGMENTS rather than a start time, because it can
     * now be stopped. `accumulated` is every millisecond already counted and
     * `segmentStart` is when the running stretch began; a pause closes the
     * segment and a resume opens a new one. Storing a single startedAt and
     * subtracting would hand back the time spent paused, which is the whole
     * thing a pause button exists to prevent.
     */
    let accumulated = 0;
    let segmentStart = 0;
    let ticker: ReturnType<typeof setInterval> | undefined;
    let running = false;
    let paused = false;
    let done = false;
    const sessionKey = `mykrutidev:tutor-draft:${location.pathname.replace(/\/+$/, '')}`;
    let restoring = true;
    let pendingDraft: ReturnType<typeof readTutorDraft> = null;
    try {
      if ((performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming)?.type === 'reload') {
        pendingDraft = readTutorDraft(sessionStorage.getItem(sessionKey));
      }
    } catch { /* Recovery is optional when storage is blocked. */ }

    // ----------------------------------------------------------------------
    // localStorage, which may throw or lie
    // ----------------------------------------------------------------------
    function readBest(): number {
      try {
        const raw = localStorage.getItem(BEST_KEY);
        const n = raw === null ? 0 : Number(JSON.parse(raw));
        return Number.isFinite(n) && n >= 0 && n < 1000 ? n : 0;
      } catch {
        return 0;
      }
    }

    function writeBest(n: number) {
      try {
        localStorage.setItem(BEST_KEY, JSON.stringify(Math.round(n)));
      } catch {
        // Private window, blocked storage, full quota. The tutor still works.
      }
    }

    type Progress = { done: string[]; best: Record<string, number> };

    /**
     * Lesson progress, validated on the way in.
     *
     * Anything could be under this key - an older shape of this feature, a
     * different site on the same origin during development, or a person who
     * edited it. Every field is checked against the levels that actually
     * exist, so a stale id cannot unlock a level or crash the picker.
     */
    function readProgress(): Progress {
      const empty: Progress = { done: [], best: {} };
      try {
        const raw = localStorage.getItem(PROGRESS_KEY);
        if (!raw) return empty;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return empty;

        const ids = new Set(LEVELS.map((l) => l.id));
        const done = Array.isArray(parsed.done)
          ? [...new Set(parsed.done.filter((id: unknown) => typeof id === 'string' && ids.has(id)))]
          : [];

        const best: Record<string, number> = {};
        if (parsed.best && typeof parsed.best === 'object') {
          for (const [id, v] of Object.entries(parsed.best)) {
            const n = Number(v);
            if (ids.has(id) && Number.isFinite(n) && n >= 0 && n < 1000) best[id] = n;
          }
        }
        return { done, best };
      } catch {
        return empty;
      }
    }

    function writeProgress(p: Progress) {
      try {
        localStorage.setItem(PROGRESS_KEY, JSON.stringify(p));
      } catch {
        // The ladder still works for this session; it just will not be
        // remembered. Not worth interrupting anyone over.
      }
    }

    let progress = readProgress();

    // "Your progress": streak, minutes, chart, badges (src/scripts/progress.js).
    const me = progressPanel(document.querySelector<HTMLElement>('[data-tutor-progress]'), L);
    const ctx = () => ({
      lessonsDone: progress.done.length,
      lessonsTotal: LEVELS.length,
      legacyBest: Math.max(readBest(), ...Object.values(progress.best).map(Math.round)),
    });
    const shareBtn = q<HTMLButtonElement>('share');
    let lastResult = { wpm: 0, acc: 0 };

    /** The first level is always open; each other needs the one before it. */
    function unlocked(id: string) {
      const i = LEVELS.findIndex((l) => l.id === id);
      if (i <= 0) return i === 0;
      return progress.done.includes(LEVELS[i - 1].id);
    }

    const levelOf = (id: string) => LEVELS.find((l) => l.id === id)!;

    // ----------------------------------------------------------------------
    // Building a lesson
    // ----------------------------------------------------------------------

    function buildLesson() {
      if (mode === 'unicode') {
        const text = PASSAGES.map(p => unitsToText(p.units)).join(' ').split(/\s+/u).slice(0, 300).join(' ');
        units = clusters(text).map(deva => ({ deva, keys: deva }));
        titleEl.textContent = L.nativeLabel;
      } else if (mode === 'targeted') {
        units = coachingUnits;
        titleEl.textContent = L.coachDrill;
      } else if (mode === 'lesson') {
        const level = levelOf(levelId);
        units = level.units;
        titleEl.textContent = level.title;
        levelFocus.textContent = level.focus;
      } else if (mode === 'passages') {
        const p = ppData!.find((x) => x.n === ppN) ?? ppData![0];
        units = p.units;
        titleEl.textContent = fill(L.ppTitle, { n: p.n, title: ppTitleOf(p.n) });
      } else if (mode === 'daily') {
        // By the visitor's own calendar date: everyone typing on the 26th
        // gets the same passage, and it changes at their midnight. A past
        // day picked from the list brings back that day's passage.
        const p = PASSAGES[dailyIndex(dailyDay, PASSAGES.length)];
        units = p.units;
        titleEl.textContent =
          dailyDay === dayKey()
            ? fill(L.todayTitle, { title: p.title })
            : fill(L.dayTitle, { date: dateLabel(dailyDay), title: p.title });
      } else {
        // Sized in KEYSTROKES, not aksharas. They are not the same count - भा
        // is one akshara and three keys - and the clock is spent on keystrokes.
        const order = planPassages(
          testSeconds(),
          PASSAGES.map((p) => p.units.reduce((n, u) => n + u.keys.length, 0)),
        );

        units = [];
        order.forEach((i, n) => {
          if (n > 0) units.push({ deva: JOINER, keys: JOINER });
          units.push(...PASSAGES[i].units);
        });

        titleEl.textContent =
          order.length === 1
            ? PASSAGES[order[0]].title
            : fill(L.moreTitles, { title: PASSAGES[order[0]].title, n: order.length - 1 });
      }

      runs = unitKeyRuns(units);
      expected = unitsToKeys(units);
    }

    /**
     * Repaint the level picker from the stored progress.
     *
     * Four states, and the distinction that matters is `locked` versus the
     * rest: a locked chip is not a link to somewhere you cannot go, it is
     * disabled, so nobody tabs into a dead end.
     */
    function renderLevels() {
      for (const level of LEVELS) {
        const chip = levelChips.get(level.id)!;
        const open = unlocked(level.id);
        const done = progress.done.includes(level.id);
        const current = mode === 'lesson' && level.id === levelId;

        chip.dataset.state = current ? 'current' : done ? 'done' : open ? 'open' : 'locked';
        chip.disabled = !open;
        chip.setAttribute('aria-pressed', String(current));

        const meta = chip.querySelector<HTMLElement>('[data-role="level-meta"]')!;
        const best = progress.best[level.id];
        if (!open) meta.textContent = L.locked;
        else if (best) meta.textContent = fill(L.best, { n: Math.round(best) });
        else if (done) meta.textContent = L.done;
        else meta.textContent = level.n === 1 ? L.startHere : L.open;
      }
    }

    /**
     * Render the passage once, as one span per akshara.
     *
     * Rebuilt only when the passage changes. On a keystroke only the spans
     * whose state changed are touched - rewriting a thousand spans per
     * character is what makes a tutor feel like treacle at speed.
     */
    function renderPassage() {
      lineEl.textContent = '';
      spans = [];
      lastStates = [];
      rendered = 0;
      renderedRuns = [];
      extendTo(CHUNK_UNITS);
      paint('');
    }

    /**
     * Draw up to `n` units, appending to whatever is already there.
     *
     * One fragment and one append per chunk: appending each span to a live
     * element is what makes building a long passage slow, and it is the whole
     * reason this is chunked in the first place.
     */
    function extendTo(n: number) {
      const target = Math.min(units.length, n);
      if (target <= rendered) return;

      const frag = document.createDocumentFragment();
      for (let i = rendered; i < target; i++) {
        const u = units[i];
        const span = document.createElement('span');
        span.className = 'tt-c';
        span.dataset.s = 'pending';
        if (/^\s+$/.test(u.deva)) span.dataset.ws = '';
        span.textContent = u.deva;
        frag.append(span);
        spans.push(span);
        lastStates.push('pending');
      }
      lineEl.append(frag);
      rendered = target;
      // Sliced here rather than per keystroke: it only changes when a chunk is
      // added, and clusterStates() is called on every character typed.
      renderedRuns = runs.slice(0, rendered);
    }

    // Reading ahead never moves the typing caret or the clock. Long tests
    // reveal the next chunk as the reader approaches the current end.
    passage.addEventListener('scroll', () => {
      if (passage.scrollTop + passage.clientHeight >= passage.scrollHeight - 100) {
        extendTo(rendered + CHUNK_UNITS);
      }
    }, { passive: true });

    function paint(typed: string) {
      // Extend before painting, so the caret always has a span to land on.
      if (rendered < units.length) {
        const caret = unitIndexFor(typed.length);
        if (caret + LOOKAHEAD_UNITS > rendered) extendTo(caret + CHUNK_UNITS);
      }

      // The target stays whole - only the cluster list is short, so the states
      // that come back are exactly the spans that exist. Everything past the
      // end of it is unrendered and therefore untyped, which is 'pending'.
      const states = clusterStates(expected, typed, renderedRuns);
      let current: HTMLElement | null = null;

      for (let i = 0; i < states.length; i++) {
        if (states[i] !== lastStates[i]) {
          spans[i].dataset.s = states[i];
          lastStates[i] = states[i];
        }
        if (states[i] === 'current') current = spans[i];
      }

      keepInView(current);
    }

    /**
     * Scroll the caret into view inside the passage panel only.
     *
     * Not scrollIntoView(): that walks up to the document and scrolls the whole
     * page, pulling the keyboard out from under the eyes that are using it.
     */
    function keepInView(el: HTMLElement | null) {
      if (!el) return;
      const box = passage.getBoundingClientRect();
      const line = el.getBoundingClientRect();
      const pad = 28;
      if (line.bottom > box.bottom - pad) {
        passage.scrollTop += line.bottom - box.bottom + pad;
      } else if (line.top < box.top + pad) {
        passage.scrollTop -= box.top + pad - line.top;
      }
    }

    // ----------------------------------------------------------------------
    // The next key
    // ----------------------------------------------------------------------

    let litCap: HTMLElement | null = null;
    let litShift: HTMLElement[] = [];
    let litFingers: SVGElement[] = [];

    /** Colour a finger on both hands' worth of shapes for that id. */
    function lightFinger(id: string, how: 'true' | 'hold') {
      for (const shape of fingerShapes.get(id) ?? []) {
        shape.dataset.active = how;
        litFingers.push(shape);
      }
    }

    function showNextKey(typed: string) {
      const ch = nextKey(expected, typed);

      // Clear whatever was lit, before working out what is lit now.
      litCap?.removeAttribute('data-next');
      litCap?.removeAttribute('data-show');
      for (const s of litShift) s.removeAttribute('data-next');
      for (const f of litFingers) f.removeAttribute('data-active');
      litCap = null;
      litShift = [];
      litFingers = [];

      // Highlighting off: no key, no finger, no Hindi glyph to aim for.
      if (mode === 'unicode' || !highlightOn()) {
        promptKeys.textContent = '';
        promptDeva.textContent = '';
        promptFinger.textContent = ch ? L.highlightOffPrompt : L.finished;
        return;
      }

      if (!ch) {
        promptKeys.textContent = '';
        promptDeva.textContent = '';
        promptFinger.textContent = L.finished;
        return;
      }

      const at = locate(ch);
      const unitIndex = unitIndexFor(typed.length);
      const deva = units[unitIndex]?.deva ?? '';

      // The prompt: the key or keys to press, drawn as keys.
      promptKeys.textContent = '';
      if (at?.shift) {
        promptKeys.append(kbd('Shift'), plus(), kbd(at.cap));
      } else {
        promptKeys.append(kbd(ch === ' ' ? 'Space' : ch));
      }

      promptDeva.textContent = deva;

      if (at) {
        const name = FINGER_NAMES[at.finger] ?? '';
        promptFinger.textContent = '';
        const strong = document.createElement('strong');
        strong.textContent = name;
        promptFinger.append(L.withYour, strong);
        if (at.shift) {
          const other = FINGER_NAMES[at.shiftFinger] ?? '';
          promptFinger.append(fill(L.holdingShift, { finger: other.toLowerCase() }));
        }

        // Light the board and the hand from the same lookup, so the cap and
        // the finger can never point at different things.
        const cap = caps.get(at.cap);
        if (cap) {
          cap.dataset.next = 'true';
          // On a phone a cap shows one Hindi letter; the lit one shows the
          // letter it will type, whichever way the board is turned.
          cap.dataset.show = at.shift ? 'shift' : 'base';
          litCap = cap;
          keepCapInView(cap);
        }
        lightFinger(at.finger, 'true');

        if (at.shift) {
          // Only the Shift on the opposite side - reaching for the one under
          // the typing hand is the habit this is trying to prevent.
          for (const s of shiftCaps) {
            if (s.dataset.finger === at.shiftFinger) {
              s.dataset.next = 'hold';
              litShift.push(s);
            }
          }
          lightFinger(at.shiftFinger, 'hold');
        }
      } else {
        promptFinger.textContent = '';
      }

      root.dispatchEvent(
        new CustomEvent('tutor:nextkey', { detail: { char: ch, at }, bubbles: false }),
      );
    }

    /**
     * Keep the highlighted cap on screen when the board is wider than the
     * phone.
     *
     * A full QWERTY keyboard cannot be drawn legibly at 360px, and wrapping it
     * would stop it being a picture of a keyboard - so it scrolls sideways,
     * and the thing it is pointing at has to come with it. Horizontal only,
     * and only within the board: nothing here may move the page.
     */
    function keepCapInView(cap: HTMLElement) {
      if (board.scrollWidth <= board.clientWidth) return;
      const box = board.getBoundingClientRect();
      const key = cap.getBoundingClientRect();
      const pad = 24;
      if (key.right > box.right - pad) {
        board.scrollLeft += key.right - box.right + pad;
      } else if (key.left < box.left + pad) {
        board.scrollLeft -= box.left + pad - key.left;
      }
    }

    const kbd = (label: string) => {
      const el = document.createElement('span');
      el.className = 'tt-kbd';
      el.textContent = label;
      return el;
    };
    const plus = () => {
      const el = document.createElement('span');
      el.className = 'tt-kbd-plus';
      el.textContent = '+';
      return el;
    };

    /** Which akshara the caret sits in, for the prompt's Hindi glyph. */
    function unitIndexFor(typedLength: number) {
      let at = 0;
      for (let i = 0; i < runs.length; i++) {
        const end = at + runs[i].length;
        if (typedLength < end) return i;
        at = end;
      }
      return runs.length - 1;
    }

    // ----------------------------------------------------------------------
    // Press feedback
    // ----------------------------------------------------------------------
    //
    // Read from keydown rather than from the input event, because this is the
    // one thing that genuinely needs to know WHICH KEY was pressed rather than
    // what the text became. The input event remains the authority for state.

    const flashTimers = new Map<HTMLElement, ReturnType<typeof setTimeout>>();

    function flash(cap: HTMLElement, hit: 'ok' | 'bad') {
      cap.dataset.hit = hit;
      clearTimeout(flashTimers.get(cap));
      flashTimers.set(
        cap,
        setTimeout(() => {
          delete cap.dataset.hit;
          flashTimers.delete(cap);
        }, FLASH_MS),
      );
    }

    // ----------------------------------------------------------------------
    // Key sounds
    // ----------------------------------------------------------------------
    //
    // Two short tones, synthesised rather than downloaded: an audio file would
    // be the largest asset on the page by an order of magnitude, for a feature
    // that is off by default.
    //
    // The AudioContext is created on the first sounded keystroke, never at
    // load. Browsers suspend one built before a user gesture, and building it
    // eagerly would also leave an audio device open on a page that may never
    // make a sound.

    const soundBox = q<HTMLInputElement>('sound');
    let audio: AudioContext | null = null;

    function readSound() {
      try {
        return localStorage.getItem(SOUND_KEY) === 'on';
      } catch {
        return false;
      }
    }

    function writeSound(on: boolean) {
      try {
        localStorage.setItem(SOUND_KEY, on ? 'on' : 'off');
      } catch {
        // Stays on for this session and is not remembered. Harmless.
      }
    }

    soundBox.checked = readSound();
    soundBox.addEventListener('change', () => writeSound(soundBox.checked));

    function click(ok: boolean) {
      if (!soundBox.checked) return;
      try {
        const Ctx = window.AudioContext ?? (window as any).webkitAudioContext;
        if (!Ctx) return;
        audio ??= new Ctx();
        if (audio.state === 'suspended') void audio.resume();

        const t = audio.currentTime;
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        // A wrong key is lower and a little longer, so the two are told apart
        // without looking away from the passage.
        osc.type = 'square';
        osc.frequency.value = ok ? 1050 : 300;
        const peak = ok ? 0.035 : 0.05;
        const len = ok ? 0.05 : 0.09;
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(peak, t + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + len);
        osc.connect(gain).connect(audio.destination);
        osc.start(t);
        osc.stop(t + len + 0.01);
      } catch {
        // No Web Audio, a blocked context, or a device with no output. A tutor
        // that threw because it could not beep would be absurd.
      }
    }

    capture.addEventListener('keydown', (e) => {
      if (done) return;
      // The hands are on the keyboard; reaching for a button to stop the clock
      // is the one moment a tutor should not make you use the mouse.
      if (e.key === 'Escape') {
        e.preventDefault();
        // An exam, like the real one, cannot be paused.
        if (mode !== 'exam' && mode !== 'unicode') pause();
        return;
      }
      if (mode === 'unicode') return;
      if (e.key === 'Enter') e.preventDefault();
      if (!backspaceOn() && (e.key === 'Backspace' || e.key === 'Delete')) {
        e.preventDefault();
        return;
      }
      // Printable keys only: a modifier or an arrow is not an attempt.
      if (e.key.length !== 1 || e.ctrlKey || e.metaKey || e.altKey) return;

      const want = nextKey(expected, capture.value);
      const right = e.key === want;
      const at = locate(e.key);
      const cap = at ? caps.get(at.cap) : null;
      // A green or red flash tells right from wrong: that is highlighting too.
      if (cap && highlightOn()) flash(cap, right ? 'ok' : 'bad');
      click(right);
    });

    // ----------------------------------------------------------------------
    // Exam rules: Backspace and highlighting, both on unless turned off
    // ----------------------------------------------------------------------

    const backspaceBox = q<HTMLInputElement>('backspace');
    const highlightBox = q<HTMLInputElement>('highlight');
    const rulesNote = q<HTMLElement>('rules-note');
    const typedWrap = q<HTMLElement>('typed-wrap');
    const typedEl = q<HTMLElement>('typed');
    const backspaceOn = () => mode === 'unicode' || backspaceBox.checked;
    const highlightOn = () => highlightBox.checked;

    function readRule(key: string) {
      try {
        return localStorage.getItem(key) !== 'off';
      } catch {
        return true;
      }
    }
    function writeRule(key: string, on: boolean) {
      try {
        if (on) localStorage.removeItem(key);
        else localStorage.setItem(key, 'off');
      } catch {
        // Applies to this visit only. Harmless.
      }
    }

    function applyRules() {
      root.dataset.highlight = mode !== 'unicode' && highlightOn() ? 'on' : 'off';
      typedWrap.hidden = mode === 'unicode' || highlightOn();
      typedEl.textContent = capture.value;
      updateStats();
      const off = [!backspaceOn() && L.backspaceOffNote, !highlightOn() && L.highlightOffNote].filter(Boolean);
      rulesNote.textContent = off.join(' ');
      rulesNote.hidden = mode === 'unicode' || off.length === 0;
      showNextKey(capture.value);
    }

    backspaceBox.checked = readRule(BACKSPACE_KEY);
    highlightBox.checked = readRule(HIGHLIGHT_KEY);
    backspaceBox.addEventListener('change', () => {
      writeRule(BACKSPACE_KEY, backspaceBox.checked);
      applyRules();
    });
    highlightBox.addEventListener('change', () => {
      writeRule(HIGHLIGHT_KEY, highlightBox.checked);
      applyRules();
    });

    // No Backspace means no correction of any kind: phone keyboards delete
    // through beforeinput rather than a Backspace keydown, and undo, cut or
    // typing over a selection would correct just the same.
    capture.addEventListener('beforeinput', (e) => {
      if (backspaceOn()) return;
      if (/^(delete|history)/.test(e.inputType)) e.preventDefault();
    });
    capture.addEventListener('cut', (e) => {
      if (!backspaceOn()) e.preventDefault();
    });
    // And the caret stays at the end, so nothing can be inserted earlier on.
    const pinCaret = () => {
      if (backspaceOn()) return;
      const end = capture.value.length;
      if (capture.selectionStart !== end || capture.selectionEnd !== end) capture.setSelectionRange(end, end);
    };
    for (const type of ['select', 'click', 'keyup', 'focus']) capture.addEventListener(type, pinCaret);

    // A typing test is not a copy-paste exercise.
    capture.addEventListener('paste', (e) => e.preventDefault());
    capture.addEventListener('drop', (e) => e.preventDefault());

    // ----------------------------------------------------------------------
    // The clock
    // ----------------------------------------------------------------------

    const elapsed = () => accumulated + (running ? Date.now() - segmentStart : 0);
    const remaining = () => Math.max(0, testSeconds() * 1000 - elapsed());

    function start() {
      if (running || done) return;
      // A new run, not a resume after a pause. Which mode and how long - never
      // the passage or anything typed.
      if (accumulated === 0) track('typing_test_start', { mode, minutes: timed() ? Math.round(testSeconds() / 60) : 0, ...ppParam() });
      running = true;
      paused = false;
      segmentStart = Date.now();
      root.dataset.state = 'running';
      pauseBtn.hidden = mode === 'exam' || mode === 'unicode';
      pauseBtn.textContent = L.pause;
      ticker = setInterval(tick, TICK_MS);
    }

    /**
     * Stop the clock and stop counting keystrokes.
     *
     * The input is DISABLED rather than merely ignored. A field that still
     * takes text while the clock is stopped is a way to type the passage for
     * free, and on a phone leaving the keyboard up over a paused test invites
     * exactly that. Disabling it also blurs, which brings the veil back - so
     * the veil says why.
     */
    function pause() {
      if (!running || done) return;
      accumulated += Date.now() - segmentStart;
      running = false;
      paused = true;
      clearInterval(ticker);
      root.dataset.state = 'paused';
      capture.disabled = true;
      pauseBtn.textContent = L.resume;
      veilText.textContent = L.veilPaused;
      updateStats();
    }

    function resume() {
      if (!paused || done) return;
      capture.disabled = false;
      veilText.textContent = L.veil;
      start();
      capture.focus();
    }

    function tick() {
      updateStats();
      // A lesson has no clock to run out: it ends when the drill is typed.
      if (timed() && remaining() <= 0) finish('time');
    }

    /**
     * `submitted` is the user stopping on purpose. It is deliberately not the
     * same as running out of time: an attempt that was cut short has not
     * cleared a lesson, however accurate it was up to that point, and the
     * result card says which of the three happened.
     */
    function finish(reason: 'time' | 'passage' | 'submitted') {
      if (done) return;
      // Close the open segment before stopping, or the last stretch of typing
      // would not be counted and every result would flatter the typist.
      if (running) accumulated += Date.now() - segmentStart;
      done = true;
      running = false;
      paused = false;
      clearInterval(ticker);
      root.dataset.state = 'done';
      capture.disabled = true;
      pauseBtn.hidden = true;
      updateStats();
      showResult(reason);
      saveSession();
      // Which lesson or test was finished: counted, never what was typed.
      if (mode !== 'lesson') track('test_finish', { mode, minutes: timed() ? Math.round(testSeconds() / 60) : 0, ...ppParam() });
    }

    // ----------------------------------------------------------------------
    // Stats
    // ----------------------------------------------------------------------

    function updateStats() {
      const s = summarise(expected, capture.value, elapsed());

      // Practice counts down to a deadline; a lesson counts up, because there
      // is no deadline and a falling number would invent one.
      timeEl.textContent = formatClock(timed() ? remaining() : elapsed());
      statTime.dataset.low = String(timed() && running && remaining() <= 10_000);
      wpmEl.textContent = String(Math.round(s.net));
      // Highlighting off: as in an exam, how it is going waits for the result.
      const live = highlightOn() || done;
      accEl.textContent = live ? `${Math.round(s.accuracy)}%` : '–';
      errEl.textContent = live ? String(s.wrong) : '–';

      // Progress is measured in keystrokes, like everything else on this page.
      // Aksharas would read as a smaller number that moves at a different
      // speed from the clock, and the clock is spent on keystrokes.
      const typedLength = Math.min(capture.value.length, expected.length);
      const left = expected.length - typedLength;
      const pct = expected.length === 0 ? 0 : Math.round((typedLength / expected.length) * 100);

      progressEl.textContent = `${typedLength} / ${expected.length}`;
      progressFill.style.width = `${expected.length === 0 ? 0 : (typedLength / expected.length) * 100}%`;
      progressPct.textContent = fill(L.complete, { pct });
      progressTrack.setAttribute('aria-valuenow', String(pct));
      progressTrack.setAttribute(
        'aria-valuetext',
        fill(L.progressAria, { pct, left }),
      );
      // Words as well as characters: five keystrokes to the word is the unit
      // the WPM figure beside it already uses, so the two agree.
      progressLeft.textContent =
        left === 0
          ? L.allTyped
          : fill(L.left, { left, words: Math.max(1, Math.round(left / 5)) });

      if (mode === 'unicode') {
        progressLeft.textContent = fill(L.nativeProgress, { left });
        progressTrack.setAttribute('aria-valuetext', progressLeft.textContent);
      }

      // Nothing typed means nothing to score, so there is nothing to submit.
      submitBtn.disabled = done || s.typed === 0;
      return s;
    }

    function showResult(reason: 'time' | 'passage' | 'submitted') {
      const s = summarise(expected, capture.value, elapsed() || 1);
      const net = Math.round(s.net);
      q('native-grade').hidden = mode !== 'unicode';
      if (mode === 'unicode') {
        q('result-title').textContent = L.nativeHeading;
        q('result-note').textContent = L.nativeEstimate;
        try {
          const estimate = evaluateHindiPractice(unitsToText(units), capture.value);
          q('native-grade').textContent = fill(L.nativeSummary, { full: estimate.fullMistakes, half: estimate.halfMistakes, weighted: estimate.weightedMistakes });
        } catch {
          q('native-grade').textContent = L.nativeTooLong;
        }
        shareBtn.hidden = true;
        nextLevelBtn.hidden = true;
        result.hidden = false;
        result.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }

      q('r-wpm').textContent = String(net);
      q('r-gross').textContent = String(Math.round(s.gross));
      q('r-acc').textContent = `${Math.round(s.accuracy)}%`;
      q('r-err').textContent = String(s.wrong);

      // What to practise next, named rather than implied.
      const missed = missedKeys(expected, capture.value).slice(0, 8);
      const wrap = q<HTMLElement>('missed-wrap');
      const list = q<HTMLElement>('missed');
      list.textContent = '';
      wrap.hidden = missed.length === 0;
      for (const m of missed) {
        const cell = document.createElement('div');
        cell.className = 'kb-hint';
        const deva = document.createElement('span');
        deva.className = 'kb-hint-deva';
        deva.lang = 'hi';
        deva.textContent = devaForKey(m.key);
        const key = document.createElement('span');
        key.className = 'kb-hint-key';
        key.textContent = `${m.key === ' ' ? L.space : m.key} × ${m.count}`;
        cell.append(deva, key);
        list.append(cell);
      }

      const note = q('result-note');
      nextLevelBtn.hidden = true;

      // A best speed is only meaningful over a run that went the distance.
      // Submitting after four words would otherwise post a flattering number
      // that no full-length attempt could ever beat.
      const ranks = mode !== 'targeted' && (
        mode === 'lesson' || mode === 'daily' || mode === 'passages' ? s.complete : reason !== 'submitted' || s.complete);
      const acc = Math.round(s.accuracy);

      if (mode === 'targeted') {
        q('result-title').textContent = L.coachDrill;
        note.textContent = fill(L.examScore, { wpm: net, acc });
      } else if (mode === 'lesson') {
        recordLesson(s, net, note, reason);
      } else if (mode === 'passages') {
        const through = Math.round((s.typed / expected.length) * 100);
        q('result-title').textContent = s.complete ? L.passageFinished : L.yourResult;
        note.textContent = s.complete ? fill(L.ppDone, { n: ppN }) : fill(L.ppPartial, { acc, through });
        recordPractice(s.complete ? 100 : through, net, acc);
        const next = ppN < PP.count ? ppN + 1 : 0;
        if (next) {
          nextLevelBtn.hidden = false;
          nextLevelBtn.textContent = fill(L.ppNext, { n: next });
        }
      } else if (mode === 'daily') {
        q('result-title').textContent = s.complete ? L.passageFinished : L.yourResult;
        note.textContent = s.complete ? L.todayDone : fill(L.partial, { acc, through: Math.round((s.typed / expected.length) * 100) });
      } else {
        const best = readBest();
        q('result-title').textContent =
          mode === 'exam'
            ? L.examResult
            : reason === 'passage'
              ? L.passageFinished
              : reason === 'submitted'
                ? L.yourResult
                : L.timesUp;

        if (mode === 'exam') {
          // The exam's score line comes first; the best-speed note follows.
          note.textContent = fill(L.examScore, { wpm: net, acc }) + ' ';
        } else {
          note.textContent = '';
        }
        const append = (text: string) => (note.textContent += text);

        if (ranks && net > best) {
          writeBest(net);
          append(best > 0 ? fill(L.newBest, { best }) : L.savedBest);
        } else if (!ranks) {
          append(
            fill(L.submittedShort, { time: formatClock(elapsed()) }) +
              (best > 0 ? fill(L.submittedShortBest, { best }) : L.submittedShortEnd),
          );
        } else if (best > 0) {
          append(fill(L.yourBest, { best }));
        }
      }

      const mistakes = mistakeUnits(units, capture.value);
      const nextDrill = targetedDrill(mistakes);
      if (nextDrill.length) coachingUnits = nextDrill;
      q('coach-drill').hidden = coachingUnits.length === 0;
      recommendedLevel = nextPractice(LEVELS, progress.done, levelId, s);
      q('coach-advice').textContent = mistakes.length
        ? L.coachAccuracy
        : fill(L.coachRecommendation, { lesson: levelOf(recommendedLevel).title });
      const explanations = q('coach-explanations');
      explanations.replaceChildren();
      for (const mistake of mistakes.slice(0, 3)) {
        const item = document.createElement('li');
        const shift = [...mistake.keys].some(k => locate(k)?.shift);
        const detail = shift ? L.coachShift : /[िीुूृेैोौंँ्]/u.test(mistake.deva) ? L.coachMatra : L.coachSequence;
        item.textContent = fill(L.coachExample, { text: mistake.deva, keys: mistake.keys }) + ' ' + detail;
        explanations.append(item);
      }

      // Into the long-term record: streak, minutes, chart, badges.
      me.record(
        {
          mode: mode === 'targeted' ? 'practice' : mode,
          wpm: net,
          acc,
          ms: elapsed(),
          typed: s.typed,
          ranked: ranks,
          complete: s.complete,
          ...(mode === 'daily' ? { day: dailyDay, pct: Math.round((s.typed / expected.length) * 100) } : {}),
        },
        ctx(),
      );
      if (mode === 'daily') renderDays();
      lastResult = { wpm: net, acc };
      shareBtn.hidden = net <= 0 || mode === 'targeted';

      result.hidden = false;
      result.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    /**
     * Mark a lesson attempt, and unlock the next one if it was clean enough.
     *
     * Accuracy is the only gate. Gating on speed teaches people to rush a drill
     * they have not learned, which is how a typist builds a plateau they then
     * cannot get out of - so speed is recorded and celebrated, never required.
     */
    function recordLesson(
      s: ReturnType<typeof summarise>,
      net: number,
      note: HTMLElement,
      reason: 'time' | 'passage' | 'submitted',
    ) {
      const level = levelOf(levelId);
      const acc = Math.round(s.accuracy);
      const cleared = s.typed > 0 && s.complete && s.accuracy >= level.threshold;

      // The best speed for a level is only meaningful for an attempt that
      // actually finished it.
      if (s.complete && (!progress.best[levelId] || net > progress.best[levelId])) {
        progress.best[levelId] = net;
      }

      if (cleared) {
        if (!progress.done.includes(levelId)) progress.done.push(levelId);
        const next = LEVELS[LEVELS.findIndex((l) => l.id === levelId) + 1];
        q('result-title').textContent = fill(L.levelComplete, { title: level.title });
        note.textContent = next
          ? fill(L.unlocked, { acc, next: next.title })
          : fill(L.lastLesson, { acc });
        if (next) {
          nextLevelBtn.hidden = false;
          nextLevelBtn.textContent = fill(L.startLevel, { title: next.title });
        }
      } else if (!s.complete) {
        const through = Math.round((s.typed / expected.length) * 100);
        q('result-title').textContent =
          reason === 'submitted' ? L.submittedEarly : L.stoppedEarly;
        note.textContent = fill(L.partial, { acc, through });
      } else {
        q('result-title').textContent = L.notQuite;
        note.textContent = fill(L.needs, { acc, threshold: level.threshold });
      }

      writeProgress(progress);
      renderLevels();
      track('lesson_finish', { lesson: levelId, cleared: cleared ? 'yes' : 'no' });
    }

    /** The Hindi printed on a cap, for the missed-keys list. */
    function devaForKey(key: string) {
      const at = locate(key);
      const cap = at ? caps.get(at.cap) : null;
      if (!cap) return '';
      const el = cap.querySelector(at!.shift ? '.kbd-shift' : '.kbd-base');
      return el?.textContent ?? '';
    }

    // ----------------------------------------------------------------------
    // Resetting
    // ----------------------------------------------------------------------

    function reset({ newPassage = true } = {}) {
      keepRestoredPassage = false;
      clearInterval(ticker);
      running = false;
      paused = false;
      done = false;
      accumulated = 0;
      segmentStart = 0;

      capture.disabled = false;
      capture.value = '';
      typedEl.textContent = '';
      result.hidden = true;
      nextLevelBtn.hidden = true;
      shareBtn.hidden = true;
      pauseBtn.hidden = true;
      pauseBtn.textContent = L.pause;
      veilText.textContent = L.veil;
      root.dataset.state = 'idle';
      passage.scrollTop = 0;

      // 30 passages, before their keystrokes have arrived: placeholder lines
      // and a field that takes nothing, until they do.
      if (mode === 'passages' && !ppData) {
        units = [];
        runs = [];
        expected = '';
        capture.disabled = true;
        lineEl.replaceChildren(
          ...(ppFailed
            ? [Object.assign(document.createElement('span'), { textContent: L.ppFailed })]
            : ['', '', ' tt-skel-short'].map((c) =>
                Object.assign(document.createElement('span'), { className: `mkd-skel tt-skel${c}` }),
              )),
        );
        titleEl.textContent = ppFailed ? L.ppFailedTitle : L.ppLoading;
        updateStats();
        showNextKey('');
        promptFinger.textContent = '';
        if (!ppFailed) loadPractice();
        saveSession();
        return;
      }

      if (newPassage || units.length === 0) buildLesson();
      renderPassage();
      updateStats();
      showNextKey('');
      saveSession();
    }

    /** A date as this page's language writes it short: "10 Oct", "10 अक्टू॰". */
    function dateLabel(day: string) {
      const [y, m, d] = day.split('-').map(Number);
      return new Intl.DateTimeFormat(document.documentElement.lang || 'en', { day: 'numeric', month: 'short' }).format(
        new Date(y, m - 1, d),
      );
    }

    /**
     * Today's practice: the last 7 days, newest first. Each row shows the
     * day's passage and the best try at it, and opens that passage. Built
     * with textContent only.
     */
    const daysBox = q<HTMLElement>('days');
    const daysList = q<HTMLElement>('days-list');
    const daysCount = q<HTMLElement>('days-count');
    function renderDays() {
      const today = dayKey();
      const record = me.habit.daily ?? {};
      const week = lastDays(today, 7);
      daysCount.textContent = fill(L.daysCount, { done: week.filter((d) => (record[d]?.pct ?? 0) >= 100).length });
      daysList.replaceChildren(
        ...week.map((day) => {
          const p = PASSAGES[dailyIndex(day, PASSAGES.length)];
          const r = record[day];
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tt-day';
          btn.dataset.day = day;
          btn.setAttribute('aria-pressed', String(day === dailyDay));
          const when = document.createElement('span');
          when.className = 'tt-day-when';
          when.textContent = day === today ? L.daysToday : dateLabel(day);
          const title = document.createElement('span');
          title.className = 'tt-day-title';
          title.lang = 'hi';
          title.textContent = p.title;
          const status = document.createElement('span');
          status.className = 'tt-day-status';
          status.dataset.state = !r ? 'none' : r.pct >= 100 ? 'done' : 'part';
          status.textContent = !r
            ? L.daysNone
            : (r.pct >= 100 ? L.daysDone : fill(L.daysPart, { pct: r.pct })) +
              ' · ' +
              fill(L.daysStats, { wpm: r.wpm, acc: r.acc });
          btn.append(when, title, status);
          btn.addEventListener('click', () => {
            dailyDay = day;
            renderDays();
            reset({ newPassage: true });
            capture.focus();
          });
          li.append(btn);
          return li;
        }),
      );
    }

    // ----------------------------------------------------------------------
    // 30 passages
    // ----------------------------------------------------------------------

    const ppWrap = q<HTMLElement>('pp-wrap');
    const ppChips = new Map<number, HTMLButtonElement>();
    for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-pp]')) ppChips.set(Number(chip.dataset.pp), chip);
    // The free practice page links each passage here: ?passage=<1-30>. Read
    // before the first setMode, which tidies the address.
    const askedPassage = Number(new URLSearchParams(location.search).get('passage'));
    const askedExam = new URLSearchParams(location.search).get('exam');
    const examEntry = askedExam === CHSL_HINDI_2026.id ? 'unicode' : askedExam === 'remington' ? 'exam' : undefined;
    const ppLevelOf = (n: number) => Number(ppChips.get(n)?.dataset.ppOf ?? 1);
    const ppTitleOf = (n: number) => ppChips.get(n)?.querySelector('.tt-level-name')?.textContent ?? '';
    const ppParam = () => (mode === 'passages' ? { passage: ppN } : {});

    /** The record, checked on the way in: anything could be under the key. */
    function readPractice(): PracticeRecord {
      const out: PracticeRecord = {};
      try {
        const parsed = JSON.parse(localStorage.getItem(PRACTICE_KEY) || '{}');
        for (const [k, v] of Object.entries(parsed ?? {})) {
          const n = Number(k);
          const r = v as Record<string, unknown>;
          if (!ppChips.has(n) || !r || typeof r !== 'object') continue;
          const pct = Number(r.pct);
          const wpm = Number(r.wpm);
          const acc = Number(r.acc);
          if ([pct, wpm, acc].every((x) => Number.isFinite(x) && x >= 0 && x <= 1000)) {
            out[n] = { pct: Math.min(100, pct), wpm, acc };
          }
        }
      } catch {
        // Nothing usable stored: every passage shows as not practised.
      }
      return out;
    }

    let ppRecord = readPractice();

    /** Keep the furthest try at a passage, and the faster of two equal ones. */
    function recordPractice(pct: number, wpm: number, acc: number) {
      // Kept inside what readPractice accepts, so a tick is never lost on reload.
      wpm = Math.min(999, Math.max(0, wpm));
      const old = ppRecord[ppN];
      if (!old || pct > old.pct || (pct === old.pct && wpm > old.wpm)) ppRecord[ppN] = { pct, wpm, acc };
      try {
        localStorage.setItem(PRACTICE_KEY, JSON.stringify(ppRecord));
      } catch {
        // Remembered for this visit only.
      }
      renderPractice();
    }

    /** The first passage not yet typed to the end, or the first one. */
    const firstUndone = () => [...ppChips.keys()].find((n) => (ppRecord[n]?.pct ?? 0) < 100) ?? 1;

    function renderPractice() {
      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-pp-level]')) {
        b.setAttribute('aria-pressed', String(Number(b.dataset.ppLevel) === ppLevel));
      }
      for (const [n, chip] of ppChips) {
        const r = ppRecord[n];
        const done = (r?.pct ?? 0) >= 100;
        chip.hidden = ppLevelOf(n) !== ppLevel;
        chip.dataset.state = n === ppN ? 'current' : done ? 'done' : 'open';
        chip.setAttribute('aria-pressed', String(n === ppN));
        chip.querySelector<HTMLElement>('[data-role="pp-meta"]')!.textContent = !r
          ? L.daysNone
          : (done ? L.daysDone : fill(L.daysPart, { pct: r.pct })) + ' · ' + fill(L.daysStats, { wpm: r.wpm, acc: r.acc });
      }
    }

    function loadPractice() {
      if (ppLoading || ppData || !PP.url) return;
      ppLoading = true;
      fetch(PP.url)
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then((list: Practice[]) => {
          if (!Array.isArray(list) || list.length !== PP.count) throw new Error('bad data');
          ppData = list;
        })
        .catch(() => {
          ppFailed = true;
        })
        .finally(() => {
          ppLoading = false;
          if (mode === 'passages' && !keepRestoredPassage) reset({ newPassage: true });
          keepRestoredPassage = false;
        });
    }

    /** The address says which passage is open, so a refresh or a shared link keeps it. */
    function syncUrl() {
      try {
        const url = new URL(location.href);
        if (mode === 'passages' && ppN) url.searchParams.set('passage', String(ppN));
        else url.searchParams.delete('passage');
        if (mode === 'exam' || mode === 'unicode') url.searchParams.set('exam', mode === 'unicode' ? CHSL_HINDI_2026.id : 'remington');
        else url.searchParams.delete('exam');
        if (url.href !== location.href) history.replaceState(history.state, '', url);
      } catch {
        // Older browser: the address simply stays as it was.
      }
    }

    function setPassage(n: number) {
      if (!ppChips.has(n)) return;
      ppN = n;
      ppLevel = ppLevelOf(n);
      // A failed load is tried again when a passage is picked.
      ppFailed = false;
      renderPractice();
      syncUrl();
      reset({ newPassage: true });
      capture.focus();
    }

    for (const [n, chip] of ppChips) chip.addEventListener('click', () => setPassage(n));
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-pp-level]')) {
      b.addEventListener('click', () => {
        ppLevel = Number(b.dataset.ppLevel);
        renderPractice();
      });
    }

    /** Swap between the ladder and the timed test, and re-dress the UI for it. */
    function setMode(next: Mode) {
      mode = next;
      if (next === 'exam' || next === 'unicode') examMode = next;
      root.dataset.mode = next;
      // Today's practice always opens on today's passage.
      dailyDay = dayKey();
      daysBox.hidden = next !== 'daily';
      if (next === 'daily') renderDays();

      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-role="mode"] button')) {
        b.setAttribute('aria-pressed', String(b.dataset.mode === next || (next === 'unicode' && b.dataset.mode === 'exam')));
      }

      const lesson = next === 'lesson';
      levelsWrap.hidden = !lesson;
      q('exam-profiles').hidden = next !== 'exam' && next !== 'unicode';
      q('exam-presets').hidden = next !== 'exam';
      q('native-profile').hidden = next !== 'unicode';
      q('coach-unicode').setAttribute('aria-pressed', String(next === 'unicode'));
      q('exam-remington').setAttribute('aria-pressed', String(next === 'exam'));
      q('native-tab').hidden = next !== 'unicode';
      q('native-source').hidden = next !== 'unicode';
      q('layout-note').hidden = next === 'unicode';
      q('rule-controls').hidden = next === 'unicode';
      q<HTMLDetailsElement>('mode-help').open = false;
      q('coach-panel').hidden = next === 'unicode';
      root.querySelector('label[for="tt-capture"]')!.textContent = next === 'unicode' ? L.nativeLabel : L.captureLabel;
      capture.setAttribute('aria-describedby', next === 'unicode' ? 'tt-native-help' : 'tt-prompt-text');
      if (next === 'unicode') {
        capture.lang = 'hi'; capture.maxLength = 20000;
      }
      else {
        capture.removeAttribute('lang'); capture.removeAttribute('maxlength');
      }

      ppWrap.hidden = next !== 'passages';
      if (next === 'passages') {
        if (!ppN) ppN = firstUndone();
        ppLevel = ppLevelOf(ppN);
        ppFailed = false;
        renderPractice();
      }
      syncUrl();
      // The exam's length is the exam's; only a practice test picks one.
      durationGroup.hidden = next !== 'practice';
      timeLabel.textContent = timed() ? L.timeLeft : L.time;
      // "New passage" makes no sense on a fixed drill - a lesson is the same
      // text every time, which is the point of practising it - nor on
      // today's passage, which is the one for today.
      newBtn.hidden = lesson || next === 'targeted' || next === 'unicode' || next === 'daily' || next === 'passages';
      modeNote.hidden = next !== 'daily' && next !== 'exam' && next !== 'passages';
      modeNote.textContent =
        next === 'passages'
          ? L.ppNote
          : next === 'exam'
          ? L.examNote
          : next === 'daily'
            ? L.todayNote + (me.habit.dailyDone === dayKey() ? ` ${L.todayDone}` : '')
            : '';

      renderLevels();
      reset({ newPassage: true });
      applyRules();
    }

    function setLevel(id: string) {
      if (!unlocked(id)) return;
      levelId = id;
      renderLevels();
      reset({ newPassage: true });
      capture.focus();
    }

    // ----------------------------------------------------------------------
    // Wiring
    // ----------------------------------------------------------------------

    q('coach-unicode').addEventListener('click', () => { if (mode !== 'unicode') setMode('unicode'); });
    q('exam-remington').addEventListener('click', () => { if (mode !== 'exam') setMode('exam'); });
    q<HTMLSelectElement>('native-duration').addEventListener('change', event => {
      nativeSeconds = Number((event.target as HTMLSelectElement).value) === CHSL_HINDI_2026.eligibleSeconds ? CHSL_HINDI_2026.eligibleSeconds : CHSL_HINDI_2026.seconds;
      reset({ newPassage: true });
    });
    q('native-tab').addEventListener('click', () => {
      if (mode !== 'unicode' || done || paused) return;
      capture.setRangeText('\t', capture.selectionStart, capture.selectionEnd, 'end');
      capture.dispatchEvent(new Event('input')); capture.focus();
    });
    capture.addEventListener('compositionstart', () => {
      if (mode === 'unicode' && !running && !paused && !done) start();
    });
    capture.addEventListener('compositionend', () => {
      if (mode === 'unicode') capture.dispatchEvent(new Event('input'));
    });
    q('coach-drill').addEventListener('click', () => {
      if (!coachingUnits.length) return;
      setMode('targeted');
      capture.focus();
    });
    q('coach-next').addEventListener('click', () => {
      setMode('lesson');
      setLevel(recommendedLevel);
    });
    q<HTMLSelectElement>('exam-preset').addEventListener('change', (event) => {
      const preset = (event.target as HTMLSelectElement).value;
      if (preset === 'custom') return;
      for (const role of ['backspace', 'highlight']) {
        const box = q<HTMLInputElement>(role);
        box.checked = preset === 'guided';
        writeRule(role === 'backspace' ? BACKSPACE_KEY : HIGHLIGHT_KEY, box.checked);
      }
      applyRules();
      q<HTMLSelectElement>('exam-preset').value = preset;
      reset({ newPassage: true });
    });
    for (const role of ['backspace', 'highlight']) q(role).addEventListener('change', () => {
      q<HTMLSelectElement>('exam-preset').value = 'custom';
    });
    const focusButton = q<HTMLButtonElement>('focus-toggle');
    let inertSiblings: { el: HTMLElement; inert: boolean }[] = [];
    let previousOverflow = '';
    function focusMode(on: boolean) {
      root.dataset.focusMode = String(on);
      focusButton.setAttribute('aria-pressed', String(on));
      q('focus-label').textContent = on ? L.coachExitFocus : L.coachFocus;
      if (on) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        root.scrollTop = 0;
        let node: HTMLElement = root;
        while (node.parentElement) {
          for (const sibling of node.parentElement.children) {
            if (sibling !== node && sibling instanceof HTMLElement) {
              inertSiblings.push({ el: sibling, inert: sibling.inert });
              sibling.inert = true;
            }
          }
          node = node.parentElement;
          if (node === document.body) break;
        }
      } else {
        for (const entry of inertSiblings) entry.el.inert = entry.inert;
        inertSiblings = [];
        document.body.style.overflow = previousOverflow;
      }
      focusButton.focus();
      saveSession();
    }
    focusButton.addEventListener('click', () => focusMode(root.dataset.focusMode !== 'true'));
    root.addEventListener('keydown', event => {
      if (root.dataset.focusMode !== 'true') return;
      if (event.key === 'Escape') {
        event.preventDefault(); event.stopPropagation(); focusMode(false);
      } else if (event.key === 'Tab') {
        const controls = [...root.querySelectorAll<HTMLElement>('button, input, select, textarea, a[href], summary, [tabindex]:not([tabindex="-1"])')]
          .filter(el => !el.closest('[hidden]') && !el.matches(':disabled') && el.getClientRects().length);
        const first = controls[0], last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    }, true);

    capture.addEventListener('input', (event) => {
      if (mode === 'unicode' && (event as InputEvent).isComposing) return;
      // Paused disables the field, so this cannot normally fire - but an
      // autofill or an IME commit can still deliver one, and a paused test
      // must not silently restart its own clock.
      if (done || paused) return;
      if (!running && capture.value.length > 0) start();

      paint(capture.value);
      showNextKey(capture.value);
      if (!highlightOn()) {
        typedEl.textContent = capture.value;
        typedEl.scrollTop = typedEl.scrollHeight;
      }
      const s = updateStats();

      // Finishing the passage ends the run early: there is nothing left to
      // type, and leaving the clock going only punishes a fast typist.
      if (s.complete && mode !== 'unicode') finish('passage');
    });

    capture.addEventListener('focus', () => (root.dataset.focused = 'true'));
    capture.addEventListener('blur', () => (root.dataset.focused = 'false'));
    passage.addEventListener('focus', () => (root.dataset.focused = 'true'));
    passage.addEventListener('blur', () => (root.dataset.focused = 'false'));

    // The veil does not take pointer events, so a click on the passage lands
    // on the textarea underneath and focuses it. This only covers the case of
    // clicking the passage panel's padding.
    passage.addEventListener('click', () => {
      // While paused the field is disabled and focusing it does nothing, so
      // the click means the obvious thing instead.
      if (paused) return resume();
      capture.focus();
    });
    root.querySelector('.tt-stage')!.addEventListener('click', event => {
      // The start hint sits outside the reference in Focus view.
      if (event.target !== event.currentTarget) return;
      if (paused) resume();
      else capture.focus();
    });

    pauseBtn.addEventListener('click', () => {
      if (paused) resume();
      else pause();
    });

    submitBtn.addEventListener('click', () => {
      // Guarded as well as disabled: a disabled button can still be clicked
      // through the keyboard in some assistive setups.
      if (done || capture.value.length === 0) return;
      finish('submitted');
    });

    q<HTMLButtonElement>('restart').addEventListener('click', () => {
      reset({ newPassage: false });
      capture.focus();
    });

    q<HTMLButtonElement>('new').addEventListener('click', () => {
      reset({ newPassage: true });
      capture.focus();
    });

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-role="duration"] button')) {
      btn.addEventListener('click', () => {
        const next = Number(btn.dataset.seconds);
        if (next === seconds) return;
        seconds = next;
        for (const other of root.querySelectorAll<HTMLButtonElement>(
          '[data-role="duration"] button',
        )) {
          other.setAttribute('aria-pressed', String(other === btn));
        }
        reset({ newPassage: true });
      });
    }

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-role="mode"] button')) {
      btn.addEventListener('click', () => {
        const next = btn.dataset.mode === 'exam' ? examMode : btn.dataset.mode as Mode;
        if (next !== mode) setMode(next);
      });
    }

    for (const [id, chip] of levelChips) {
      chip.addEventListener('click', () => setLevel(id));
    }

    nextLevelBtn.addEventListener('click', () => {
      if (mode === 'passages') return setPassage(ppN + 1);
      const i = LEVELS.findIndex((l) => l.id === levelId);
      const next = LEVELS[i + 1];
      if (next) setLevel(next.id);
    });

    /**
     * Clearing progress is destructive and cannot be undone, so it asks - but
     * with a button rather than confirm(), which blocks the page and reads as
     * a browser error to anyone who did not expect it.
     */
    // In the "Your progress" panel, below the tutor card.
    const resetBtn = document.querySelector<HTMLButtonElement>(
      '[data-tutor-progress] [data-role="reset-progress"]',
    )!;
    let armed = false;
    let disarm: ReturnType<typeof setTimeout> | undefined;

    resetBtn.addEventListener('click', () => {
      if (!armed) {
        armed = true;
        resetBtn.textContent = L.tapAgain;
        resetBtn.dataset.armed = 'true';
        clearTimeout(disarm);
        disarm = setTimeout(() => {
          armed = false;
          resetBtn.textContent = L.resetProgress;
          delete resetBtn.dataset.armed;
        }, 4000);
        return;
      }

      clearTimeout(disarm);
      armed = false;
      resetBtn.textContent = L.resetProgress;
      delete resetBtn.dataset.armed;

      // Everything this device remembers about the typist: the ladder, the
      // best speed, and the streak / minutes / chart / badges. Not the sound
      // setting - that is a preference, not progress.
      progress = { done: [], best: {} };
      coachingUnits = [];
      recommendedLevel = LEVELS[0].id;
      try {
        localStorage.removeItem(PROGRESS_KEY);
        localStorage.removeItem(BEST_KEY);
        localStorage.removeItem(PRACTICE_KEY);
      } catch {
        // Storage blocked: there was nothing stored to erase.
      }
      ppRecord = {};
      renderPractice();
      levelId = LEVELS[0].id;
      me.reset(ctx());
      if (mode === 'lesson') {
        renderLevels();
        reset({ newPassage: true });
      } else {
        setMode('lesson');
      }
    });

    shareBtn.addEventListener('click', async () => {
      if (lastResult.wpm <= 0) return;
      shareBtn.disabled = true;
      try {
        await shareResult({ ...lastResult, L });
      } catch (err) {
        console.error(err);
      } finally {
        shareBtn.disabled = false;
      }
    });

    setMode('lesson');
    applyRules();
    me.render(ctx());

    // The QR code on a printed practice sheet opens its lesson: #lesson-<id>.
    // A lesson this device has not unlocked yet stays locked - the ladder is
    // the same however the page was opened - so the furthest open one starts.
    if (examEntry) {
      setMode(examEntry);
    } else if (ppChips.has(askedPassage)) {
      ppN = askedPassage;
      setMode('passages');
    }

    const wanted = !examEntry && /^#lesson-([a-z]+)$/.exec(location.hash)?.[1];
    if (wanted && LEVELS.some((l) => l.id === wanted)) {
      const open = unlocked(wanted) ? wanted : [...LEVELS].reverse().find((l) => unlocked(l.id))!.id;
      if (open !== levelId) {
        levelId = open;
        renderLevels();
        reset({ newPassage: true });
      }
    }

    function saveSession() {
      if (restoring) return;
      try {
        if (!units.length) { sessionStorage.removeItem(sessionKey); return; }
        const draft = JSON.stringify({
          v: 1, savedAt: Date.now(), mode, focus: root.dataset.focusMode === 'true',
          state: done ? 'idle' : running ? 'running' : paused ? 'paused' : 'idle',
          elapsed: done ? 0 : elapsed(), typed: done ? '' : capture.value,
          units, title: titleEl.textContent, level: levelId, passage: ppN, day: dailyDay,
          seconds, nativeSeconds, backspace: backspaceBox.checked, highlight: highlightBox.checked,
          preset: q<HTMLSelectElement>('exam-preset').value,
        });
        if (draft.length <= DRAFT_LIMIT) sessionStorage.setItem(sessionKey, draft);
        else sessionStorage.removeItem(sessionKey);
      } catch {
        // A failed write must not revive an older, out-of-date attempt.
        try { sessionStorage.removeItem(sessionKey); } catch { /* Storage blocked. */ }
      }
    }

    const draft = pendingDraft;
    pendingDraft = null;
    if (draft && LEVELS.some(level => level.id === draft.level) &&
      (draft.mode !== 'lesson' || unlocked(draft.level)) &&
      (!examEntry || draft.mode === examEntry) &&
      (!ppChips.has(askedPassage) || (draft.mode === 'passages' && draft.passage === askedPassage)) &&
      (draft.mode !== 'passages' || ppChips.has(draft.passage)) &&
      (!wanted || draft.level === levelId)) {
      levelId = draft.level;
      ppN = draft.passage;
      seconds = draft.seconds;
      nativeSeconds = draft.nativeSeconds;
      if (draft.mode === 'targeted') coachingUnits = draft.units;
      setMode(draft.mode);
      dailyDay = draft.day;
      units = draft.units;
      runs = unitKeyRuns(units);
      expected = unitsToKeys(units);
      titleEl.textContent = draft.title;
      keepRestoredPassage = draft.mode === 'passages' && !ppData;
      backspaceBox.checked = draft.backspace;
      highlightBox.checked = draft.highlight;
      q<HTMLSelectElement>('exam-preset').value = draft.preset;
      q<HTMLSelectElement>('native-duration').value = String(nativeSeconds);
      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-seconds]')) {
        button.setAttribute('aria-pressed', String(Number(button.dataset.seconds) === seconds));
      }
      capture.value = draft.typed;
      capture.disabled = false;
      capture.setSelectionRange(capture.value.length, capture.value.length);
      renderPassage();
      paint(capture.value);
      applyRules();
      const recovered = recoveredTime(draft);
      accumulated = recovered.elapsed;
      if (draft.mode === 'exam' || draft.mode === 'unicode') accumulated = Math.min(accumulated, testSeconds() * 1000);
      if (recovered.state === 'running') {
        running = true;
        segmentStart = Date.now();
        root.dataset.state = 'running';
        ticker = setInterval(tick, TICK_MS);
      } else if (recovered.state === 'paused') {
        paused = true;
        capture.disabled = true;
        root.dataset.state = 'paused';
        pauseBtn.hidden = false;
        pauseBtn.textContent = L.resume;
        veilText.textContent = L.veilPaused;
      }
      updateStats();
      if (draft.focus) focusMode(true);
      if (recovered.state === 'running' && timed() && remaining() <= 0) finish('time');
    }
    restoring = false;
    saveSession();
    // pagehide catches refresh/navigation; a short debounce and hidden-page
    // checkpoint also protect mobile tabs that the OS later discards.
    let checkpoint: ReturnType<typeof setTimeout> | undefined;
    root.addEventListener('input', () => {
      clearTimeout(checkpoint);
      checkpoint = setTimeout(saveSession, 300);
    });
    root.addEventListener('change', saveSession);
    window.addEventListener('pagehide', saveSession);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveSession();
    });
  }
</script>
