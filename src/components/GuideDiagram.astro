---
/**
 * The diagrams in the guides: HTML figures, not images. Their words are in
 * src/i18n under `diagrams.<name>`, so they are translated with the article,
 * read by screen readers and search engines, and cost no request.
 *
 * Anything a diagram says about keys or characters is COMPUTED, not typed:
 * keystrokes from wholeKeys() (the typing tutor's own function), Remington
 * key labels from chartRows() (read from the Kruti Dev 010 font), code
 * points from the string itself. A diagram cannot contradict the tools.
 */
import { langOf, useT } from '../i18n/index.js';
import { wholeKeys } from '../lib/tutor.build.js';
import { chartRows } from '../lib/printables.js';

interface Props {
  name: string;
}
const { name } = Astro.props;
const { t, raw, render } = useT(langOf(Astro.url));
const d = (k: string) => t(`diagrams.${name}.${k}`);
const list = (k: string) => raw(`diagrams.${name}.${k}`) as any[];

const KNOWN = [
  'install-steps',
  'stored-vs-shown',
  'storage-compare',
  'docx-flow',
  'practice-plan',
  'home-row-compare',
  'symptoms',
  'typing-order',
];
if (!KNOWN.includes(name)) throw new Error(`GuideDiagram: unknown diagram "${name}"`);

const WORD = 'भारत';
const krutiWord = wholeKeys(WORD);
const codes = (s: string) => [...s].map((c) => ({ c, u: `U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}` }));

// Home row, a to ' : Remington from the font, InScript as Windows ships it.
const HOME = ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', "'"];
const remington = new Map(chartRows().flat().map((c) => [c.base, c.baseText]));
const INSCRIPT: Record<string, string> = { a: 'ो', s: 'े', d: '्', f: 'ि', g: 'ु', h: 'प', j: 'र', k: 'क', l: 'त', ';': 'च', "'": 'ट' };
const MARK = /^[ऀ-ःऺ-ॏॢॣ]/;
const circle = (s: string) => (MARK.test(s) ? `◌${s}` : s);

const EXAMPLES = ['कि', 'कर्म', 'क्या', 'प्र', 'श्र'];
// The caption as plain text, to name a scrollable table for screen readers.
const captionText = d('caption').replace(/<[^>]+>/g, '');
---

<figure class="gd not-prose" data-diagram={name}>
  {
    name === 'install-steps' || name === 'docx-flow' ? (
      <ol class="gd-flow">
        {list('steps').map((s: string, i: number) => (
          <li class="gd-box">
            <span class="gd-n" aria-hidden="true">{i + 1}</span>
            <span set:html={render(s)} />
          </li>
        ))}
      </ol>
    ) : name === 'stored-vs-shown' ? (
      <div class="gd-grid">
        <div class="gd-box">
          <p class="gd-h"><Fragment set:html={render(d('krutiTitle'))} /></p>
          <p class="gd-small"><Fragment set:html={render(d('stored'))} /></p>
          <p class="gd-sample"><code translate="no">{krutiWord}</code></p>
          <p class="gd-small"><Fragment set:html={render(d('withFont'))} /></p>
          <p class="gd-sample gd-kruti" lang="hi" translate="no" aria-label={WORD}>{krutiWord}</p>
          <p class="gd-small"><Fragment set:html={render(d('withoutFont'))} /></p>
          <p class="gd-sample" translate="no">{krutiWord}</p>
        </div>
        <div class="gd-box">
          <p class="gd-h"><Fragment set:html={render(d('unicodeTitle'))} /></p>
          <p class="gd-small"><Fragment set:html={render(d('stored'))} /></p>
          <p class="gd-sample" lang="hi">{WORD}</p>
          <p class="gd-small"><Fragment set:html={render(d('anyFont'))} /></p>
          <p class="gd-sample" lang="hi">{WORD}</p>
          <p class="gd-small"><Fragment set:html={render(d('searchable'))} /></p>
          <p class="gd-sample gd-ok">✓</p>
        </div>
      </div>
    ) : name === 'storage-compare' ? (
      <div class="gd-grid">
        {[
          { title: d('krutiTitle'), chars: codes(krutiWord), note: d('krutiNote'), hi: false },
          { title: d('unicodeTitle'), chars: codes(WORD), note: d('unicodeNote'), hi: true },
        ].map((col) => (
          <div class="gd-box">
            <p class="gd-h" set:html={render(col.title)} />
            <ul class="gd-codes">
              {col.chars.map(({ c, u }) => (
                <li>
                  <span class="gd-char" lang={col.hi ? 'hi' : undefined} translate="no">{col.hi ? circle(c) : c}</span>
                  <span class="gd-u" translate="no">{u}</span>
                </li>
              ))}
            </ul>
            <p class="gd-small mt-2" set:html={render(col.note)} />
          </div>
        ))}
      </div>
    ) : name === 'practice-plan' ? (
      <ol class="gd-flow">
        {list('weeks').map((w: { title: string; text: string }) => (
          <li class="gd-box">
            <span class="gd-h block">{w.title}</span>
            <span class="gd-small block" set:html={render(w.text)} />
          </li>
        ))}
      </ol>
    ) : name === 'home-row-compare' ? (
      <div class="gd-scroll" tabindex="0" role="region" aria-label={captionText}>
        <table class="gd-table">
          <thead>
            <tr>
              <th scope="col"><Fragment set:html={render(d('key'))} /></th>
              {HOME.map((k) => <th scope="col" translate="no"><kbd>{k}</kbd></th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row"><Fragment set:html={render(d('remington'))} /></th>
              {HOME.map((k) => <td lang="hi">{circle(remington.get(k) ?? '')}</td>)}
            </tr>
            <tr>
              <th scope="row"><Fragment set:html={render(d('inscript'))} /></th>
              {HOME.map((k) => <td lang="hi">{circle(INSCRIPT[k])}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    ) : name === 'symptoms' ? (
      <div class="gd-grid gd-grid-3">
        {list('items').map((s: { sample: string; see: string; cause: string; fix: string }) => (
          <div class="gd-box">
            <p class="gd-sample" translate="no">{s.sample}</p>
            <p class="gd-h" set:html={render(s.see)} />
            <p class="gd-small"><strong><Fragment set:html={render(d('causeLabel'))} />:</strong> <Fragment set:html={render(s.cause)} /></p>
            <p class="gd-small"><strong><Fragment set:html={render(d('fixLabel'))} />:</strong> <Fragment set:html={render(s.fix)} /></p>
          </div>
        ))}
      </div>
    ) : (
      <div class="gd-scroll" tabindex="0" role="region" aria-label={captionText}>
        <table class="gd-table">
          <thead>
            <tr>
              <th scope="col"><Fragment set:html={render(d('want'))} /></th>
              <th scope="col"><Fragment set:html={render(d('press'))} /></th>
              <th scope="col"><Fragment set:html={render(d('why'))} /></th>
            </tr>
          </thead>
          <tbody>
            {EXAMPLES.map((w, i) => (
              <tr>
                <td lang="hi" class="gd-big">{w}</td>
                <td translate="no">
                  {[...wholeKeys(w)].map((k) => <kbd>{k}</kbd>)}
                </td>
                <td class="gd-left" set:html={render(list('notes')[i])} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <figcaption set:html={render(d('caption'))} />
</figure>

<style>
  .gd {
    margin: 1.75rem 0;
  }
  .gd figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--color-mute);
  }
  .gd-box {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card, 10px);
    background: var(--color-surface);
    padding: 0.85rem 1rem;
  }
  .gd-flow {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: none;
  }
  @media (min-width: 640px) {
    .gd-flow {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
  .gd-flow .gd-box {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }
  .gd-n {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--color-brick);
    color: var(--color-on-brick);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .gd-grid {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .gd-grid {
      grid-template-columns: 1fr 1fr;
    }
    .gd-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gd-grid .gd-box p {
    margin: 0;
  }
  .gd-h {
    font-weight: 600;
    color: var(--color-ink);
  }
  .gd-small {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-body);
    margin-top: 0.5rem !important;
  }
  .gd-sample {
    font-size: 1.5rem;
    line-height: 2.4rem;
    height: 2.4rem;
    overflow: hidden;
    color: var(--color-ink);
    margin-top: 0.15rem !important;
  }
  .gd-sample code {
    font-size: 1.25rem;
  }
  .gd-kruti {
    font-family: 'MKD Kruti Dev 010', serif;
    font-size: 1.75rem;
  }
  .gd-ok {
    color: var(--color-ok, var(--color-brick));
  }
  .gd-codes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .gd-codes li {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.4rem;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    padding: 0.3rem 0.4rem;
    margin: 0;
  }
  .gd-char {
    font-size: 1.35rem;
    line-height: 2.1rem;
    color: var(--color-ink);
  }
  .gd-u {
    font-size: 0.6875rem;
    color: var(--color-mute);
    font-family: ui-monospace, monospace;
  }
  .gd-scroll {
    overflow-x: auto;
  }
  .gd-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
  }
  .gd-table th,
  .gd-table td {
    border: 1px solid var(--color-hairline);
    padding: 0.4rem 0.5rem;
    text-align: center;
    vertical-align: middle;
  }
  .gd-table td[lang='hi'] {
    font-size: 1.15rem;
  }
  .gd-table .gd-left {
    text-align: left;
  }
  .gd-big {
    font-size: 1.35rem !important;
  }
  .gd-table kbd {
    display: inline-block;
    min-width: 1.6rem;
    margin: 0.1rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--color-hairline);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--color-surface);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
  }
</style>
