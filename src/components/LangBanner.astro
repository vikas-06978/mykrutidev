---
import { localizePath, useT, LANG_PREF_KEY, PREFIXED_LOCALES } from '../i18n/index.js';

/**
 * "This site is also available in Hindi" (or Bengali, Tamil, ...) - shown on
 * an English page, once, to a visitor whose browser asks for one of the
 * site's other languages and who has not yet picked a language with the
 * switch. One banner per language is in the page, hidden; the script shows
 * the one for the first language the browser lists.
 *
 * Never a redirect. Sending people (and crawlers) somewhere they did not ask
 * to go is bad for them and worse for search; this is an offer, and closing it
 * is remembered like any other choice.
 *
 * Each is written in its own language on the English page, because the
 * reader it exists for is the one who would rather read that language.
 */
interface Props {
  /** The locale-free route path of the current page. */
  path: string;
}

const { path } = Astro.props;
const banners = PREFIXED_LOCALES.map((lang) => ({ lang, t: useT(lang).t }));
---

{
  banners.map(({ lang, t }) => (
    <div
      data-lang-banner={lang}
      data-pref-key={LANG_PREF_KEY}
      hidden
      lang={lang}
      class="border-b border-saffron/40 bg-warn-bg"
    >
      <div class="wrap flex items-center justify-between gap-3 py-2 text-sm text-ink">
        <p>
          {t('lang.bannerText')}
          <span aria-hidden="true">→</span>
          <a href={localizePath(path, lang)} hreflang={lang} data-lang-switch={lang} class="font-medium">
            {t('lang.bannerCta')}
          </a>
        </p>
        <button
          type="button"
          data-lang-banner-close
          class="grid size-8 shrink-0 place-items-center rounded-(--radius-chrome) text-body hover:bg-inset"
          aria-label={t('lang.bannerClose')}
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    </div>
  ))
}

<script>
  // Storage can be blocked or throw (private mode, disabled site data). Every
  // access is guarded, and when it fails the banner simply stays hidden: it is
  // an offer, not something anyone needs to see.
  const all = [...document.querySelectorAll<HTMLElement>('[data-lang-banner]')];
  if (all.length) {
    const key = all[0].dataset.prefKey!;
    const SEEN = `${key}-banner-seen`;
    const store = {
      get: (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return 'unavailable';
        }
      },
      set: (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          // Not remembered. Harmless.
        }
      },
    };

    // The first language the browser lists that the site has besides English:
    // "bn-IN" picks the Bengali banner, also when English comes before it.
    const langs = navigator.languages?.length ? navigator.languages : [navigator.language];
    let banner: HTMLElement | undefined;
    for (const l of langs) {
      const code = (l ?? '').toLowerCase().split('-')[0];
      banner = all.find((b) => b.dataset.langBanner === code);
      if (banner) break;
    }

    // First visit only: no language picked yet, and the banner not shown before.
    if (banner && !store.get(key) && !store.get(SEEN)) {
      banner.hidden = false;
      store.set(SEEN, '1');
    }

    for (const b of all) {
      b.querySelector('[data-lang-banner-close]')?.addEventListener('click', () => {
        b.hidden = true;
        store.set(key, 'en');
      });
    }
  }
</script>
