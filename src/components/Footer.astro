---
import { getPage, isLive } from '../lib/routes.js';
import { GUIDES, GUIDES_PATH, guidePath } from '../lib/guides.js';
import { readSupport } from '../lib/support.build.js';
import { langOf, useT } from '../i18n/index.js';

const { t, render, listTitle, path: to } = useT(langOf(Astro.url));
// The footer lists the most used converters and tools, not all of them: the
// site has grown past what a footer can hold. "All tools" lists everything,
// and it is linked here and from the header on every page.
const POPULAR_CONVERTERS = [
  '/',
  '/unicode-to-kruti-dev',
  '/kruti-dev-to-mangal',
  '/mangal-to-kruti-dev',
  '/kruti-dev-excel-to-unicode',
  '/devlys-to-unicode',
  '/unicode-to-devlys',
  '/abbasi-chanakya-to-unicode',
  '/preeti-to-unicode',
];
const POPULAR_TOOLS = [
  '/number-to-hindi-words',
  '/amount-in-words',
  '/english-date-to-hindi',
  '/hindi-word-counter',
  '/hindi-to-english-numbers',
  '/hindi-to-iast',
];
const year = new Date().getFullYear();

// On every page, so every page of the site is at most two clicks from home:
// home -> any link here, and the guides index -> each guide.
const live = (paths: string[]) => paths.map(getPage).filter((p) => p && isLive(p));
const typing = live([
  '/hindi-typing-test',
  '/hindi-typing-test-for-exams',
  '/remington-hindi-keyboard',
  '/english-to-hindi-typing',
  '/hindi-keyboard',
  '/how-to-type-hindi-in-ms-word',
  '/kruti-dev-010-font',
  '/kruti-dev-keyboard',
]);
const links = live(POPULAR_CONVERTERS);
const tools = live(POPULAR_TOOLS);
const site = live(['/about', '/contact', '/store', '/privacy-policy', '/terms', '/refund-policy', '/delivery-policy']);
// Only once UPI is configured (PUBLIC_UPI_QR or PUBLIC_UPI_ID, see src/lib/support.build.js).
const support = readSupport(import.meta.env) !== null;
const linkClass = 'text-body no-underline hover:underline';
---

<footer class="mt-16 border-t border-hairline bg-paper">
  <div class="wrap py-10">
    <div class="flex flex-wrap gap-x-12 gap-y-8">
      <div class="min-w-48 flex-1">
        <p class="text-base font-semibold text-ink" translate="no">
          My<span class="text-brick">Kruti</span>Dev
        </p>
        <p class="mt-2 max-w-sm text-sm text-body" set:html={render(t('footer.tagline'))} />
      </div>

      <nav aria-labelledby="footer-conv">
        <p id="footer-conv" class="text-sm font-semibold text-ink">{t('footer.converters')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            links.map((p) => (
              <li>
                <a href={to(p!.path)} class={linkClass} set:html={render(listTitle(t(`pages.${p!.path}.h1`)))} />
              </li>
            ))
          }
          <li>
            <a href={to('/all-converters')} class={linkClass}>
              {t('nav.allConverters')}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-typing">
        <p id="footer-typing" class="text-sm font-semibold text-ink">{t('footer.typing')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            typing.map((p) => (
              <li>
                <a href={to(p!.path)} class={linkClass} set:html={render(t(`pages.${p!.path}.nav`))} />
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-tools">
        <p id="footer-tools" class="text-sm font-semibold text-ink">{t('footer.tools')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            tools.map((p) => (
              <li>
                <a href={to(p!.path)} class={linkClass} set:html={render(t(`pages.${p!.path}.nav`))} />
              </li>
            ))
          }
          <li>
            <a href={to('/all-converters')} class={linkClass}>
              {t('nav.allConverters')}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-guides">
        <p id="footer-guides" class="text-sm font-semibold text-ink">
          <a href={to(GUIDES_PATH)} class="text-ink no-underline hover:underline">{t('footer.guides')}</a>
        </p>
        <ul class="mt-3 max-w-64 space-y-2 text-sm">
          {
            GUIDES.map((g) => (
              <li>
                <a href={to(guidePath(g))} class={linkClass} set:html={render(t(`articles.${g.slug}.crumb`))} />
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-site">
        <p id="footer-site" class="text-sm font-semibold text-ink">{t('footer.site')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            site.map((p) => (
              <li>
                <a href={to(p!.path)} class={linkClass}>{t(`pages.${p!.path}.nav`)}</a>
              </li>
            ))
          }
          {
            support && (
              <li>
                <a href={to('/support')} class={linkClass} data-support-link>
                  <span aria-hidden="true">☕ </span>
                  <Fragment set:html={render(t('support.footerLink'))} />
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-hairline-soft pt-6 text-xs text-mute">
      &copy; {year} <span translate="no">MyKrutiDev</span>. <Fragment set:html={render(t('footer.legal'))} />
    </p>
  </div>
</footer>
