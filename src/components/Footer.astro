---
import { liveConverters } from '../lib/routes.js';
import { langOf, useT } from '../i18n/index.js';

const { t, render, listTitle, path: to } = useT(langOf(Astro.url));
const links = liveConverters();
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-hairline bg-paper">
  <div class="wrap py-10">
    <div class="flex flex-wrap gap-x-12 gap-y-8">
      <div class="min-w-48 flex-1">
        <p class="text-base font-semibold text-ink" translate="no">
          My<span class="text-brick">Kruti</span>Dev
        </p>
        <p class="mt-2 max-w-sm text-sm text-body" set:html={render(t('footer.tagline'))} />
      </div>

      <nav aria-labelledby="footer-conv">
        <p id="footer-conv" class="text-sm font-semibold text-ink">{t('footer.converters')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            links.map((p) => (
              <li>
                <a
                  href={to(p.path)}
                  class="text-body no-underline hover:underline"
                  set:html={render(listTitle(t(`pages.${p.path}.h1`)))}
                />
              </li>
            ))
          }
          <li>
            <a href={to('/all-converters')} class="text-body no-underline hover:underline">
              {t('nav.allConverters')}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-hairline-soft pt-6 text-xs text-mute">
      &copy; {year} <span translate="no">MyKrutiDev</span>. <Fragment set:html={render(t('footer.legal'))} />
      <a href={to('/privacy-policy')} class="ms-1 text-mute underline hover:text-ink">{t('footer.privacy')}</a>
    </p>
  </div>
</footer>
