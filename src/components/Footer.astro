---
import { liveConverters } from '../lib/routes.js';

const links = liveConverters();
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-hairline bg-paper">
  <div class="wrap py-10">
    <div class="flex flex-wrap gap-x-12 gap-y-8">
      <div class="min-w-48 flex-1">
        <p class="text-base font-semibold text-ink">
          My<span class="text-brick">Kruti</span>Dev
        </p>
        <p class="mt-2 max-w-sm text-sm text-body">
          Hindi legacy font conversion that gets matras and conjuncts right.
          Everything runs in your browser. Your text is never uploaded.
        </p>
      </div>

      <nav aria-labelledby="footer-conv">
        <p id="footer-conv" class="text-sm font-semibold text-ink">Converters</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            links.map((p) => (
              <li>
                <a href={p.path} class="text-body no-underline hover:underline">
                  {p.h1}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/all-converters" class="text-body no-underline hover:underline">
              All converters
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-hairline-soft pt-6 text-xs text-mute">
      &copy; {year} MyKrutiDev. Kruti Dev, DevLys, Chanakya and Mangal are the
      property of their respective owners; this site is not affiliated with them.
    </p>
  </div>
</footer>
