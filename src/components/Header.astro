---
import { navMenus, getPage, isLive } from '../lib/routes.js';
import { LOCALES, LOCALE_META, splitLocale, localizePath, useT } from '../i18n/index.js';
import ThemePicker from './ThemePicker.astro';
import { badgeFor } from '../lib/newBadges.js';

// `path` is the route without any /hi prefix, so "is this the current page"
// works the same in both languages. Every href below goes through `to()`.
const { lang, path } = splitLocale(Astro.url.pathname);
const { t, render, path: to } = useT(lang);
// Nav labels name fonts ("Kruti Dev → Mangal"), so they go through render(),
// which marks the font names translate="no". Use with set:html.
const label = (p: { path: string }) => render(t(`pages.${p.path}.nav`));
const { maybe } = useT(lang);
const sub = (p: { path: string }) => maybe(`pages.${p.path}.navSub`) as string | undefined;
// "New" badges (src/lib/newBadges.js): beside a new page, and a dot on the menu that holds it.
const nb = (p: { path: string }) => badgeFor(p.path);
const menuBadge = (pages: { path: string }[]) => pages.map(nb).find(Boolean);
const anyBadge = navMenus().map((m) => menuBadge(m.pages)).find(Boolean);
const NEW = t('nav.new');
const BADGE = 'ms-2 inline-block rounded-full bg-brick px-1.5 py-0.5 align-middle text-[0.6875rem] font-semibold leading-none text-on-brick';
const DOT = 'inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-brick';

// The language switch - each entry links to THIS page in that language, never the home page.
// The 404 page has no twin - it is one file for both languages - so from
// there the switcher goes to the home page.
const switchPath = path === '/404' ? '/' : path;
const switcher = LOCALES.map((l) => ({
  lang: l,
  label: LOCALE_META[l].label,
  english: LOCALE_META[l].english,
  href: localizePath(switchPath, l),
  current: l === lang,
}));

// Three short menus of the most used pages, each ending in "See all"; every
// page of the site is on /all-converters ("All tools"). See NAV_MENUS.
const menus = navMenus();
// "/all-converters#tools" -> "/hi/all-converters/#tools": the anchor goes
// after the localized, slashed path, never inside it.
const toAnchor = (href: string) => {
  const [p, hash] = href.split('#');
  return to(p) + (hash ? `#${hash}` : '');
};
const allConverters = getPage('/all-converters');
const showAll = allConverters && isLive(allConverters);
const storePage = getPage('/store');
const showStore = storePage && isLive(storePage);

// Colour themes. The inline script in Base.astro applies them; this is only
// the control (see ThemePicker.astro).
const THEMES = ['light', 'white', 'dark', 'reading', 'contrast', 'system'] as const;
const themeStrings = {
  current: t('theme.current'),
  ...Object.fromEntries(THEMES.map((k) => [k, t(`theme.${k}`)])),
};

const isCurrent = (p: string) => p === path;
const groupHasCurrent = (pages: { path: string }[]) => pages.some((p) => isCurrent(p.path));
---

{/*
  The header must NOT establish a scroll container or a stacking context that
  traps the dropdown panels. That was the bug: `overflow-x-auto` on the nav list
  clipped every absolutely-positioned menu into a scroll box. Nothing from here
  down to the menu's offset parent may set overflow to anything but visible.
*/}
<header class="relative z-50 border-b border-hairline bg-paper">
  {/* Reserve the final control height even while the header HTML is arriving. */}
  <div class="wrap flex min-h-17 items-center justify-between gap-4 py-3 lg:min-h-15">
    {/*
      "Install app" sits right after the logo, never among the controls on the
      right: those are right-aligned, so anything appearing among them would
      push them sideways (a layout shift). Here nothing is to its right but
      free space. Phones get the same offer at the top of the menu panel.
      Hidden until the browser says the site is installable (src/scripts/app.js).
    */}
    <div class="flex shrink-0 items-center gap-3">
      <a
        href={to('/')}
        class="shrink-0 text-lg font-semibold tracking-tight text-ink no-underline"
        translate="no"
      >
        My<span class="text-brick">Kruti</span>Dev
      </a>
      <span class="mkd-install mkd-install-bar" data-install hidden>
        <button type="button" data-install-go class="mkd-install-go" title={t('app.installTitle')}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0">
            <path
              d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14.5V16h12v-1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="mkd-install-label">{t('app.install')}</span>
        </button>
        <button type="button" data-install-dismiss class="mkd-install-x" aria-label={t('app.dismiss')} title={t('app.dismiss')}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-3.5">
            <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </span>
    </div>

    <div class="flex min-w-0 items-center gap-2 lg:gap-3">

    <!-- ===================== Desktop: dropdown menubar ===================== -->
    <nav aria-label={t('nav.aria')} class="hidden lg:block" data-desktop-nav>
      <ul class="flex items-center gap-1 text-sm">
        {
          menus.map((m) => (
            <li class="relative" data-group>
              <button
                type="button"
                id={`navtrigger-${m.key}`}
                aria-expanded="false"
                aria-controls={`navmenu-${m.key}`}
                data-trigger
                class:list={[
                  'flex cursor-pointer items-center gap-1.5 rounded-(--radius-chrome) px-2.5 py-2 whitespace-nowrap',
                  groupHasCurrent(m.pages)
                    ? 'bg-inset font-medium text-ink'
                    : 'text-body hover:bg-inset hover:text-ink',
                ]}
              >
                <span class="flex items-center gap-1.5">
                  {t(`nav.menus.${m.key}`)}
                  {menuBadge(m.pages) && <span data-new-badge={menuBadge(m.pages)} class={DOT} aria-hidden="true" />}
                </span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 10 6"
                  class="h-1.5 w-2.5 shrink-0 transition-transform duration-150"
                  data-chevron
                >
                  <path
                    d="M1 1l4 4 4-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <ul
                id={`navmenu-${m.key}`}
                aria-labelledby={`navtrigger-${m.key}`}
                hidden
                data-menu
                class="absolute end-0 z-50 mt-1 min-w-64 rounded-(--radius-card) border border-hairline bg-surface p-1 shadow-menu before:absolute before:inset-x-0 before:bottom-full before:h-1"
              >
                {m.pages.map((p) => (
                  <li data-route={p.path}>
                    <a
                      href={to(p.path)}
                      data-new-link={nb(p) ?? undefined}
                      aria-current={isCurrent(p.path) ? 'page' : undefined}
                      class:list={[
                        'block rounded-(--radius-chrome) px-3 py-2.5 no-underline',
                        isCurrent(p.path)
                          ? 'bg-inset font-medium text-brick'
                          : 'text-body hover:bg-inset hover:text-ink',
                      ]}
                    >
                      <span set:html={label(p)} />
                      {nb(p) && <span data-new-badge={nb(p)} class={BADGE}>{NEW}</span>}
                      {sub(p) && <span class="block text-xs text-mute">{sub(p)}</span>}
                    </a>
                  </li>
                ))}
                <li class="mt-1 border-t border-hairline pt-1">
                  <a
                    href={toAnchor(m.all)}
                    class="block rounded-(--radius-chrome) px-3 py-2.5 font-medium text-brick no-underline hover:bg-inset"
                  >
                    {t(`nav.seeAll.${m.key}`)}
                  </a>
                </li>
              </ul>
            </li>
          ))
        }

        {
          showStore && (
            <li>
              <a
                href={to('/store')}
                aria-current={path.startsWith('/store') ? 'page' : undefined}
                class:list={[
                  'block rounded-(--radius-chrome) px-2.5 py-2 font-medium no-underline whitespace-nowrap',
                  path.startsWith('/store') ? 'bg-inset text-ink' : 'text-brick hover:bg-inset',
                ]}
              >
                {t('nav.store')}
              </a>
            </li>
          )
        }

        {
          showAll && (
            <li>
              <a
                href={to(allConverters.path)}
                aria-current={isCurrent(allConverters.path) ? 'page' : undefined}
                class:list={[
                  'block rounded-(--radius-chrome) px-2.5 py-2 no-underline whitespace-nowrap',
                  isCurrent(allConverters.path)
                    ? 'bg-inset font-medium text-ink'
                    : 'text-body hover:bg-inset hover:text-ink',
                ]}
              >
                {t('nav.allConverters')}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    {/*
      The language switch. Always in the bar, on phones too, never tucked into
      the menu: someone who cannot read the page must not have to find a
      hamburger first. Every entry links to THIS page in that language.
      `data-lang-switch` keeps Base.astro's link rewriting off it.

      Two languages fit side by side ("English | हिंदी"). More become one
      button naming the current language, opening a list of every language in
      its own script - a reader looks for "தமிழ்", not "Tamil". It is a native
      <details>, so it opens without JavaScript; the script below only closes
      it on Escape or a tap outside.

      Each label gets the same line box (leading-6) and shares a baseline.
      Without it the global [lang] line-height rules for Indian scripts gave
      "हिंदी" a taller box than "English", so it sat higher.
    */}
    {
      switcher.length <= 2 ? (
        <p
          class="flex shrink-0 items-baseline gap-1.5 text-sm whitespace-nowrap"
          role="group"
          aria-label={t('lang.switchAria')}
          translate="no"
        >
          {switcher.map((s, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="leading-6 text-mute">
                  |
                </span>
              )}
              {s.current ? (
                <span lang={s.lang} aria-current="true" class="leading-6 font-semibold text-ink">
                  {s.label}
                </span>
              ) : (
                <a
                  href={s.href}
                  lang={s.lang}
                  hreflang={s.lang}
                  data-lang-switch={s.lang}
                  class="leading-6 text-body no-underline hover:text-ink hover:underline"
                >
                  {s.label}
                </a>
              )}
            </>
          ))}
        </p>
      ) : (
        <details class="relative shrink-0" data-lang-menu translate="no">
          <summary
            class="flex cursor-pointer list-none items-center gap-1.5 rounded-(--radius-chrome) px-2 py-1.5 text-sm text-body hover:bg-inset hover:text-ink [&::-webkit-details-marker]:hidden"
            aria-label={`${t('lang.switchAria')}: ${LOCALE_META[lang].label}`}
          >
            <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0">
              <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M2.75 10h14.5M10 2.75c2 2.1 3 4.5 3 7.25s-1 5.15-3 7.25M10 2.75c-2 2.1-3 4.5-3 7.25s1 5.15 3 7.25"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
            <span lang={lang} class="leading-6 font-medium text-ink">{LOCALE_META[lang].label}</span>
            <svg aria-hidden="true" viewBox="0 0 10 6" class="h-1.5 w-2.5 shrink-0">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul
            role="list"
            class="absolute end-0 z-50 mt-1 min-w-48 rounded-(--radius-card) border border-hairline bg-surface p-1 shadow-menu"
          >
            {switcher.map((s) => (
              <li>
                <a
                  href={s.href}
                  lang={s.lang}
                  hreflang={s.lang}
                  data-lang-switch={s.lang}
                  aria-current={s.current ? 'true' : undefined}
                  class:list={[
                    'flex items-baseline justify-between gap-4 rounded-(--radius-chrome) px-3 py-2 no-underline',
                    s.current ? 'bg-inset font-medium text-brick' : 'text-body hover:bg-inset hover:text-ink',
                  ]}
                >
                  <span class="leading-6">{s.label}</span>
                  {s.lang !== 'en' && <span lang="en" class="text-xs text-mute">{s.english}</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {/*
      Theme switcher (desktop). The icon shows the theme in effect - with
      "System" that is light or dark, from the device. On phones the same
      choice sits in the menu panel instead, where there is room for words.
    */}
    <div class="relative hidden lg:block" data-theme-switch data-i18n={JSON.stringify(themeStrings)}>
      <button
        type="button"
        id="theme-trigger"
        data-theme-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="theme-panel"
        aria-label={t('theme.label')}
        title={t('theme.label')}
        class="grid size-9 cursor-pointer place-items-center rounded-(--radius-chrome) text-body hover:bg-inset hover:text-ink"
      >
        <svg data-theme-icon="light" aria-hidden="true" viewBox="0 0 20 20" class="size-5">
          <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path
            d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <svg data-theme-icon="dark" aria-hidden="true" viewBox="0 0 20 20" class="size-5">
          <path
            d="M16.5 12.2A6.75 6.75 0 0 1 7.8 3.5a6.75 6.75 0 1 0 8.7 8.7z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
        <svg data-theme-icon="reading" aria-hidden="true" viewBox="0 0 20 20" class="size-5">
          <path
            d="M10 5.5C8.5 4.3 6.3 3.75 3 3.75v11.5c3.3 0 5.5.55 7 1.75 1.5-1.2 3.7-1.75 7-1.75V3.75c-3.3 0-5.5.55-7 1.75zM10 5.5V17"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
        <svg data-theme-icon="contrast" aria-hidden="true" viewBox="0 0 20 20" class="size-5">
          <circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.75" />
          <path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor" />
        </svg>
      </button>
      <div
        id="theme-panel"
        role="dialog"
        aria-label={t('theme.panelAria')}
        hidden
        data-theme-panel
        class="absolute end-0 z-50 mt-1 w-[22rem] rounded-(--radius-card) border border-hairline bg-surface p-3 shadow-menu"
      >
        <ThemePicker uid="tpd" />
      </div>
    </div>

    <!-- ===================== Mobile: hamburger ===================== -->
    <button
      type="button"
      data-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="relative -me-1 grid size-11 shrink-0 place-items-center rounded-(--radius-chrome) text-ink lg:hidden"
    >
      <span class="sr-only">{t('nav.menu')}</span>
      {anyBadge && <span data-new-badge={anyBadge} class={`absolute end-2 top-2 ${DOT}`} aria-hidden="true" />}
      <svg aria-hidden="true" viewBox="0 0 20 20" class="size-6" data-burger-icon>
        <path
          d="M3 5h14M3 10h14M3 15h14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
      </svg>
    </button>
    </div>
  </div>

  <!-- Mobile panel: accordion sections, no hover menus. -->
  <nav
    id="mobile-nav"
    aria-label={t('nav.aria')}
    hidden
    data-mobile-nav
    class="border-t border-hairline bg-surface lg:hidden"
  >
    <ul class="wrap divide-y divide-hairline-soft py-1">
      {/* The same offer as the desktop bar's, where a phone has room for it. */}
      <li class="mkd-install mkd-install-panel" data-install hidden>
        <button type="button" data-install-go class="btn btn-outline flex-1 gap-2">
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0">
            <path
              d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14.5V16h12v-1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {t('app.install')}
        </button>
        <button type="button" data-install-dismiss class="mkd-install-x size-11" aria-label={t('app.dismiss')} title={t('app.dismiss')}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4">
            <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </li>
      {
        menus.map((m) => (
          <li>
            <details data-acc class="group">
              <summary
                class:list={[
                  'flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 py-3 text-base marker:hidden',
                  groupHasCurrent(m.pages) ? 'font-medium text-ink' : 'text-body',
                ]}
              >
                <span class="flex items-center gap-1.5">
                  {t(`nav.menus.${m.key}`)}
                  {menuBadge(m.pages) && <span data-new-badge={menuBadge(m.pages)} class={DOT} aria-hidden="true" />}
                </span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 10 6"
                  class="h-2 w-3.5 shrink-0 text-mute transition-transform duration-150 group-open:rotate-180"
                >
                  <path
                    d="M1 1l4 4 4-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>

              <ul class="pb-2">
                {m.pages.map((p) => (
                  <li data-route={p.path}>
                    <a
                      href={to(p.path)}
                      data-new-link={nb(p) ?? undefined}
                      aria-current={isCurrent(p.path) ? 'page' : undefined}
                      class:list={[
                        'flex min-h-11 flex-col justify-center rounded-(--radius-chrome) px-3 py-2.5 no-underline',
                        isCurrent(p.path) ? 'bg-inset font-medium text-brick' : 'text-body',
                      ]}
                    >
                      <span class="flex items-center">
                        <span class="text-base" set:html={label(p)} />
                        {nb(p) && <span data-new-badge={nb(p)} class={BADGE}>{NEW}</span>}
                      </span>
                      {sub(p) && <span class="text-xs text-mute">{sub(p)}</span>}
                    </a>
                  </li>
                ))}
                <li>
                  <a
                    href={toAnchor(m.all)}
                    class="flex min-h-11 items-center rounded-(--radius-chrome) px-3 py-2.5 font-medium text-brick no-underline"
                  >
                    {t(`nav.seeAll.${m.key}`)}
                  </a>
                </li>
              </ul>
            </details>
          </li>
        ))
      }

      {
        showStore && (
          <li>
            <a
              href={to('/store')}
              aria-current={path.startsWith('/store') ? 'page' : undefined}
              class="flex min-h-11 items-center py-3 text-base font-medium text-brick no-underline"
            >
              {t('nav.store')}
            </a>
          </li>
        )
      }

      {
        showAll && (
          <li>
            <a
              href={to(allConverters.path)}
              aria-current={isCurrent(allConverters.path) ? 'page' : undefined}
              class:list={[
                'flex min-h-11 items-center py-3 text-base no-underline',
                isCurrent(allConverters.path)
                  ? 'font-medium text-brick'
                  : 'text-body',
              ]}
            >
              {t('nav.allConverters')}
            </a>
          </li>
        )
      }

      {/* Theme and accent, phones only: the same picker as the desktop panel. */}
      <li class="py-3" aria-label={t('theme.panelAria')} role="group">
        <ThemePicker uid="tpm" />
      </li>
    </ul>
  </nav>
</header>

<style>
  @reference '../styles/global.css';

  /* The one shadow in the system. docs/DESIGN.md is otherwise flat, but a menu that
     floats over content needs to read as floating - a hairline alone leaves it
     ambiguous against the card borders underneath. */
  .shadow-menu {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-shadow) 6%, transparent),
      0 8px 24px -6px color-mix(in srgb, var(--color-shadow) 16%, transparent);
  }

  [data-trigger][aria-expanded='true'] [data-chevron] {
    transform: rotate(180deg);
  }

  /* The trigger shows the icon of the theme in effect: sun for Light and
     White, moon for Dark, book for Reading, half-disc for High
     contrast. */
  [data-theme-icon] {
    display: none;
  }
  :global(html:not([data-theme])) [data-theme-icon='light'],
  :global(html:is([data-theme='light'], [data-theme='white'])) [data-theme-icon='light'],
  :global(html[data-theme='dark']) [data-theme-icon='dark'],
  :global(html[data-theme='reading']) [data-theme-icon='reading'],
  :global(html[data-theme='contrast']) [data-theme-icon='contrast'] {
    display: block;
  }
</style>

<script>
  // The service worker and the "Install app" button. Here because the header
  // is on every page and so is this script.
  import '../scripts/app.js';

  // Progressive enhancement. With JS off the desktop menus stay closed, so the
  // mobile accordion (native <details>) and /all-converters remain the way in.
  const nav = document.querySelector<HTMLElement>('[data-desktop-nav]');

  type Group = {
    root: HTMLElement;
    trigger: HTMLButtonElement;
    menu: HTMLElement;
    items: HTMLAnchorElement[];
  };

  const groups: Group[] = nav
    ? [...nav.querySelectorAll<HTMLElement>('[data-group]')].map((root) => ({
        root,
        trigger: root.querySelector<HTMLButtonElement>('[data-trigger]')!,
        menu: root.querySelector<HTMLElement>('[data-menu]')!,
        // Only real links are focusable; "soon" rows are inert by design.
        items: [...root.querySelectorAll<HTMLAnchorElement>('[data-menu] a')],
      }))
    : [];

  // Hover-to-open is a desktop affordance only: on a touch screen the first tap
  // would open a menu and the second would be needed to follow the link.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  type Point = { x: number; y: number };
  /** The last point the pointer was over the open menu (button or list); see Hover below. */
  let aimFrom: Point | null = null;
  /** When each menu was last opened by hover (see the trigger's click). */
  const hoverOpenedAt = new Map<Group, number>();

  // ---- Mobile panel. Declared up here because the shared Escape and
  // click-outside handlers below close the desktop menus and this panel.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const mobile = document.querySelector<HTMLElement>('[data-mobile-nav]');

  const BURGER_ICON = 'M3 5h14M3 10h14M3 15h14';
  const CLOSE_ICON = 'M4 4l12 12M16 4L4 16';

  function setBurger(open: boolean) {
    if (!burger || !mobile) return;
    mobile.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger
      .querySelector('[data-burger-icon] path')
      ?.setAttribute('d', open ? CLOSE_ICON : BURGER_ICON);
  }

  const openMobile = () => setBurger(true);

  function closeMobile({ focusBurger = false } = {}) {
    setBurger(false);
    if (focusBurger) burger?.focus();
  }

  function open(g: Group, focusItem?: 'first' | 'last') {
    clearTimeout(closeTimer);
    closeTimer = undefined;
    // Set again by hoverOpen(), or once the pointer is over this menu.
    aimFrom = null;
    // One menu at a time: a dropdown opening closes the theme panel too.
    closeTheme();
    for (const other of groups) if (other !== g) close(other);
    g.menu.hidden = false;
    g.trigger.setAttribute('aria-expanded', 'true');
    if (focusItem === 'first') g.items[0]?.focus();
    if (focusItem === 'last') g.items.at(-1)?.focus();
  }

  function close(g: Group) {
    g.menu.hidden = true;
    g.trigger.setAttribute('aria-expanded', 'false');
  }

  const closeAll = () => groups.forEach(close);
  // Tablets use the compact panel; reset open menus when changing layouts.
  window.matchMedia('(min-width: 64rem)').addEventListener('change', () => {
    closeAll();
    closeMobile();
  });
  const isOpen = (g: Group) => !g.menu.hidden;

  for (const g of groups) {
    g.trigger.addEventListener('click', () => {
      // A mouse opens the menu on hover a moment before the click lands; that
      // click must not immediately shut what the visitor is reaching for.
      if (isOpen(g) && Date.now() - (hoverOpenedAt.get(g) ?? 0) < 400) return;
      isOpen(g) ? close(g) : open(g);
    });

    g.trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        open(g, 'first');
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        open(g, 'last');
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        // Move along the menubar, the way a native menu behaves.
        e.preventDefault();
        const i = groups.indexOf(g);
        const next =
          e.key === 'ArrowRight'
            ? groups[(i + 1) % groups.length]
            : groups[(i - 1 + groups.length) % groups.length];
        closeAll();
        next.trigger.focus();
      }
    });

    // Roving focus inside an open menu.
    g.menu.addEventListener('keydown', (e) => {
      const i = g.items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        g.items[(i + 1) % g.items.length]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        g.items[(i - 1 + g.items.length) % g.items.length]?.focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        g.items[0]?.focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        g.items.at(-1)?.focus();
      }
    });

  }

  // ---- Hover (a mouse on a desktop). One mousemove listener decides it all,
  // so a slow hand behaves exactly like a quick one:
  //  - Each list has an invisible strip above it (the `before:` classes) that
  //    fills the gap to its button, so crossing the gap never counts as leaving.
  //  - Pointing back at the open menu always cancels a pending close.
  //  - Heading for the open list across a neighbouring button does not switch
  //    menus ("menu aim"): while the pointer stays inside the triangle from the
  //    last point it was on the menu to the list's top corners, the menu stays.
  //    Resting on that neighbour for a moment opens it as usual.
  // It is always attached and checks canHover inside, so a hybrid laptop that
  // gains or loses a mouse behaves correctly without a reload.
  const byRoot = new Map(groups.map((g) => [g.root, g]));
  let restTimer: ReturnType<typeof setTimeout> | undefined;
  /** The group under the pointer on the previous move: hover opens on entering one. */
  let lastOver: Group | null = null;

  const cancelClose = () => {
    clearTimeout(closeTimer);
    closeTimer = undefined;
  };
  const scheduleClose = (g: Group) => {
    if (closeTimer !== undefined) return;
    closeTimer = setTimeout(() => {
      closeTimer = undefined;
      close(g);
    }, 300);
  };

  function hoverOpen(g: Group, at: Point) {
    open(g);
    hoverOpenedAt.set(g, Date.now());
    aimFrom = at;
  }

  /** Twice the signed area of triangle abc: which side of ab the point c is on. */
  const side = (a: Point, b: Point, c: Point) => (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);

  /** Is the pointer on its way from `from` into g's list? */
  function aiming(g: Group, from: Point, p: Point) {
    const r = g.menu.getBoundingClientRect();
    const left = { x: r.left - 8, y: r.top };
    const right = { x: r.right + 8, y: r.top };
    const s1 = side(from, left, p);
    const s2 = side(left, right, p);
    const s3 = side(right, from, p);
    return (s1 >= 0 && s2 >= 0 && s3 >= 0) || (s1 <= 0 && s2 <= 0 && s3 <= 0);
  }

  /** The pointer is off the open menu and not heading for it: act on where it is. */
  function settle(over: Group | null, at: Point) {
    const current = groups.find(isOpen);
    if (over && over !== current) hoverOpen(over, at);
    else if (!over && current) scheduleClose(current);
  }

  document.addEventListener(
    'mousemove',
    (e) => {
      if (!canHover.matches) return;
      const p = { x: e.clientX, y: e.clientY };
      const root = (e.target as Element | null)?.closest?.<HTMLElement>('[data-group]');
      const over = (root && byRoot.get(root)) ?? null;
      // Only on the way in, so a menu just closed with a click or Escape does
      // not spring open again under a pointer that is still on its button.
      const entered = over !== lastOver ? over : null;
      lastOver = over;
      const current = groups.find(isOpen);
      clearTimeout(restTimer);
      if (!current) {
        if (entered) hoverOpen(entered, p);
        return;
      }
      if (over === current) {
        cancelClose();
        aimFrom = p;
        return;
      }
      if (!aimFrom) {
        // Opened from the keyboard or by a click, and the pointer has not been
        // over it since: it stays open until pointed at or dismissed.
        if (entered) hoverOpen(entered, p);
        return;
      }
      if (aiming(current, aimFrom, p)) {
        cancelClose();
        // A pointer that stops here meant this spot, not the list.
        restTimer = setTimeout(() => settle(over, p), 250);
        return;
      }
      settle(over, p);
    },
    { passive: true },
  );
  // Leaving the window altogether closes a hover menu too.
  document.documentElement.addEventListener('mouseleave', () => {
    if (!canHover.matches) return;
    clearTimeout(restTimer);
    lastOver = null;
    const current = groups.find(isOpen);
    if (current) scheduleClose(current);
  });

  // Click outside closes. Pointerdown, so it fires before focus moves.
  document.addEventListener('pointerdown', (e) => {
    const t = e.target as Element | null;
    if (!t?.closest('[data-group]')) closeAll();
  });

  // Escape closes whatever is open and hands focus back to its trigger.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const opened = groups.find(isOpen);
    if (opened) {
      close(opened);
      opened.trigger.focus();
      return;
    }
    if (mobile && !mobile.hidden) closeMobile({ focusBurger: true });
  });

  // Tabbing out of a menu closes it, without stealing the Tab itself.
  document.addEventListener('focusin', (e) => {
    const t = e.target as Element | null;
    for (const g of groups) {
      if (isOpen(g) && !g.root.contains(t)) close(g);
    }
  });

  burger?.addEventListener('click', () => {
    if (mobile?.hidden) openMobile();
    else closeMobile();
  });

  // Tapping the page behind the open panel closes it.
  document.addEventListener('pointerdown', (e) => {
    if (!mobile || mobile.hidden) return;
    const t = e.target as Element | null;
    if (!t?.closest('[data-mobile-nav]') && !t?.closest('[data-burger]')) {
      closeMobile();
    }
  });

  // The language list closes on Escape and on a tap anywhere else.
  const langMenu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  if (langMenu) {
    document.addEventListener('pointerdown', (e) => {
      if (langMenu.open && !(e.target as Element | null)?.closest('[data-lang-menu]')) langMenu.open = false;
    });
    langMenu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langMenu.open) {
        langMenu.open = false;
        langMenu.querySelector('summary')?.focus();
      }
    });
  }

  // Remember an explicit language choice, from the header switch or the
  // "also available in ..." banner. It only ever silences the banner - the
  // site never redirects on it. Same key as LANG_PREF_KEY in src/i18n.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLElement>('[data-lang-switch]');
    if (!a) return;
    try {
      localStorage.setItem('mkd-lang', a.dataset.langSwitch!);
    } catch {
      // Blocked storage: the choice is not remembered. Harmless.
    }
  });

  // ---- Theme and accent. The inline script in Base.astro owns the state
  // (window.mkdTheme) and fires `mkd:theme` whenever it changes; this draws
  // both pickers (desktop panel, phone menu) and handles their keys.
  type ThemeApi = {
    get(): string;
    accent(): string;
    set(p: string): void;
    setAccent(a: string): void;
  };
  const themeApi = (window as unknown as { mkdTheme?: ThemeApi }).mkdTheme;
  const themeSwitch = document.querySelector<HTMLElement>('[data-theme-switch]');
  const themeTrigger = document.querySelector<HTMLButtonElement>('[data-theme-trigger]');
  const themePanel = document.querySelector<HTMLElement>('[data-theme-panel]');
  const themeL: Record<string, string> = JSON.parse(themeSwitch?.dataset.i18n || '{}');
  const pickerGroups = [...document.querySelectorAll<HTMLElement>('[data-picker-group]')];
  const optionsOf = (g: HTMLElement) => [...g.querySelectorAll<HTMLButtonElement>('[role="radio"]')];

  function drawTheme() {
    if (!themeApi) return;
    const current = { theme: themeApi.get(), accent: themeApi.accent() };
    for (const g of pickerGroups) {
      const value = current[g.dataset.pickerGroup as 'theme' | 'accent'];
      for (const b of optionsOf(g)) {
        const on = b.dataset.value === value;
        b.setAttribute('aria-checked', String(on));
        // Roving tabindex: Tab lands on the chosen option, arrows move on.
        b.tabIndex = on ? 0 : -1;
      }
    }
    themeTrigger?.setAttribute(
      'aria-label',
      (themeL.current ?? '{name}').replace('{name}', themeL[current.theme] ?? current.theme),
    );
  }

  const themeOpen = () => !!themePanel && !themePanel.hidden;
  function openTheme(focusChecked: boolean) {
    if (!themePanel || !themeTrigger) return;
    closeAll();
    themePanel.hidden = false;
    themeTrigger.setAttribute('aria-expanded', 'true');
    if (focusChecked) themePanel.querySelector<HTMLElement>('[role="radio"][aria-checked="true"]')?.focus();
  }
  function closeTheme(focusTrigger = false) {
    if (!themePanel || !themeTrigger || themePanel.hidden) return;
    themePanel.hidden = true;
    themeTrigger.setAttribute('aria-expanded', 'false');
    if (focusTrigger) themeTrigger.focus();
  }

  if (themeApi) {
    drawTheme();
    document.addEventListener('mkd:theme', drawTheme);

    for (const g of pickerGroups) {
      const isTheme = g.dataset.pickerGroup === 'theme';
      for (const b of optionsOf(g)) {
        b.addEventListener('click', () => {
          const v = b.dataset.value!;
          // The desktop panel closes at once, before the switch, so its own
          // repaint is not part of it. (The phone menu stays open.)
          if (themePanel?.contains(b)) closeTheme(true);
          if (isTheme) themeApi.set(v);
          else themeApi.setAccent(v);
        });
      }
      // Arrows move focus within the group; Enter or Space (the button's own
      // click) picks. Up/down step a whole row in the card grid.
      g.addEventListener('keydown', (e) => {
        const opts = optionsOf(g);
        const i = opts.indexOf(document.activeElement as HTMLButtonElement);
        if (i < 0) return;
        const cols = isTheme ? getComputedStyle(g).gridTemplateColumns.split(' ').length : 1;
        const step: Record<string, number> = {
          ArrowRight: 1,
          ArrowLeft: -1,
          ArrowDown: isTheme ? cols : 1,
          ArrowUp: isTheme ? -cols : -1,
        };
        let n: number | undefined;
        if (e.key in step) n = Math.min(opts.length - 1, Math.max(0, i + step[e.key]));
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = opts.length - 1;
        if (n === undefined) return;
        e.preventDefault();
        for (const o of opts) o.tabIndex = -1;
        opts[n].tabIndex = 0;
        opts[n].focus();
      });
    }

    themeTrigger?.addEventListener('click', () => (themeOpen() ? closeTheme() : openTheme(true)));
    themeTrigger?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        openTheme(true);
      }
    });
    themePanel?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        closeTheme(true);
      }
    });
    // Tabbing out of the panel closes it. (No relatedTarget means a click on
    // the panel's own padding - the pointerdown below handles real outside
    // clicks.)
    themeSwitch?.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (to && !themeSwitch.contains(to)) closeTheme();
    });
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target as Element | null)?.closest('[data-theme-switch]')) closeTheme();
    });
  }

  // One accordion section at a time, so the panel stays short on a phone.
  const accordions = document.querySelectorAll<HTMLDetailsElement>('[data-acc]');
  for (const d of accordions) {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      for (const other of accordions) if (other !== d) other.open = false;
    });
  }
</script>
