---
import '../styles/global.css';
// The same hashed file global.css points at, so the preload is reused, not
// fetched twice. See the @font-face note in global.css.
import devanagari400 from '@fontsource/noto-sans-devanagari/files/noto-sans-devanagari-devanagari-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Feedback from '../components/Feedback.astro';
import { SITE, CONTACT_EMAIL, getPage, isLive } from '../lib/routes.js';
import { analyticsScript } from '../lib/analytics.js';
import { ogImagePath, OG_SIZE } from '../lib/og.js';
import {
  LOCALES,
  DEFAULT_LOCALE,
  LOCALE_META,
  splitLocale,
  localizePath,
  localizeHtml,
  useT,
} from '../i18n/index.js';

interface Props {
  title: string;
  description: string;
  /** Stub pages pass true: noindex + kept out of the sitemap. */
  noindex?: boolean;
  /**
   * The trail between Home and this page, route paths without a language
   * prefix: [{ name: 'Guides', path: '/guides' }]. This page itself is added
   * last, named by `crumb` (default: its h1). Home gets no visible trail.
   */
  trail?: { name: string; path: string }[];
  crumb?: string;
  /** Extra JSON-LD for this page (an Article, say). */
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** The 404 page: no canonical, no language alternates, never indexed. */
  notFound?: boolean;
}

const {
  title,
  description,
  noindex = false,
  trail = [],
  crumb,
  jsonLd = [],
  ogType = 'website',
  notFound = false,
} = Astro.props;

// The locale comes from the URL, so a page never has to be told which one it
// is in: /hi/... is Hindi, everything else is English.
const { lang, path } = splitLocale(Astro.url.pathname);
const { t } = useT(lang);
const meta = LOCALE_META[lang];
const page = getPage(path);

const abs = (p: string) => new URL(p, SITE).href;

// Self-canonical unless routes.js says otherwise. The override exists for a
// page that is genuinely useful but duplicates a conversion already published
// at another path - it stays crawlable and points the ranking signal there
// rather than competing with itself. Either way the canonical stays in THIS
// page's language: a Hindi page never canonicalises to an English one.
const selfUrl = abs(localizePath(path, lang));
const canonical = page?.canonical ? abs(localizePath(page.canonical, lang)) : selfUrl;

// Every language version of this route, plus x-default (= English).
const alternates = [
  ...LOCALES.map((l) => ({ hreflang: LOCALE_META[l].hreflang, href: abs(localizePath(path, l)) })),
  { hreflang: 'x-default', href: abs(localizePath(path, DEFAULT_LOCALE)) },
];

const h1 = page ? t(`pages.${page.path}.h1`) : title;
const plain = (s: string) => s.replace(/<[^>]+>/g, '').trim();

// Home › (trail) › this page. Visible above the page and published as
// BreadcrumbList, from the same list.
const crumbs = [
  { name: t('nav.home'), path: '/' },
  ...trail,
  ...(path === '/' ? [] : [{ name: crumb ?? h1, path }]),
];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: plain(c.name),
    item: abs(localizePath(c.path, lang)),
  })),
};

// Who publishes the site, and the site itself - on the home page only.
const homeUrl = abs(localizePath('/', lang));
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'MyKrutiDev',
  url: `${SITE}/`,
  logo: abs('/og/logo.png'),
  email: CONTACT_EMAIL,
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: CONTACT_EMAIL, availableLanguage: ['en', 'hi'] },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  name: 'MyKrutiDev',
  url: homeUrl,
  inLanguage: meta.htmlLang,
  publisher: { '@id': `${SITE}/#organization` },
};

const ogImage = abs(ogImagePath(path, lang));
const ogAlt = plain(h1);

// WebApplication only where there is an application: a live page with a tool
// (a converter, a typing tool, a page that embeds one, or the hub that
// converts). Lists, articles and coming-soon pages carry the breadcrumb alone.
const isTool =
  !!page && isLive(page) && (page.kind === 'converter' || !!page.tool || !!page.app || !!(page.from && page.to));
const app = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: page ? h1 : 'MyKrutiDev',
  url: selfUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description,
  inLanguage: ['hi', 'en'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

// The page body is rendered first and then its internal links are pointed at
// this language, so a link written anywhere - a component, routes.js or a
// translated paragraph - keeps a Hindi reader on Hindi pages.
const body = localizeHtml(await Astro.slots.render('default'), lang);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Google Analytics, on the live site only (src/lib/analytics.js). */}
    <script is:inline set:html={analyticsScript()} />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="preload" href={devanagari400} as="font" type="font/woff2" crossorigin />

    {/*
      Theme: runs before the first paint, so a dark or reading page never
      flashes light. Resolves "system" from prefers-color-scheme and follows
      the device live; the header switcher calls window.mkdTheme.set().
      BAR must match --color-paper per theme in global.css (tests/dist and
      e2e/theme.spec.js check it).
    */}
    <script is:inline>
      (function () {
        var BAR = {
          light: '#faf7f2',
          white: '#ffffff',
          dark: '#151618',
          reading: '#f4ecd8',
          contrast: '#000000',
        };
        var PREFS = /^(light|white|dark|reading|contrast|system)$/;
        var ACCENTS = /^(terracotta|blue|green|purple|teal)$/;
        var root = document.documentElement;
        var dark = window.matchMedia('(prefers-color-scheme: dark)');
        function load(key, ok, fallback) {
          try {
            var v = localStorage.getItem(key);
            return v && ok.test(v) ? v : fallback;
          } catch (e) {
            return fallback;
          }
        }
        function save(key, v) {
          try {
            localStorage.setItem(key, v);
          } catch (e) {}
        }
        var pref = load('mkd-theme', PREFS, 'system');
        var accent = load('mkd-accent', ACCENTS, 'terracotta');
        function apply() {
          var theme = pref === 'system' ? (dark.matches ? 'dark' : 'light') : pref;
          root.setAttribute('data-theme', theme);
          root.setAttribute('data-theme-pref', pref);
          root.setAttribute('data-accent', accent);
          var bar = document.querySelector('meta[name="theme-color"]');
          if (bar) bar.setAttribute('content', BAR[theme]);
          document.dispatchEvent(
            new CustomEvent('mkd:theme', { detail: { pref: pref, theme: theme, accent: accent } }),
          );
        }
        // A visitor's switch: only the two attributes on <html> change - every
        // colour is a CSS variable, so there is no loop over elements. While
        // the new colours are applied, .theme-switching turns every transition
        // off (themes.css), so the keys' own colour transitions do not all
        // fire at once; it comes off two frames later, once the new colours
        // are in. Where supported, the change runs in a View Transition - one
        // ~150 ms cross-fade of the whole page on the GPU. Reduced motion, or
        // no support: instant.
        var still = window.matchMedia('(prefers-reduced-motion: reduce)');
        var noop = function () {};
        var turn = 0;
        function change(apply, after) {
          var mine = ++turn;
          // The class goes on with the new attributes, in the same style pass:
          // added earlier, it would cost a restyle of its own while the View
          // Transition captures the old page.
          function update() {
            root.classList.add('theme-switching');
            apply();
          }
          function done() {
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                if (mine === turn) root.classList.remove('theme-switching');
              });
            });
            if (after) after();
          }
          if (document.startViewTransition && !still.matches && !document.hidden) {
            var vt = document.startViewTransition(update);
            // A quick second switch skips the first transition; that is fine.
            vt.ready.catch(noop);
            vt.finished.catch(noop);
            vt.updateCallbackDone.then(done, done);
          } else {
            update();
            done();
          }
        }
        function onDevice() {
          if (pref === 'system') change(apply);
        }
        if (dark.addEventListener) dark.addEventListener('change', onDevice);
        else if (dark.addListener) dark.addListener(onDevice);
        window.mkdTheme = {
          get: function () {
            return pref;
          },
          accent: function () {
            return accent;
          },
          set: function (p) {
            if (!PREFS.test(p) || p === pref) return;
            pref = p;
            // Stored after the switch, off the path to the new colours.
            change(apply, function () {
              save('mkd-theme', p);
            });
          },
          setAccent: function (a) {
            if (!ACCENTS.test(a) || a === accent) return;
            accent = a;
            change(apply, function () {
              save('mkd-accent', a);
            });
          },
        };
        apply();
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {/* Installable app. The Hindi manifest opens the app on /hi. */}
    <link rel="manifest" href={lang === 'hi' ? '/hi/manifest.json' : '/manifest.json'} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {(noindex || notFound) && <meta name="robots" content="noindex,follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MyKrutiDev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={selfUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      LOCALES.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {isTool && <script type="application/ld+json" set:html={JSON.stringify(app)} />}
    {path === '/' && !notFound && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
    {path === '/' && !notFound && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {!notFound && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-(--radius-chrome) focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >{t('meta.skipLink')}</a
    >
    <Header />
    {lang === DEFAULT_LOCALE && !notFound && <LangBanner path={path} />}
    <main id="main" class="flex-1">
      {!notFound && crumbs.length > 1 && (
        <Breadcrumbs items={crumbs.map((c) => ({ name: c.name, href: localizePath(c.path, lang) }))} />
      )}
      <Fragment set:html={body} />
    </main>
    <Footer />
    <Feedback />
  </body>
</html>
