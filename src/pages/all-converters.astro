---
import Base from '../layouts/Base.astro';
import { getPage, allGroups } from '../lib/routes.js';

const page = getPage('/all-converters')!;
const groups = allGroups();

const total = groups.reduce((n, g) => n + g.pages.length, 0);
const liveCount = groups.reduce(
  (n, g) => n + g.pages.filter((p) => p.live).length,
  0,
);
---

<Base title={page.title} description={page.description}>
  <div class="wrap py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl">{page.h1}</h1>
    <p class="mt-3 max-w-2xl text-base text-body">
      Every conversion on the site, grouped by source font. {liveCount} of {total}
      are live; the rest are scaffolded and waiting on a verified character map.
    </p>

    {
      groups.map((g) => (
        <section class="mt-10">
          <h2 class="text-xl">{g.name}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {g.pages.map((p) => (
              <li>
                <a
                  href={p.path}
                  class="flex h-full flex-col card p-4 no-underline transition-colors hover:border-saffron"
                >
                  <span class="flex items-start justify-between gap-3">
                    <span class="font-medium text-ink">{p.h1}</span>
                    <span
                      class:list={[
                        'mt-0.5 shrink-0 rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap',
                        p.live
                          ? 'bg-inset text-ok'
                          : 'bg-warn-bg text-saffron',
                      ]}
                    >
                      {p.live ? 'Live' : 'Coming soon'}
                    </span>
                  </span>
                  <span class="mt-1.5 text-sm text-body">{p.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="prose-page mt-14 text-body">
      <h2>Why some of these are not switched on</h2>
      <p>
        A legacy Hindi font is not an encoding. It is a font whose glyphs happen
        to sit on ASCII codepoints, and every vendor arranged them differently.
        Converting one correctly means knowing exactly which key carried which
        letter, and that has to come from real documents. It cannot be inferred.
      </p>
      <p>
        So the pages above exist, with their titles and descriptions, but the
        ones marked <strong>Coming soon</strong> deliberately have no converter
        on them. A converter built on a guessed map produces Hindi that looks
        plausible and is quietly wrong in ways you would only find out later,
        which is worse than no converter at all.
      </p>

      <h2>&ldquo;Hindi&rdquo; and &ldquo;Unicode&rdquo; mean the same thing here</h2>
      <p>
        Text typed on an Android, iPhone or Windows Hindi keypad
        <em>is already Unicode</em>. So &ldquo;Hindi to Kruti Dev&rdquo; and
        &ldquo;Unicode to Kruti Dev&rdquo; are the same conversion and the same
        page, <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev</a>. Mangal
        is a Unicode font too, which is why
        <a href="/kruti-dev-to-mangal">Kruti Dev to Mangal</a> really means
        &ldquo;Kruti Dev to Unicode, shown in Mangal&rdquo;.
      </p>
    </div>
  </div>
</Base>
