---
import ConverterPage from '../components/ConverterPage.astro';
---

<ConverterPage
  path="/chanakya-to-unicode"
  lede="Convert Chanakya font Hindi to Unicode, entirely in your browser."
  faq={[]}
>
  <h2>Coming in phase 2</h2>
  <p>
    Chanakya uses a different glyph layout from Kruti Dev, and its map has not
    been built from real documents yet. Until it has been checked, this pair
    stays switched off.
  </p>
  <p>
    The <a href="/">Kruti Dev to Unicode converter</a> is finished and tested if
    that is the font you actually have.
  </p>
</ConverterPage>
