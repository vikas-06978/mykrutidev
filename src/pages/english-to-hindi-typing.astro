---
import Base from '../layouts/Base.astro';
import Transliterator from '../components/Transliterator.astro';
import Faq from '../components/Faq.astro';
import { getPage } from '../lib/routes.js';

const page = getPage('/english-to-hindi-typing');

const faq = [
  {
    q: 'How do I type Hindi in English letters?',
    a: 'Type the word the way it sounds and the Hindi appears as you type. <code>namaste</code> becomes <span lang="hi">नमस्ते</span>, <code>bharat</code> becomes <span lang="hi">भारत</span>, <code>main ghar ja raha hu</code> becomes <span lang="hi">मैं घर जा रहा हूँ</span>. There is no Convert button and nothing to install.',
  },
  {
    q: 'Is this English to Hindi typing tool free?',
    a: 'Yes, completely. No signup, no character limit, no paid tier. It is a static page that runs in your browser, so there is nothing to charge for.',
  },
  {
    q: 'Does it translate English into Hindi?',
    a: 'No, and the difference matters. This is <strong>transliteration</strong>, not translation: it writes the sound of what you typed in Devanagari. Type <code>computer</code> and you get <span lang="hi">कंप्यूटर</span>, not <span lang="hi">संगणक</span>. If you want the meaning changed rather than the script, you need a translator.',
  },
  {
    q: 'Why did a word come out with the wrong vowel?',
    a: 'Because English spelling does not record vowel length. One <code>a</code> stands for both <span lang="hi">अ</span> and <span lang="hi">आ</span>, and nothing in <code>bharat</code> says which one is long. Google\'s Hindi input service resolves most of these from context, and the built-in dictionary covers the common words if it cannot be reached - but neither is perfect on rare words and names. Doubling the vowel fixes it: write <code>bhaarat</code>, <code>kitaab</code>, <code>suuraj</code>.',
  },
  {
    q: 'What is the Exact (ITRANS) mode for?',
    a: 'It turns the guessing off. ITRANS is a precise notation where <code>aa ii uu</code> are the long vowels, capitals <code>T D N S</code> are the retroflex consonants, and <code>.n</code> is the anusvara. Nothing is inferred, so the output is always exactly what you wrote - <code>raaShTriiya</code> gives <span lang="hi">राष्ट्रीय</span> every time. Useful for names, Sanskrit and anything that has to be right the first time.',
  },
  {
    q: 'Can I get Kruti Dev instead of Unicode?',
    a: 'This page writes Unicode Hindi only. Copy it and paste it into the <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev converter</a>, which gives you the Kruti Dev code for MS Word.',
  },
  {
    q: 'A word came out wrong. Can I pick a different spelling?',
    a: 'Yes. Tap or click the word in the Hindi box and up to five spellings appear under it. Pick one and only that word changes. You can also edit the Hindi box directly.',
  },
  {
    q: 'What happens to punctuation and numbers?',
    a: 'They stay exactly as you typed them - <code>chal?</code> becomes <span lang="hi">चल?</span> and <code>10 baje</code> becomes <span lang="hi">10 बजे</span>. The one exception is <code>|</code>, which becomes the Hindi full stop <span lang="hi">।</span> (and <code>||</code> becomes <span lang="hi">॥</span>). To keep an English word in English, wrap it in backticks: <code>`Google`</code>.',
  },
  {
    q: 'How do I type the letters English has no spelling for?',
    a: 'Aspirated consonants take an <code>h</code>: <code>kh</code> <span lang="hi">ख</span>, <code>gh</code> <span lang="hi">घ</span>, <code>th</code> <span lang="hi">थ</span>, <code>dh</code> <span lang="hi">ध</span>, <code>bh</code> <span lang="hi">भ</span>, <code>ch</code> <span lang="hi">च</span>, <code>chh</code> <span lang="hi">छ</span>, <code>sh</code> <span lang="hi">श</span>. Long vowels double: <code>aa</code> <span lang="hi">आ</span>, <code>ee</code> <span lang="hi">ई</span>, <code>oo</code> <span lang="hi">ऊ</span>. For <span lang="hi">ऋ</span> write <code>ri</code>, and for <span lang="hi">क्ष त्र ज्ञ</span> write <code>ksh tra gya</code>.',
  },
  {
    q: 'Does my text get uploaded anywhere?',
    a: 'In <strong>Hinglish</strong> mode, yes - what you type is sent to Google\'s public input-tools service, which is what decides that <code>thela</code> is <span lang="hi">ठेला</span> and not <span lang="hi">थेला</span>. Web addresses and email addresses are removed before anything is sent. In <strong>Exact (ITRANS)</strong> mode nothing leaves your browser at all. If you go offline, or Google cannot be reached, the page falls back to its built-in dictionary automatically and keeps working - you will just see a note saying the spelling is coming from there.',
  },
  {
    q: 'Can I use this on a phone?',
    a: 'Yes. It is the main reason the page exists - you can type Hindi with the ordinary English keyboard you already have, without installing a Hindi keypad or switching layouts mid-sentence.',
  },
];
---

<Base title={page.title} description={page.description}>
  <div class="wrap py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl">{page.h1}</h1>
    <p class="mt-3 max-w-2xl text-base text-body">
      Type Hindi using the English keyboard you already have. Write it the way
      it sounds and the Devanagari appears as you type - no Hindi keypad, no
      install, no sign-up.
    </p>

    <div class="mt-6">
      <Transliterator />
    </div>

    <div class="prose-page mt-12 text-body">
      <h2>Type Hindi without a Hindi keyboard</h2>
      <p>
        Most people who need to write a line of Hindi do not have a Hindi
        keyboard set up, and do not want to install one for a single WhatsApp
        message or form field. This page solves that: you type
        <code>namaste</code> and get <strong lang="hi">नमस्ते</strong>, you type
        <code>mera naam ram hai</code> and get
        <strong lang="hi">मेरा नाम राम है</strong>. The English letters are
        read as sounds and written back out in Devanagari.
      </p>
      <p>
        The output is ordinary Unicode Hindi, so it works everywhere - WhatsApp,
        email, Word, government portals, social media, search. If you need the
        legacy Kruti Dev font instead, paste the result into the
        <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev converter</a>.
      </p>

      <h2>Transliteration is not translation</h2>
      <p>
        This is the one thing worth being clear about before you use it. The
        page changes the <em>script</em>, not the <em>language</em>. Type
        <code>computer</code> and you get <strong lang="hi">कंप्यूटर</strong> -
        the English word written in Devanagari - not the Hindi word for a
        computer. That is almost always what people want when they are typing a
        message, because the sentence they have in their head is already Hindi;
        they just cannot type the letters.
      </p>

      <h2>Spelling rules worth knowing</h2>
      <p>
        You do not need to learn a system. Type the word as it sounds and it
        will usually be right. These few patterns cover the letters English has
        no spelling for:
      </p>
      <ul>
        <li>
          <strong>Aspirated consonants add an h.</strong> <code>kh</code>
          <span lang="hi">ख</span>, <code>gh</code> <span lang="hi">घ</span>,
          <code>ch</code> <span lang="hi">च</span>, <code>chh</code>
          <span lang="hi">छ</span>, <code>th</code> <span lang="hi">थ</span>,
          <code>dh</code> <span lang="hi">ध</span>, <code>ph</code>
          <span lang="hi">फ</span>, <code>bh</code> <span lang="hi">भ</span>,
          <code>sh</code> <span lang="hi">श</span>.
        </li>
        <li>
          <strong>Long vowels double.</strong> <code>aa</code>
          <span lang="hi">आ</span>, <code>ee</code> or <code>ii</code>
          <span lang="hi">ई</span>, <code>oo</code> or <code>uu</code>
          <span lang="hi">ऊ</span>. So <code>kitab</code> and
          <code>kitaab</code> both give <strong lang="hi">किताब</strong>, but
          doubling is the way to be sure.
        </li>
        <li>
          <strong>Conjuncts have short spellings.</strong> <code>ksh</code>
          <span lang="hi">क्ष</span>, <code>tra</code> <span lang="hi">त्र</span>,
          <code>gya</code> <span lang="hi">ज्ञ</span>, <code>shr</code>
          <span lang="hi">श्र</span>, and <code>ri</code> for
          <span lang="hi">ऋ</span>.
        </li>
        <li>
          <strong>Nasals look after themselves.</strong> An <code>n</code> or
          <code>m</code> before another consonant becomes the anusvara, so
          <code>hindi</code> gives <strong lang="hi">हिंदी</strong> and
          <code>mandir</code> gives <strong lang="hi">मंदिर</strong>.
        </li>
      </ul>

      <h2>Where it guesses, and what to do about it</h2>
      <p>
        English spelling throws away information Hindi needs. One
        <code>a</code> has to stand for both <span lang="hi">अ</span> and
        <span lang="hi">आ</span>, so <code>bharat</code> could be
        <strong lang="hi">भारत</strong> or <strong lang="hi">भरत</strong> and
        the letters alone cannot say which. Hindi also drops the final vowel
        that Devanagari still writes, which is why <code>ghar</code> has to
        become <strong lang="hi">घर</strong> and not
        <span lang="hi">घर्</span>.
      </p>
      <p>
        Two things handle it. As you type, each word is looked up in Google's
        Hindi input service - the same transliteration behind Gboard - and its
        top suggestion is used, which gets the long tail right:
        <code>thela</code> becomes
        <strong lang="hi">ठेला</strong>, <code>tokar</code> becomes
        <strong lang="hi">टोकर</strong>. If that service cannot be reached, a
        built-in dictionary of common words plus a set of spelling rules takes
        over automatically, and the page tells you it has. When a word still
        comes out wrong, spell the long vowel out (<code>bhaarat</code>,
        <code>suuraj</code>) and it will fix itself.
      </p>
      <p>
        For anything that has to be right first time - a name, a legal document,
        Sanskrit - switch <strong>Typing</strong> to <strong>Exact (ITRANS)</strong>.
        That mode does no guessing at all: <code>aa ii uu</code> are the long
        vowels, capital <code>T D N S</code> are the retroflex consonants,
        <code>.n</code> is the anusvara and <code>.N</code> the chandrabindu.
        What you write is exactly what you get.
      </p>

      <h2>Where this fits with the rest of the site</h2>
      <p>
        The other pages here convert between Hindi <em>fonts</em> - they take
        text that already exists and move it between Kruti Dev, DevLys, Mangal
        and Unicode. That is an exact mapping with a right answer. This page is
        the other problem: you have no Hindi text yet, and you need to produce
        some. It is a separate tool with a separate engine, because a guess and
        a conversion should never be mistaken for each other.
      </p>
      <p>
        If you already have a file in a legacy font, you want
        <a href="/">Kruti Dev to Unicode</a> or
        <a href="/devlys-to-unicode">DevLys to Unicode</a> instead. If you have
        Hindi and need it in a legacy font, that is
        <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev</a>. The
        <a href="/all-converters">full list</a> has the rest.
      </p>
    </div>

    <Faq items={faq} schema={true} />

    <nav aria-labelledby="related" class="mt-12">
      <h2 id="related" class="text-xl">Related tools</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          page.related.map((path) => {
            const r = getPage(path);
            return (
              r && (
                <li>
                  <a
                    href={r.path}
                    class="block h-full card p-4 no-underline transition-colors hover:border-saffron"
                  >
                    <span class="block font-medium text-ink">{r.h1}</span>
                    <span class="mt-1 block text-sm text-body">{r.description}</span>
                  </a>
                </li>
              )
            );
          })
        }
      </ul>
    </nav>
  </div>
</Base>
