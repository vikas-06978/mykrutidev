---
import Base from '../layouts/Base.astro';
import HindiKeyboard from '../components/HindiKeyboard.astro';
import Faq from '../components/Faq.astro';
import { getPage } from '../lib/routes.js';

const page = getPage('/hindi-keyboard');

const faq = [
  {
    q: 'How do I type in Hindi without a Hindi keyboard?',
    a: 'Click the letters on this page. They are laid out in <span lang="hi">वर्णमाला</span> order - vowels first, then the consonant groups - so you find a letter by reading rather than hunting. What you click appears in the box above, and you copy it out when you are done. Nothing has to be installed.',
  },
  {
    q: 'Is this Hindi keyboard free?',
    a: 'Yes, completely. No signup, no limit, no paid tier. It is a static page that runs entirely in your browser.',
  },
  {
    q: 'How do I type a matra like ि or ी?',
    a: 'Tap the consonant, then the vowel. After a consonant the vowel keys turn into matras by themselves - they show <span lang="hi">◌ि ◌ी ◌ा</span> so you can see what you will get - so <span lang="hi">क</span> then <span lang="hi">इ</span> gives <span lang="hi">कि</span>, and <span lang="hi">क</span> then <span lang="hi">आ</span> gives <span lang="hi">का</span>. At the start of a word the same keys type the full vowel. The dotted circle only shows where the sign attaches; it is never inserted.',
  },
  {
    q: 'How do I type a half letter or a conjunct?',
    a: 'Use the halant - the <span lang="hi">◌्</span> key at the end of the consonants. A consonant, then halant, then another consonant joins them: <span lang="hi">क</span> + <span lang="hi">्</span> + <span lang="hi">य</span> gives <span lang="hi">क्य</span>. The four conjuncts Hindi uses constantly - <span lang="hi">क्ष त्र ज्ञ श्र</span> - have their own keys so you do not have to build them each time.',
  },
  {
    q: 'Can I still use my own keyboard?',
    a: 'Yes, and you should for anything you can already type. Nothing on this page blocks the physical keyboard: numbers, punctuation, space, backspace, arrow keys, selection, paste and undo all behave normally. Click the letters you cannot type and type the rest.',
  },
  {
    q: 'Can I get Kruti Dev instead of Unicode?',
    a: 'This page writes Unicode Hindi. Copy it and paste it into the <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev converter</a>, which gives you the Kruti Dev code for MS Word.',
  },
  {
    q: 'Does it work on a phone?',
    a: 'Yes. On a phone or tablet the keys dock to the bottom of the screen like a phone keyboard, and the text box stays at the top, so you can see both while you type. Your phone\'s own keyboard stays closed while the Hindi keys are open; press <strong>Use my keyboard</strong> to switch back to it.',
  },
  {
    q: 'Is my text uploaded anywhere?',
    a: 'No. Everything runs inside your browser and nothing is sent to a server. Once the page has loaded you can disconnect from the internet and it keeps working.',
  },
];
---

<Base title={page.title} description={page.description}>
  <div class="wrap py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl">{page.h1}</h1>
    <p class="mt-3 max-w-2xl text-base text-body">
      Click the Devanagari letters to write Hindi - no keypad to install and no
      layout to learn. Copy the Unicode when you are done. Nothing is uploaded.
    </p>

    <div class="mt-6">
      <HindiKeyboard />
    </div>

    <div class="prose-page mt-12 text-body">
      <h2>Type Hindi on any computer</h2>
      <p>
        Most people who need a line of Hindi do not have a Hindi keypad set up
        and are not about to install one for a single form field, a WhatsApp
        message or a name that has to be written correctly. That is what this
        page is for. The letters are on screen, you click them, and the Hindi
        builds up in the box above. When you are finished you copy it and paste
        it wherever it was going.
      </p>
      <p>
        The output is ordinary Unicode Devanagari, which is what every modern
        system expects - government portals, email, Word, search, social media,
        databases. If you specifically need the legacy font instead, paste it into
        the <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev converter</a>.
      </p>

      <h2>How the letters are arranged</h2>
      <p>
        In <span lang="hi">वर्णमाला</span> order, the order every Hindi speaker
        learned at school: the vowels, then the consonants in their five groups
        (with the halant, anusvara, chandrabindu and visarga beside them), then
        the everyday conjuncts, then digits. Space, Backspace, Enter and the
        full stop <span lang="hi">।</span> are on the bottom row.
      </p>
      <p>
        This is deliberately <em>not</em> an InScript picture. InScript scatters
        Devanagari across the QWERTY key positions, which is exactly right if you
        have learned the layout and are looking for the physical key - and
        exactly wrong if you are finding each letter by eye, because the letters
        end up in no order at all. Anyone who does know InScript has it installed
        already and can simply type; this page is for everyone else.
      </p>

      <h2>Matras, half letters and conjuncts</h2>
      <p>
        Three things cover almost everything people get stuck on:
      </p>
      <ul>
        <li>
          <strong>Vowels turn into matras after a consonant.</strong> Click
          <span lang="hi">क</span>, then <span lang="hi">इ</span>, and you get
          <strong lang="hi">कि</strong> - even though the sign is drawn to the
          left of the letter. The vowel keys show the matra they will type, so
          there is no separate matra row to hunt through.
        </li>
        <li>
          <strong>The halant makes a half letter.</strong>
          <span lang="hi">◌्</span> after a consonant silences its vowel, so
          <span lang="hi">क</span> + <span lang="hi">्</span> +
          <span lang="hi">य</span> is <strong lang="hi">क्य</strong>. That is how
          every conjunct is built.
        </li>
        <li>
          <strong>The common conjuncts have their own keys.</strong>
          <span lang="hi">क्ष</span>, <span lang="hi">त्र</span>,
          <span lang="hi">ज्ञ</span> and <span lang="hi">श्र</span> turn up
          constantly, so they are one click rather than three.
        </li>
      </ul>
      <p>
        The dotted circles on the sign keys are not characters. A vowel sign has
        no shape of its own, so the circle stands in for the consonant it will
        attach to - the same convention the Unicode charts use. Only the sign
        itself is inserted.
      </p>

      <h2>Second layer</h2>
      <p>
        <strong>More letters</strong> opens the rest: the Sanskrit vowels
        (<span lang="hi">ॠ ऌ ॡ</span>), the candra signs English loanwords use
        (<span lang="hi">ऑ</span> in <span lang="hi">डॉक्टर</span>), the Marathi
        and southern letters, the nukta, and the remaining punctuation. None of
        it is needed for ordinary Hindi, which is why it is behind a toggle
        rather than on the first screen.
      </p>

      <h2>Getting Kruti Dev out of it</h2>
      <p>
        Copy the text and paste it into the
        <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev converter</a>. It
        gives you the legacy keystrokes to paste into Word with
        <strong>Kruti Dev 010</strong> applied, and it tells you if any character
        has no Kruti Dev equivalent.
      </p>

      <h2>Where this fits with the rest of the site</h2>
      <p>
        If you would rather spell Hindi words out in English letters than hunt
        for each character, <a href="/english-to-hindi-typing">English to Hindi
        typing</a> is faster for whole sentences - type <code>namaste</code> and
        get <strong lang="hi">नमस्ते</strong>. If you want to build real typing
        speed, the <a href="/hindi-typing-test">Hindi typing test</a> measures
        it. And if you already have a document in the wrong font, you want a
        converter: <a href="/">Kruti Dev to Unicode</a>,
        <a href="/unicode-to-kruti-dev">Unicode to Kruti Dev</a>, or the
        <a href="/all-converters">full list</a>.
      </p>
    </div>

    <Faq items={faq} schema={true} />

    <nav aria-labelledby="related" class="mt-12">
      <h2 id="related" class="text-xl">Related tools</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          page.related.map((path) => {
            const r = getPage(path);
            return (
              r && (
                <li>
                  <a
                    href={r.path}
                    class="block h-full card p-4 no-underline transition-colors hover:border-saffron"
                  >
                    <span class="block font-medium text-ink">{r.h1}</span>
                    <span class="mt-1 block text-sm text-body">{r.description}</span>
                  </a>
                </li>
              )
            );
          })
        }
      </ul>
    </nav>
  </div>
</Base>
